{
	auto_https off
	admin off
}

http://:8080 {
	bind 127.0.0.1
	encode zstd gzip
	root * /Users/goumin/Services/goumin-work/runtime/current

	@private path /studio /studio/* /api /api/* /keystatic /keystatic/* /preview /preview/*
	respond @private 404

	@immutable path /_astro/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	@document not path /_astro/*
	header @document {
		Cache-Control "public, max-age=0, must-revalidate"
		CDN-Cache-Control "no-store"
	}

	handle @private {
		respond 404
	}

	handle {
		try_files {path} {path}/ =404
		file_server
	}

	handle_errors {
		rewrite * /404.html
		file_server
	}
}

http://:8081 {
	bind 127.0.0.1
	encode zstd gzip

	# Authentication runs before every Astro/Vite request. Only the self-contained
	# login surface reaches the auth service without a session; a failed or missing
	# auth service therefore fails closed instead of exposing the development server.
	route {
		# Browsers may keep sending the retired Basic Auth credential. Never forward it.
		request_header -Authorization

		# The dedicated hostname opens the Studio directly. Keep the internal
		# /studio route so links and API paths remain unchanged.
		@studioRoot {
			host studio.goumin.work
			path /
		}
		rewrite @studioRoot /studio

		@authSurface path /studio/login /api/studio/session /api/studio/session/logout /studio/login-assets/* /robots.txt
		reverse_proxy @authSurface 127.0.0.1:4322

		@keystatic path /keystatic /keystatic/* /api/keystatic /api/keystatic/*
		header @keystatic {
			Cache-Control "private, no-store"
			CDN-Cache-Control "no-store"
		}
		respond @keystatic 404

		forward_auth 127.0.0.1:4322 {
			uri /internal/studio-auth/verify
		}

		# Cache rules are intentionally installed only after authentication succeeds.
		# Otherwise a browser could cache an auth redirect or 401 as if it were an asset.
		@immutable path /_astro/*
		header @immutable {
			Cache-Control "private, max-age=31536000, immutable"
			CDN-Cache-Control "no-store"
		}

		@devAssets path /@vite/* /@id/* /@fs/* /node_modules/* /src/*
		header @devAssets {
			Cache-Control "private, max-age=300"
			CDN-Cache-Control "no-store"
		}

		@private not path /_astro/* /@vite/* /@id/* /@fs/* /node_modules/* /src/*
		header @private {
			Cache-Control "private, no-store"
			CDN-Cache-Control "no-store"
		}

		reverse_proxy 127.0.0.1:4321 {
			# Let this edge define browser caching consistently instead of inheriting
			# Astro/Vite's development-only no-cache header.
			header_down -Cache-Control
		}
	}
}
