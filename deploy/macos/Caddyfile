{
	auto_https off
	admin off
}

http://:8080 {
	bind 127.0.0.1
	encode zstd gzip
	root * /Users/goumin/Services/goumin-work/runtime/current

	@private path /studio /studio/* /api /api/* /keystatic /keystatic/* /preview /preview/*
	respond @private 404

	@immutable path /_astro/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	@document not path /_astro/*
	header @document {
		Cache-Control "public, max-age=0, must-revalidate"
		CDN-Cache-Control "no-store"
	}

	handle @private {
		respond 404
	}

	handle {
		try_files {path} {path}/ =404
		file_server
	}

	handle_errors {
		rewrite * /404.html
		file_server
	}
}

http://:8081 {
	bind 127.0.0.1
	encode zstd gzip

	# Cloudflare Access remains the preferred identity layer. This Caddy
	# challenge is a defense-in-depth fallback so the local-write APIs are
	# never publicly reachable without credentials.
	basic_auth {
		goumin $2a$14$94e4zht1vaBUC1B2iyfd6O43lQLdt1ry3tGjJjlyoQ8UqTP9yY.Qi
	}

	# The dedicated Access hostname opens the Studio directly. Keep the
	# internal /studio route so links and API paths remain unchanged.
	@studioRoot {
		host studio.goumin.work
		path /
	}
	rewrite @studioRoot /studio

	# Astro fingerprints these assets, so both the browser and Cloudflare may reuse them safely.
	@immutable path /_astro/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	# The current local authoring server uses Vite modules. A short browser cache removes
	# repeated cross-border requests while still picking up code changes within minutes.
	@devAssets path /@vite/* /@id/* /@fs/* /node_modules/* /src/*
	header @devAssets Cache-Control "private, max-age=300"

	@private not path /_astro/* /@vite/* /@id/* /@fs/* /node_modules/* /src/*
	header @private Cache-Control "private, no-store"

	@keystatic path /keystatic /keystatic/* /api/keystatic /api/keystatic/*
	respond @keystatic 404

	reverse_proxy 127.0.0.1:4321 {
		# Let this edge define browser caching consistently instead of inheriting
		# Astro/Vite's development-only no-cache header.
		header_down -Cache-Control
	}
}
