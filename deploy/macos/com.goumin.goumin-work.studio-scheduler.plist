<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.goumin.goumin-work.studio-scheduler</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/goumin/.bun/bin/bun</string>
    <string>run</string>
    <string>studio:scheduler</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/goumin/Services/goumin-work/repo</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/Users/goumin/.bun/bin:/Users/goumin/.local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>STUDIO_RUNTIME_DIR</key>
    <string>/Users/goumin/Services/goumin-work/runtime</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>StartInterval</key>
  <integer>300</integer>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>/Users/goumin/Library/Logs/goumin-work/studio-scheduler.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/goumin/Library/Logs/goumin-work/studio-scheduler.error.log</string>
</dict>
</plist>
