<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.goumin.goumin-work.studio-worker</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/goumin/.bun/bin/bun</string>
    <string>run</string>
    <string>studio:worker</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/goumin/Services/goumin-work/repo</string>
  <key>EnvironmentVariables</key>
