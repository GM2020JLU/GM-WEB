{
  "name": "goumin-work",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "packageManager": "bun@1.3.10",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "astro dev",
    "studio:auth": "bun scripts/studio-auth-service.ts",
    "fonts:ui": "bun scripts/fonts/subset-ui-font.ts",
    "build": "node scripts/write-build-marker.mjs && node scripts/reset-astro-content-cache.mjs && bun run verify:content && bun run verify:keystatic && bun run fonts:ui && astro build && bun run localize:dist && bun run prune:dist && bun scripts/build-search.mjs && bun scripts/sync-vercel-output.mjs",
    "studio:worker": "bun scripts/local-deploy.ts",
    "studio:scheduler": "bun scripts/local-scheduler.ts",
    "studio:backup": "bun scripts/local-backup.ts",
    "studio:backup:restore": "bun scripts/local-backup-restore.ts",
    "localize:dist": "node scripts/localize-build.mjs",
    "prune:dist": "node scripts/prune-build-assets.mjs",
    "verify:build": "node scripts/verify-build.mjs",
    "verify:keystatic": "bun scripts/verify-keystatic.mjs",
    "verify:content": "node scripts/audit-content.mjs",
    "test": "bun test",
    "test:keystatic-crud": "bun scripts/test-keystatic-crud.mjs",
    "test:studio-modules": "bun scripts/test-studio-modules.mjs",
    "test:local-publish": "bun scripts/test-local-publish.mjs",
    "types:check": "astro check",
    "test:full": "bun run check && bun test && bun run test:keystatic-crud && bun run test:studio-modules && bun run docs:build",
    "check": "bun run format:check && bun run types:check && bun run build && bun run verify:build",
    "preview": "astro preview",
    "docs:dev": "NAVFOLIO_CONTENT_SOURCE=docs astro dev",
    "docs:build": "NAVFOLIO_CONTENT_SOURCE=docs bun run build",
    "docs:preview": "NAVFOLIO_CONTENT_SOURCE=docs astro preview",
    "docs:sync": "git submodule update --init --recursive",
    "astro": "astro",
    "content:new": "bun scripts/new-content.ts",
    "post:new": "bun scripts/new-content.ts post",
    "project:new": "bun scripts/new-content.ts project",
    "vibe:new": "bun scripts/new-content.ts vibe",
    "media:new": "bun scripts/new-content.ts media",
    "publish:scheduled": "bun scripts/publish-scheduled.ts",
    "lint": "eslint .",
    "format": "prettier --write --ignore-unknown .",
    "format:check": "bun run lint && prettier --check --ignore-unknown .",
    "prepare": "husky"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.0.1",
    "@astrojs/react": "6.0.6",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/vercel": "11.0.10",
    "@expressive-code/plugin-collapsible-sections": "^0.44.2",
    "@expressive-code/plugin-line-numbers": "^0.44.2",
    "@fontsource/maple-mono": "^5.3.0",
    "@keystatic/astro": "6.0.0",
    "@keystatic/core": "0.6.9",
    "@navfolio/core": "github:navfolio/core",
    "@navfolio/mdx-components": "github:navfolio/mdx-components",
    "@navfolio/pages": "github:navfolio/pages",
    "@navfolio/plugin-markdown": "github:navfolio/plugin-markdown",
    "@navfolio/theme-default": "github:navfolio/theme-default",
    "@octokit/core": "^7.0.8",
    "@sindresorhus/slugify": "3.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.3",
    "astro-expressive-code": "^0.44.2",
    "date-fns": "^4.4.0",
    "github-slugger": "^2.0.0",
    "katex": "^0.18.7",
    "lucide-astro": "^0.556.0",
    "mdast-util-frontmatter": "^2.0.1",
    "mermaid": "12.0.0",
    "micromark-extension-frontmatter": "^2.0.0",
    "minimatch": "^10.2.6",
    "pinyin-pro": "3.29.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "sharp": "^0.35.4",
    "smol-toml": "^1.8.0",
    "tailwindcss": "^4.3.3",
    "unified": "^11.0.5",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/compiler": "^4.0.0",
    "@types/bun": "^1.4.2",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "10.10.0",
    "happy-dom": "^20.14.5",
    "husky": "^9.1.7",
    "js-yaml": "5.4.2",
    "lint-staged": "^17.5.1",
    "mdast-util-from-markdown": "2.0.3",
    "pagefind": "^1.5.2",
    "prettier": "^3.9.7",
    "prettier-plugin-astro": "^1.0.1",
    "typescript": "^7.0.2"
  },
  "lint-staged": {
    "*": "bun run format:check"
  },
  "overrides": {
    "dompurify": "3.4.13",
    "js-yaml": "4.3.1",
    "minimatch": "10.2.6",
    "nanoid@3": "3.3.18",
    "path-to-regexp": "6.3.0",
    "postcss": "8.5.23",
    "svgo": "4.0.2"
  }
}
