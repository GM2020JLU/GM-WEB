---
import type { ImageMetadata } from 'astro';
import ThemeBaseHead from '@navfolio/theme-default/components/BaseHead.astro';
import { getSiteConfig } from '../data/site';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  image?: ImageMetadata | string;
  pageStructuredData?: Record<string, unknown>;
}

const { title, description, image, pageStructuredData } = Astro.props;
const { site, profile, fonts } = await getSiteConfig();
const structuredGraph: Record<string, unknown>[] = [
  {
    '@type': 'Person',
    '@id': `${site.url}/#person`,
    name: profile.name,
    url: profile.website,
    image: profile.avatar,
    jobTitle: profile.role,
    sameAs: [profile.github],
  },
  {
    '@type': 'WebSite',
    '@id': `${site.url}/#website`,
    url: site.url,
    name: site.title,
    description: site.description,
    inLanguage: 'zh-CN',
    publisher: { '@id': `${site.url}/#person` },
  },
];
if (pageStructuredData) structuredGraph.push(pageStructuredData);
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': structuredGraph,
};
---

<ThemeBaseHead
  title={title}
  description={description}
  image={image}
  fallbackImage="/og-card.png"
  site={site}
  fonts={fonts}
/>

<script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />

<script is:inline>
  (() => {
    const disableStudioClientRouter = () => {
      if (!location.pathname.startsWith('/studio')) return;

      // Studio links use native navigation. Removing the unused transition
      // runtime avoids a second document listener, route prefetch bootstrap,
      // and several deferred module requests on every admin page.
      for (const script of document.querySelectorAll(
        'script[src*="ClientRouter.astro"], meta[name^="astro-view-transitions-"]',
      )) {
        script.remove();
      }
    };

    disableStudioClientRouter();
    if (location.pathname.startsWith('/studio')) {
      const observer = new MutationObserver(disableStudioClientRouter);
      observer.observe(document.documentElement, { childList: true, subtree: true });
      window.setTimeout(() => observer.disconnect(), 1000);
    }

    const markStudioTransition = (documentElement = document.documentElement) => {
      if (location.pathname.startsWith('/studio')) {
        documentElement.dataset.studioTransition = 'none';
      }
    };

    markStudioTransition();

    const themeTransitionState =
      window.__gouminThemeTransitionState ||
      (window.__gouminThemeTransitionState = {
        point: null,
        running: false,
      });

    const getThemeTransitionPoint = () => {
      if (themeTransitionState.point) return themeTransitionState.point;

      const toggle = document.querySelector('[data-theme-toggle]');
      if (toggle instanceof HTMLElement) {
        const rect = toggle.getBoundingClientRect();
        return {
          x: rect.left + rect.width / 2,
          y: rect.top + rect.height / 2,
        };
      }

      return {
        x: document.documentElement.clientWidth / 2,
        y: document.documentElement.clientHeight / 2,
      };
    };

    const enhanceThemeToggle = () => {
      const themeController = window.__navfolioTheme;
      if (!themeController || themeController.__gouminTransitionEnhanced) return;

      const toggleTheme = themeController.toggle.bind(themeController);
      Object.defineProperty(themeController, '__gouminTransitionEnhanced', { value: true });

      themeController.toggle = () => {
        const root = document.documentElement;
        const reduceMotion = window.matchMedia?.('(prefers-reduced-motion: reduce)').matches;
        const forcedColors = window.matchMedia?.('(forced-colors: active)').matches;
        const canAnimate =
          typeof document.startViewTransition === 'function' &&
          !location.pathname.startsWith('/studio') &&
          !themeTransitionState.routePending &&
          !root.hasAttribute('data-astro-transition') &&
          !reduceMotion &&
          !forcedColors;

        if (!canAnimate) {
          toggleTheme();
          themeTransitionState.point = null;
          return;
        }

        if (themeTransitionState.running) return;

        const viewportWidth = document.documentElement.clientWidth;
        const viewportHeight = document.documentElement.clientHeight;
        const point = getThemeTransitionPoint();
        const x = Math.min(Math.max(point.x, 0), viewportWidth);
        const y = Math.min(Math.max(point.y, 0), viewportHeight);
        const radius = Math.hypot(Math.max(x, viewportWidth - x), Math.max(y, viewportHeight - y));
        const animationId = (themeTransitionState.animationId ?? 0) + 1;

        themeTransitionState.animationId = animationId;
        themeTransitionState.running = true;
        root.dataset.themeTransition = 'active';
        root.dataset.themeTransitionCapture = 'true';
        root.style.setProperty('--theme-transition-x', `${x}px`);
        root.style.setProperty('--theme-transition-y', `${y}px`);
        root.style.setProperty('--theme-transition-radius', `${radius}px`);

        const cleanupThemeTransition = () => {
          if (themeTransitionState.animationId !== animationId) return;

          delete root.dataset.themeTransition;
          delete root.dataset.themeTransitionCapture;
          root.style.removeProperty('--theme-transition-x');
          root.style.removeProperty('--theme-transition-y');
          root.style.removeProperty('--theme-transition-radius');
          themeTransitionState.running = false;
          themeTransitionState.point = null;
          themeTransitionState.activeTransition = null;
          themeTransitionState.cleanup = null;
        };

        let transition;
        try {
          transition = document.startViewTransition(toggleTheme);
        } catch {
          cleanupThemeTransition();
          toggleTheme();
          return;
        }

        themeTransitionState.activeTransition = transition;
        themeTransitionState.cleanup = cleanupThemeTransition;

        transition.ready
          .then(() => {
            if (themeTransitionState.animationId === animationId) {
              delete root.dataset.themeTransitionCapture;
            }
          })
          .catch(() => {});

        transition.finished.catch(() => {}).finally(cleanupThemeTransition);
      };
    };

    if (!window.__gouminThemeTransitionPointerInitialized) {
      window.__gouminThemeTransitionPointerInitialized = true;
      document.addEventListener(
        'click',
        (event) => {
          const toggle =
            event.target instanceof Element && event.target.closest('[data-theme-toggle]');
          if (!(toggle instanceof HTMLElement)) return;

          const rect = toggle.getBoundingClientRect();
          const fromPointer = event.detail > 0 && Number.isFinite(event.clientX + event.clientY);
          themeTransitionState.point = fromPointer
            ? { x: event.clientX, y: event.clientY }
            : { x: rect.left + rect.width / 2, y: rect.top + rect.height / 2 };
        },
        true,
      );
    }

    enhanceThemeToggle();

    const markRouteTransitionPending = (event) => {
      const routeSequence = (themeTransitionState.routeSequence ?? 0) + 1;
      themeTransitionState.routeSequence = routeSequence;
      themeTransitionState.routePending = true;

      try {
        themeTransitionState.activeTransition?.skipTransition();
      } catch {}
      themeTransitionState.cleanup?.();

      event.signal?.addEventListener(
        'abort',
        () => {
          if (themeTransitionState.routeSequence === routeSequence) {
            themeTransitionState.routePending = false;
          }
        },
        { once: true },
      );
    };

    const clearRouteTransitionPending = () => {
      themeTransitionState.routePending = false;
    };

    document.addEventListener('astro:before-swap', (event) => {
      const currentTheme = document.documentElement.dataset.theme;
      if (currentTheme) {
        event.newDocument.documentElement.dataset.theme = currentTheme;
        event.newDocument.documentElement.style.colorScheme = currentTheme;
      }
      markStudioTransition(event.newDocument.documentElement);
    });

    const syncThemeLabel = () => {
      const isDark = document.documentElement.dataset.theme === 'dark';
      const label = isDark ? '切换到浅色主题' : '切换到深色主题';

      for (const button of document.querySelectorAll('[data-theme-toggle]')) {
        button.setAttribute('aria-label', label);
        button.setAttribute('title', label);
      }
    };

    const markStudioLinksForReload = () => {
      if (!location.pathname.startsWith('/studio')) return;

      for (const link of document.querySelectorAll('a[href]')) {
        if (!(link instanceof HTMLAnchorElement)) continue;
        if (link.origin !== location.origin || link.target === '_blank') continue;
        link.dataset.astroReload = '';
      }
    };

    // Astro's client router can wait for every page script before painting the
    // next module. Studio is a server-rendered admin surface, so native
    // navigation is both simpler and noticeably faster on high-latency links.
    document.addEventListener(
      'click',
      (event) => {
        if (!location.pathname.startsWith('/studio')) return;
        const target = event.target instanceof Element ? event.target.closest('a[href]') : null;
        if (!(target instanceof HTMLAnchorElement)) return;
        if (target.origin !== location.origin || target.target === '_blank') return;
        target.dataset.astroReload = '';
      },
      true,
    );

    syncThemeLabel();

    if (!window.__gouminThemeI18nInitialized) {
      window.__gouminThemeI18nInitialized = true;
      window.addEventListener('navfolio:theme-change', syncThemeLabel);
      document.addEventListener('astro:before-preparation', markRouteTransitionPending);
      document.addEventListener('astro:page-load', syncThemeLabel);
      document.addEventListener('astro:page-load', enhanceThemeToggle);
      document.addEventListener('astro:page-load', clearRouteTransitionPending);
      document.addEventListener('astro:page-load', markStudioLinksForReload);
    }

    if (document.readyState === 'loading') {
      document.addEventListener(
        'DOMContentLoaded',
        () => {
          syncThemeLabel();
          markStudioLinksForReload();
        },
        { once: true },
      );
    } else {
      syncThemeLabel();
      markStudioLinksForReload();
    }
  })();
</script>
