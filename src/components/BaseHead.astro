---
import type { ImageMetadata } from 'astro';
import ThemeBaseHead from '@navfolio/theme-default/components/BaseHead.astro';
import { getSiteConfig } from '../data/site';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  image?: ImageMetadata | string;
}

const { title, description, image } = Astro.props;
const { site, profile, fonts } = await getSiteConfig();
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${site.url}/#person`,
      name: profile.name,
      url: profile.website,
      image: profile.avatar,
      jobTitle: profile.role,
      sameAs: [profile.github],
    },
    {
      '@type': 'WebSite',
      '@id': `${site.url}/#website`,
      url: site.url,
      name: site.title,
      description: site.description,
      inLanguage: 'zh-CN',
      publisher: { '@id': `${site.url}/#person` },
    },
  ],
};
---

<ThemeBaseHead
  title={title}
  description={description}
  image={image}
  fallbackImage="/og-card.png"
  site={site}
  fonts={fonts}
/>

<script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />

<script is:inline>
  (() => {
    const syncThemeLabel = () => {
      const isDark = document.documentElement.dataset.theme === 'dark';
      const label = isDark ? '切换到浅色主题' : '切换到深色主题';
      const themeText = isDark ? '☀ 深色已开' : '☾ 深色';

      for (const button of document.querySelectorAll('[data-theme-toggle]')) {
        button.setAttribute('aria-label', label);
        button.setAttribute('title', label);
        if (button.classList.contains('studio-topbar-theme')) {
          button.textContent = themeText;
        }
      }
    };

    syncThemeLabel();

    if (!window.__gouminThemeI18nInitialized) {
      window.__gouminThemeI18nInitialized = true;
      window.addEventListener('navfolio:theme-change', syncThemeLabel);
      document.addEventListener('astro:page-load', syncThemeLabel);
    }

    const ensureStudioThemeButton = () => {
      if (!location.pathname.startsWith('/studio')) return;
      if (document.querySelector('.studio-topbar-theme[data-theme-toggle]')) return;

      const topbar = document.querySelector('nav.topbar');
      if (!(topbar instanceof HTMLElement)) return;

      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'studio-topbar-theme';
      button.setAttribute('data-theme-toggle', 'studio');
      button.setAttribute(
        'aria-label',
        document.documentElement.dataset.theme === 'dark' ? '切换到浅色主题' : '切换到深色主题',
      );
      button.textContent =
        document.documentElement.dataset.theme === 'dark' ? '☀ 深色已开' : '☾ 深色';

      topbar.append(button);
    };

    const initStudioTheme = () => {
      syncThemeLabel();
      ensureStudioThemeButton();
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initStudioTheme, { once: true });
    } else {
      initStudioTheme();
    }

    document.addEventListener('astro:page-load', initStudioTheme);
  })();
</script>
