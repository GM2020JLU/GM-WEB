---
import type { ImageMetadata } from 'astro';
import ThemeBaseHead from '@navfolio/theme-default/components/BaseHead.astro';
import { getSiteConfig } from '../data/site';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  image?: ImageMetadata | string;
}

const { title, description, image } = Astro.props;
const { site, profile, fonts } = await getSiteConfig();
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${site.url}/#person`,
      name: profile.name,
      url: profile.website,
      image: profile.avatar,
      jobTitle: profile.role,
      sameAs: [profile.github],
    },
    {
      '@type': 'WebSite',
      '@id': `${site.url}/#website`,
      url: site.url,
      name: site.title,
      description: site.description,
      inLanguage: 'zh-CN',
      publisher: { '@id': `${site.url}/#person` },
    },
  ],
};
---

<ThemeBaseHead
  title={title}
  description={description}
  image={image}
  fallbackImage="/og-card.png"
  site={site}
  fonts={fonts}
/>

<script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />

<script is:inline>
  (() => {
    const syncThemeLabel = () => {
      const isDark = document.documentElement.dataset.theme === 'dark';
      const label = isDark ? '切换到浅色主题' : '切换到深色主题';

      for (const button of document.querySelectorAll('[data-theme-toggle]')) {
        button.setAttribute('aria-label', label);
        button.setAttribute('title', label);
      }
    };

    syncThemeLabel();

    if (!window.__gouminThemeI18nInitialized) {
      window.__gouminThemeI18nInitialized = true;
      window.addEventListener('navfolio:theme-change', syncThemeLabel);
      document.addEventListener('astro:page-load', syncThemeLabel);
    }
  })();
</script>
