---
import type { ImageMetadata } from 'astro';
import ThemeBaseHead from '@navfolio/theme-default/components/BaseHead.astro';
import { getSiteConfig } from '../data/site';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  image?: ImageMetadata | string;
}

const { title, description, image } = Astro.props;
const { site, profile, fonts } = await getSiteConfig();
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${site.url}/#person`,
      name: profile.name,
      url: profile.website,
      image: profile.avatar,
      jobTitle: profile.role,
      sameAs: [profile.github],
    },
    {
      '@type': 'WebSite',
      '@id': `${site.url}/#website`,
      url: site.url,
      name: site.title,
      description: site.description,
      inLanguage: 'zh-CN',
      publisher: { '@id': `${site.url}/#person` },
    },
  ],
};
---

<ThemeBaseHead
  title={title}
  description={description}
  image={image}
  fallbackImage="/og-card.png"
  site={site}
  fonts={fonts}
/>

<script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />

<script is:inline>
  (() => {
    const markStudioTransition = (documentElement = document.documentElement) => {
      if (location.pathname.startsWith('/studio')) {
        documentElement.dataset.studioTransition = 'none';
      }
    };

    const markStudioLinkForReload = (link) => {
      if (!document.body.classList.contains('studio-with-navigation')) return;
      if (link.origin !== location.origin) return;
      link.dataset.astroReload = '';
    };

    document.addEventListener(
      'click',
      (event) => {
        const target = event.target;
        const link = target instanceof Element ? target.closest('a') : null;
        if (link instanceof HTMLAnchorElement) markStudioLinkForReload(link);
      },
      true,
    );

    markStudioTransition();

    document.addEventListener('astro:before-swap', (event) => {
      const currentTheme = document.documentElement.dataset.theme;
      if (currentTheme) {
        event.newDocument.documentElement.dataset.theme = currentTheme;
        event.newDocument.documentElement.style.colorScheme = currentTheme;
      }
      markStudioTransition(event.newDocument.documentElement);
    });

    const syncThemeLabel = () => {
      const isDark = document.documentElement.dataset.theme === 'dark';
      const label = isDark ? '切换到浅色主题' : '切换到深色主题';

      for (const button of document.querySelectorAll('[data-theme-toggle]')) {
        button.setAttribute('aria-label', label);
        button.setAttribute('title', label);
      }
    };

    syncThemeLabel();

    if (!window.__gouminThemeI18nInitialized) {
      window.__gouminThemeI18nInitialized = true;
      window.addEventListener('navfolio:theme-change', syncThemeLabel);
      document.addEventListener('astro:page-load', syncThemeLabel);
    }

    if (document.readyState === 'loading') {
      document.addEventListener(
        'DOMContentLoaded',
        () => {
          syncThemeLabel();
          document
            .querySelectorAll('a[href]')
            .forEach((link) => link instanceof HTMLAnchorElement && markStudioLinkForReload(link));
        },
        { once: true },
      );
    } else {
      syncThemeLabel();
    }
  })();
</script>
