---
import { getCollection } from 'astro:content';
import Icon from '../Icon.astro';
import { sortBlogPostsForArchive } from '../../utils/content-dates';

const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
const posts = sortBlogPostsForArchive(await getCollection('blog', ({ data }) => !data.draft));
const projects = sortBlogPostsForArchive(
  await getCollection('projects', ({ id, data }) => id !== 'index' && !data.draft),
);

interface FeaturedItem {
  label: string;
  title: string;
  description: string;
  href: string;
  icon: string;
}

const items = [
  projects[0] && {
    label: '代表项目',
    title: projects[0].data.title,
    description: projects[0].data.description,
    href: `/projects/${projects[0].id}/`,
    icon: 'briefcase',
  },
  posts[0] && {
    label: '最新文章',
    title: posts[0].data.title,
    description: posts[0].data.description,
    href: `/blog/${posts[0].id}/`,
    icon: 'pen',
  },
].filter((item): item is FeaturedItem => Boolean(item));

function withBase(href: string) {
  return `${basePath}${href}`;
}
---

{
  items.length > 0 && (
    <article class="featured-card">
      <header>
        <p>SELECTED WORK</p>
        <h2>从实际问题到可复用的工程记录</h2>
      </header>
      <div class:list={['featured-list', { single: items.length === 1 }]}>
        {items.map((item) => (
          <a href={withBase(item.href)}>
            <span class="featured-heading">
              <Icon name={item.icon} size={17} />
              <small>{item.label}</small>
            </span>
            <strong>{item.title}</strong>
            <span class="featured-description">{item.description}</span>
            <Icon class="featured-arrow" name="chevron-right" size={17} />
          </a>
        ))}
      </div>
    </article>
  )
}

<style>
  .featured-card {
    display: grid;
    gap: 18px;
    padding-top: 4px;
  }

  header {
    display: grid;
    gap: 6px;
  }

  header p {
    margin: 0;
    color: var(--accent-dark);
    font-family: var(--font-ui-label);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  h2 {
    margin: 0;
    color: var(--paper-ink);
    font-size: clamp(1.18rem, 2vw, 1.45rem);
    line-height: 1.4;
  }

  .featured-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }

  .featured-list.single {
    grid-template-columns: 1fr;
  }

  a {
    position: relative;
    display: grid;
    gap: 8px;
    min-width: 0;
    min-height: 164px;
    padding: 18px 42px 18px 18px;
    border: 1px solid var(--paper-line);
    border-radius: 9px;
    background: color-mix(in srgb, var(--paper-surface) 78%, transparent);
    color: inherit;
    text-decoration: none;
    transition:
      border-color 180ms ease,
      background 180ms ease,
      transform 180ms ease;
  }

  a:hover,
  a:focus-visible {
    border-color: var(--paper-line-strong);
    background: var(--paper-control-hover);
    color: var(--paper-accent);
    transform: translateY(-2px);
  }

  a:focus-visible {
    outline: 2px solid color-mix(in srgb, var(--paper-accent) 32%, transparent);
    outline-offset: 3px;
  }

  .featured-heading {
    display: flex;
    align-items: center;
    gap: 7px;
    color: var(--paper-accent);
  }

  small {
    color: var(--accent-dark);
    font-size: 0.7rem;
    font-weight: 700;
  }

  strong {
    color: var(--paper-ink);
    font-size: 1rem;
    line-height: 1.55;
  }

  .featured-description {
    display: -webkit-box;
    overflow: hidden;
    color: var(--paper-ink-soft);
    font-size: 0.82rem;
    line-height: 1.65;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .featured-arrow {
    position: absolute;
    right: 16px;
    bottom: 18px;
    color: var(--paper-accent);
  }

  @media (max-width: 820px) {
    .featured-card {
      display: grid;
      padding-top: 0;
    }
  }

  @media (max-width: 560px) {
    .featured-list {
      grid-template-columns: 1fr;
    }

    a {
      min-height: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    a {
      transition: none;
    }

    a:hover,
    a:focus-visible {
      transform: none;
    }
  }
</style>
