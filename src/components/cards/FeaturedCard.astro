---
import { getCollection } from 'astro:content';
import Icon from '../Icon.astro';
import { sortBlogPostsForArchive } from '../../utils/content-dates';

const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
const posts = sortBlogPostsForArchive(await getCollection('blog', ({ data }) => !data.draft));
const projects = sortBlogPostsForArchive(
  await getCollection('projects', ({ id, data }) => id !== 'index' && !data.draft),
);

interface FeaturedItem {
  label: string;
  title: string;
  description: string;
  href: string;
  icon: string;
}

const items = [
  posts[0] && {
    label: '最新文章',
    title: posts[0].data.title,
    description: posts[0].data.description,
    href: `/blog/${posts[0].id}/`,
    icon: 'pen',
  },
  projects[0] && {
    label: '当前项目',
    title: projects[0].data.title,
    description: projects[0].data.description,
    href: `/projects/${projects[0].id}/`,
    icon: 'briefcase',
  },
].filter((item): item is FeaturedItem => Boolean(item));

function withBase(href: string) {
  return `${basePath}${href}`;
}
---

{
  items.length > 0 && (
    <article class="featured-card">
      <h2>精选</h2>
      <div class="featured-list">
        {items.map((item) => (
          <a href={withBase(item.href)}>
            <span class="featured-heading">
              <Icon name={item.icon} size={17} />
              <small>{item.label}</small>
            </span>
            <strong>{item.title}</strong>
            <span class="featured-description">{item.description}</span>
            <Icon class="featured-arrow" name="chevron-right" size={17} />
          </a>
        ))}
      </div>
    </article>
  )
}

<style>
  .featured-card {
    display: grid;
    gap: 12px;
    padding-top: 4px;
  }

  h2 {
    margin: 0;
    color: var(--paper-ink);
    font-size: 1rem;
  }

  .featured-list {
    display: grid;
  }

  a {
    position: relative;
    display: grid;
    gap: 5px;
    padding: 13px 24px 13px 0;
    border-top: 1px solid var(--paper-line);
    border-radius: 6px;
    color: inherit;
    text-decoration: none;
  }

  a:hover,
  a:focus-visible {
    color: var(--paper-accent);
  }

  a:focus-visible {
    outline: 2px solid color-mix(in srgb, var(--paper-accent) 32%, transparent);
    outline-offset: 3px;
  }

  .featured-heading {
    display: flex;
    align-items: center;
    gap: 7px;
    color: var(--paper-accent);
  }

  small {
    font-size: 0.7rem;
    font-weight: 700;
  }

  strong {
    overflow: hidden;
    color: var(--paper-ink);
    font-size: 0.9rem;
    line-height: 1.45;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .featured-description {
    display: -webkit-box;
    overflow: hidden;
    color: var(--paper-ink-soft);
    font-size: 0.75rem;
    line-height: 1.55;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .featured-arrow {
    position: absolute;
    top: 50%;
    right: 0;
    color: var(--paper-accent);
    transform: translateY(-50%);
  }

  @media (max-width: 820px) {
    .featured-card {
      display: none;
    }
  }
</style>
