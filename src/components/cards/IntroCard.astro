---
interface Intro {
  title: string;
  name: string;
  body: string[];
  focus?: string[];
}

interface Quote {
  text: string[];
}

const { intro, quote, email, role } = Astro.props as {
  intro: Intro;
  quote?: Quote;
  email: string;
  role: string;
};
const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');

function withBase(href: string) {
  if (href === '/') return `${basePath}/` || '/';
  return `${basePath}${href.startsWith('/') ? href : `/${href}`}`;
}
---

<article class="glass-card intro-card">
  <div class="intro-copy">
    <p class="intro-kicker"><span aria-hidden="true"></span>{role}</p>
    {
      quote && (
        <div class="quote-mark" aria-hidden="true">
          “
        </div>
      )
    }
    <h1>
      <span>你好，</span>
      {intro.title}<em>{intro.name}</em>
    </h1>
    {
      quote && (
        <blockquote>
          <span>{quote.text.slice(0, 2).join(' ')}</span>
          <span>{quote.text.slice(2).join(' ')}</span>
        </blockquote>
      )
    }
    {intro.body.map((paragraph) => <p>{paragraph}</p>)}
    {
      intro.focus && intro.focus.length > 0 && (
        <ul class="focus-list" aria-label="关注领域">
          {intro.focus.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      )
    }
    <nav class="intro-actions" aria-label="进一步了解">
      <a class="primary" href={withBase('/projects')}>查看项目案例</a>
      <a href={`mailto:${email}`}>邮件交流</a>
    </nav>
  </div>
</article>

<style>
  .intro-card {
    display: flex;
    flex-direction: column;
    min-height: 320px;
    padding: 0;
    border-color: transparent;
    background: transparent;
    box-shadow: none;
  }

  .intro-card:hover {
    border-color: transparent;
    box-shadow: none;
    transform: none;
  }

  .intro-copy {
    position: relative;
    z-index: 1;
    display: flex;
    width: 100%;
    max-width: none;
    flex-direction: column;
    align-items: flex-start;
  }

  .intro-kicker {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    width: auto;
    margin: 0 0 28px;
    color: var(--paper-ink-soft);
    font-family: var(--font-ui-label);
    font-size: 0.72rem;
    font-weight: 600;
    line-height: 1.4;
  }

  .intro-kicker span {
    width: 28px;
    height: 1px;
    background: var(--paper-accent);
  }

  .quote-mark {
    position: absolute;
    top: 26px;
    right: 0;
    color: color-mix(in srgb, var(--paper-accent) 20%, transparent);
    font-family: var(--font-display);
    font-size: 8rem;
    line-height: 1;
    pointer-events: none;
  }

  h1 {
    margin: 0 0 24px;
    color: var(--paper-ink);
    max-width: none;
    font-size: clamp(2.25rem, 5vw, 4rem);
    line-height: 1.08;
    white-space: nowrap;
  }

  h1 span {
    margin-right: 0.35rem;
    color: var(--paper-accent);
    font-style: normal;
  }

  h1 em {
    color: var(--paper-accent);
    font-style: italic;
  }

  blockquote {
    display: block;
    max-width: 48ch;
    margin: 0 0 28px;
    padding: 0;
    border: 0;
    color: var(--paper-ink-soft);
    font-family: var(--font-note);
    font-size: clamp(0.96rem, 1.35vw, 1.12rem);
    font-style: italic;
    line-height: 1.72;
    text-align: left;
  }

  blockquote span {
    display: block;
  }

  p {
    width: 100%;
    margin: 0 0 12px;
    color: var(--paper-ink);
    max-width: 66ch;
    font-size: 1.05rem;
    line-height: 1.92;
  }

  p:last-child {
    margin-bottom: 0;
  }

  .focus-list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 18px 0 0;
    padding: 0;
    list-style: none;
  }

  .focus-list li {
    padding: 5px 9px;
    border: 1px solid var(--paper-line);
    border-radius: 999px;
    color: var(--paper-ink-soft);
    font-size: 0.76rem;
  }

  .intro-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 24px;
  }

  .intro-actions a {
    display: inline-flex;
    align-items: center;
    min-height: 42px;
    padding: 9px 14px;
    border: 1px solid var(--paper-line-strong);
    border-radius: 8px;
    color: var(--paper-ink);
    font-size: 0.82rem;
    text-decoration: none;
    transition:
      color 180ms ease,
      background 180ms ease,
      border-color 180ms ease,
      transform 120ms ease;
  }

  .intro-actions .primary {
    border-color: var(--accent-dark);
    background: var(--accent-dark);
    color: var(--paper-bg);
  }

  .intro-actions a:hover,
  .intro-actions a:focus-visible {
    border-color: var(--paper-accent);
    outline: none;
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--paper-accent) 18%, transparent);
  }

  .intro-actions a:not(.primary):hover {
    background: var(--paper-control-hover);
    color: var(--paper-accent);
  }

  .intro-actions a:active {
    transform: translateY(1px);
  }

  @media (max-width: 640px) {
    .intro-card {
      padding: 0;
    }

    h1 {
      font-size: 2.15rem;
      white-space: normal;
    }

    .intro-kicker {
      margin-bottom: 20px;
    }

    .quote-mark {
      top: 18px;
      font-size: 5rem;
    }

    blockquote {
      text-align: left;
    }

    .intro-actions {
      width: 100%;
    }

    .intro-actions .primary {
      justify-content: center;
      width: 100%;
    }
  }
</style>
