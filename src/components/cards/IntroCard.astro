---
interface Intro {
  title: string;
  name: string;
  body: string[];
  focus?: string[];
}

interface Quote {
  text: string[];
}

const { intro, quote, email } = Astro.props as { intro: Intro; quote?: Quote; email: string };
---

<article class="glass-card intro-card">
  <div class="intro-copy">
    {
      quote && (
        <div class="quote-mark" aria-hidden="true">
          "
        </div>
      )
    }
    <h1>
      <span aria-hidden="true">你好，</span>
      {intro.title.replace(intro.name, '')}<em>{intro.name}</em>
    </h1>
    {
      quote && (
        <blockquote>
          <span>- {quote.text.slice(0, 2).join(' ')}</span>
          <span>{quote.text.slice(2).join(' ')}</span>
        </blockquote>
      )
    }
    {intro.body.map((paragraph) => <p>{paragraph}</p>)}
    {
      intro.focus && intro.focus.length > 0 && (
        <ul class="focus-list" aria-label="关注领域">
          {intro.focus.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      )
    }
    <nav class="intro-actions" aria-label="进一步了解">
      <a class="primary" href="/projects">查看项目案例</a>
      <a href="/resume">查看简历</a>
      <a href={`mailto:${email}`}>邮件交流</a>
    </nav>
  </div>
</article>

<style>
  .intro-card {
    display: flex;
    flex-direction: column;
    min-height: 280px;
    padding: 0;
    border-color: transparent;
    background: transparent;
    box-shadow: none;
  }

  .intro-card:hover {
    border-color: transparent;
    box-shadow: none;
    transform: none;
  }

  .intro-copy {
    position: relative;
    z-index: 1;
    display: flex;
    width: 100%;
    max-width: none;
    flex-direction: column;
    align-items: flex-start;
  }

  .quote-mark {
    margin-bottom: 2px;
    color: rgba(102, 125, 109, 0.32);
    font-family: var(--font-display);
    font-size: 3rem;
    line-height: 0.7;
  }

  h1 {
    margin: 0 0 18px;
    color: var(--paper-ink);
    max-width: none;
    font-size: clamp(2.2rem, 4vw, 3.35rem);
    line-height: 1.04;
    white-space: nowrap;
  }

  h1 span {
    margin-right: 0.35rem;
    color: var(--paper-accent);
    font-style: normal;
  }

  h1 em {
    color: var(--paper-accent);
    font-style: italic;
  }

  blockquote {
    display: block;
    max-width: 52ch;
    margin: 0 0 26px auto;
    padding: 0;
    border: 0;
    color: var(--paper-ink-soft);
    font-family: var(--font-note);
    font-size: clamp(0.96rem, 1.35vw, 1.12rem);
    font-style: italic;
    line-height: 1.72;
    text-align: right;
  }

  blockquote span {
    display: block;
  }

  p {
    width: 100%;
    margin: 0 0 12px;
    color: var(--paper-ink);
    max-width: 66ch;
    font-size: 1.02rem;
    line-height: 1.92;
  }

  p:last-child {
    margin-bottom: 0;
  }

  .focus-list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 18px 0 0;
    padding: 0;
    list-style: none;
  }

  .focus-list li {
    padding: 5px 9px;
    border: 1px solid var(--paper-line);
    border-radius: 999px;
    color: var(--paper-ink-soft);
    font-size: 0.76rem;
  }

  .intro-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 24px;
  }

  .intro-actions a {
    padding: 9px 13px;
    border: 1px solid var(--paper-line-strong);
    border-radius: 9px;
    color: var(--paper-ink);
    font-size: 0.82rem;
    text-decoration: none;
  }

  .intro-actions .primary {
    border-color: var(--paper-accent);
    background: var(--paper-accent);
    color: white;
  }

  .intro-actions a:hover,
  .intro-actions a:focus-visible {
    border-color: var(--paper-accent);
    outline: none;
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--paper-accent) 18%, transparent);
  }

  @media (max-width: 640px) {
    .intro-card {
      padding: 0;
    }

    h1 {
      font-size: 1.7rem;
      white-space: normal;
    }

    blockquote {
      margin-left: 0;
      text-align: left;
    }
  }
</style>
