---
import Icon from '../Icon.astro';

interface Profile {
  name: string;
  handle: string;
  role: string;
  email: string;
  website: string;
  avatar: string;
}

const { profile } = Astro.props as { profile: Profile };
---

<article class="profile-card">
  <div class="avatar-wrap">
    <img
      src={profile.avatar}
      alt={`${profile.name} 的头像`}
      width="176"
      height="176"
      loading="eager"
      decoding="async"
      fetchpriority="high"
    />
  </div>

  <div class="profile-heading">
    <h2>{profile.name}</h2>
    <p>{profile.handle}</p>
    <span><Icon name="sparkle" /> {profile.role}</span>
  </div>
</article>

<style>
  .profile-card {
    display: grid;
    justify-items: end;
    min-height: 0;
    width: 100%;
    padding: 24px;
    border: 1px solid var(--paper-line);
    border-radius: 8px;
    background: color-mix(in srgb, var(--paper-surface) 88%, transparent);
    box-shadow: var(--paper-shadow);
    text-align: right;
    overflow: hidden;
  }

  .avatar-wrap {
    position: relative;
    width: 132px;
    height: 132px;
    margin: 0 0 18px auto;
    padding: 4px;
    border: 1px solid var(--paper-line-strong);
    border-radius: 28px;
    background: var(--paper-surface-muted);
    box-shadow: var(--paper-shadow);
  }

  .avatar-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: inherit;
  }

  .profile-heading h2 {
    margin: 0;
    color: var(--paper-ink);
    font-size: 1.62rem;
    letter-spacing: 0;
  }

  .profile-heading p {
    margin: 4px 0 14px;
    color: var(--paper-ink-soft);
    font-size: 0.94rem;
  }

  .profile-heading span {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    justify-content: flex-end;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    color: var(--paper-ink);
    font-size: 0.82rem;
    line-height: 1.5;
  }

  .profile-heading svg {
    width: 20px;
    height: 20px;
    flex: 0 0 auto;
    color: var(--paper-accent);
  }

  @media (max-width: 820px) {
    .profile-card {
      justify-items: center;
      min-height: auto;
      grid-template-columns: 88px minmax(0, 1fr);
      gap: 18px;
      align-items: center;
      padding: 18px;
      text-align: center;
    }

    .avatar-wrap {
      width: 88px;
      height: 88px;
      margin: 0;
      border-radius: 20px;
    }

    .profile-heading {
      text-align: left;
    }

    .profile-heading span {
      justify-content: flex-start;
    }
  }
</style>
