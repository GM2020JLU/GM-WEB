---
import { getCollection } from 'astro:content';
import Icon from '../Icon.astro';
import { getSiteConfig } from '../../data/site';
import { createRecentBlogHeatmap, type HeatmapDay } from '../../utils/blog-heatmap';
import { getUiText } from '../../utils/ui-text';

interface Props {
  weeks?: number;
  showLatest?: boolean;
  latestCount?: number;
  excludeDraft?: boolean;
  dateArchiveBaseHref?: string;
  startDate?: Date | string | null;
}

const {
  weeks = 24,
  showLatest = true,
  latestCount = 1,
  excludeDraft = true,
  dateArchiveBaseHref,
  startDate,
} = Astro.props;
const posts = await getCollection('blog', ({ data }) => !excludeDraft || !data.draft);
const heatmap = createRecentBlogHeatmap(posts, weeks, latestCount, startDate);
const ui = getUiText(await getSiteConfig());
const latestActiveDayIndex = heatmap.days.reduce(
  (latestIndex, day, dayIndex) => (day.count > 0 && !day.isFuture ? dayIndex : latestIndex),
  -1,
);
const maxSnakeDays = 44;
const heatmapLabel = startDate
  ? ui.heatmap.writingSince(heatmap.startDate)
  : ui.heatmap.recentWeeks(heatmap.weeks);
const formatDate = new Intl.DateTimeFormat(ui.locale, {
  month: 'short',
  day: 'numeric',
  year: 'numeric',
});

function getPostLabel(count: number) {
  return ui.heatmap.postCount(count);
}

function getDayTitle(day: HeatmapDay) {
  if (day.isFuture) return `${day.date}: ${ui.heatmap.upcoming}`;

  const titleLines = day.posts.slice(0, 5).map((post) => `- ${post.title}`);
  const overflowLine = day.posts.length > 5 ? ['...'] : [];

  return [`${day.date}: ${getPostLabel(day.count)}`, ...titleLines, ...overflowLine].join('\n');
}

function getDayHref(day: HeatmapDay) {
  if (dateArchiveBaseHref && day.count > 0) {
    return `${dateArchiveBaseHref.replace(/\/$/, '')}/${day.date}/`;
  }

  return day.posts[0]?.href;
}

function getSnakeStep(dayIndex: number) {
  const weekIndex = Math.floor(dayIndex / 7);
  const weekdayIndex = dayIndex % 7;

  return weekIndex * 7 + (weekIndex % 2 === 0 ? weekdayIndex : 6 - weekdayIndex);
}

const snakeTargetStep = latestActiveDayIndex >= 0 ? getSnakeStep(latestActiveDayIndex) : -1;
const snakeEndStep =
  snakeTargetStep >= 0
    ? Math.min(heatmap.days.length - 1, Math.floor(snakeTargetStep / 7) * 7 + 6)
    : -1;
const snakeStartStep = Math.max(0, Math.ceil((snakeEndStep - maxSnakeDays + 1) / 7) * 7);
---

<article
  class="glass-card heatmap-card"
  data-heatmap-snake={latestActiveDayIndex >= 0 ? 'true' : undefined}
>
  <div class="stats-row">
    <div class="stat-item">
      <strong>{heatmap.totalPosts}</strong>
      <span>{ui.heatmap.totalPosts}</span>
    </div>
    <div class="stat-item">
      <strong>{heatmap.activeDays}</strong>
      <span>{ui.heatmap.activeDays}</span>
    </div>
    <div class="stat-item">
      <strong>{heatmap.currentStreak}</strong>
      <span>{ui.heatmap.dayStreak}</span>
    </div>
  </div>

  {
    showLatest && heatmap.latestPosts.length > 0 && (
      <aside class="latest-tip" aria-label={ui.heatmap.latestPublishedPosts}>
        <strong>{ui.heatmap.latest}</strong>
        <div class="latest-list">
          {heatmap.latestPosts.map((post) => (
            <a
              class="latest-link"
              href={post.href}
              aria-label={ui.heatmap.openLatestPost(post.title)}
            >
              <em>{post.title}</em>
              <time datetime={post.date.toISOString()}>{formatDate.format(post.date)}</time>
              <span class="latest-icon" aria-hidden="true">
                <Icon name="external" size={15} />
              </span>
            </a>
          ))}
        </div>
      </aside>
    )
  }

  <div class="rhythm-grid" aria-label={heatmapLabel}>
    <div class="weekday-column" aria-hidden="true">
      {ui.heatmap.weekdays.map((weekday) => <span>{weekday}</span>)}
    </div>

    <div class="heatmap-cells" style={`--week-count: ${heatmap.weeks};`}>
      {
        heatmap.days.map((day, dayIndex) => {
          const snakeStep = getSnakeStep(dayIndex);
          const isOnSnakePath = snakeStep >= snakeStartStep && snakeEndStep >= snakeStep;
          const isSnakeTarget = dayIndex === latestActiveDayIndex;
          const snakePathStep = isOnSnakePath ? snakeStep - snakeStartStep : undefined;

          if (day.isFuture) {
            return (
              <span
                class="heatmap-cell future-cell"
                data-snake-step={snakePathStep}
                aria-hidden="true"
              />
            );
          }

          const href = getDayHref(day);
          const content = (
            <span
              class={`heatmap-cell level-${day.level}`}
              title={getDayTitle(day)}
              aria-hidden="true"
            />
          );

          return href ? (
            <a
              class="cell-link"
              data-snake-step={snakePathStep}
              data-snake-target={isSnakeTarget ? 'true' : undefined}
              href={href}
              aria-label={getDayTitle(day)}
            >
              {content}
            </a>
          ) : (
            <span
              class="cell-link static-cell"
              data-snake-step={snakePathStep}
              data-snake-target={isSnakeTarget ? 'true' : undefined}
              aria-label={getDayTitle(day)}
            >
              {content}
            </span>
          );
        })
      }

      <span class="heatmap-snake" aria-hidden="true" hidden>
        {[0, 1, 2, 3].map((segment) => <i class={`heatmap-snake-part part-${segment}`} />)}
      </span>
    </div>
  </div>

  <footer>
    <span>{ui.heatmap.less}</span>
    {[0, 1, 2, 3, 4].map((level) => <i class={`heatmap-cell level-${level}`} />)}
    <span>{ui.heatmap.more}</span>
  </footer>
</article>

<script>
  const SNAKE_PART_COUNT = 4;
  const SNAKE_PART_SCALES = [0.9, 0.769, 0.675, 0.619];
  const SNAKE_STEP_DURATION_MS = 82;
  const SNAKE_TARGET_ACTIVE_STEPS = 2.4;

  type SnakePoint = { x: number; y: number };
  type SnakeGeometry = {
    route: SnakePoint[];
    cellSize: number;
    moveCount: number;
    targetMoveStep: number | null;
  };

  const clampSnakeProgress = (value: number) => Math.max(0, Math.min(1, value));
  const lerpSnakePosition = (from: number, to: number, progress: number) =>
    from + (to - from) * progress;
  const initHeatmapSnakes = () => {
    for (const card of document.querySelectorAll<HTMLElement>('[data-heatmap-snake]')) {
      if (card.dataset.snakeReady) continue;

      card.dataset.snakeReady = 'true';
      const grid = card.querySelector<HTMLElement>('.heatmap-cells');
      const snake = grid?.querySelector<HTMLElement>('.heatmap-snake');
      const parts = snake
        ? Array.from(snake.querySelectorAll<HTMLElement>('.heatmap-snake-part'))
        : [];
      const targetCell = grid?.querySelector<HTMLElement>(
        '[data-snake-target="true"] .heatmap-cell',
      );

      if (!grid || !snake || parts.length !== SNAKE_PART_COUNT) continue;

      let animationFrame: number | null = null;
      let startedAt = 0;
      let pausedElapsed = 0;
      let geometry: SnakeGeometry | null = null;
      let geometryDirty = true;
      let isVisible = false;
      let isTargetActive = false;
      let disposed = false;
      let resizeObserver: ResizeObserver | null = null;
      let intersectionObserver: IntersectionObserver | null = null;
      const reducedMotionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
      const forcedColorsQuery = window.matchMedia('(forced-colors: active)');
      const prefersReducedSnakeMotion = () =>
        reducedMotionQuery.matches || forcedColorsQuery.matches;

      const measureGeometry = (): SnakeGeometry | null => {
        const pathCells = Array.from(grid.querySelectorAll<HTMLElement>('[data-snake-step]')).sort(
          (left, right) => Number(left.dataset.snakeStep) - Number(right.dataset.snakeStep),
        );

        if (pathCells.length === 0) return null;

        const gridRect = grid.getBoundingClientRect();
        const cellRects = pathCells.map((cell) => cell.getBoundingClientRect());
        const points = cellRects.map((rect) => ({
          x: rect.left - gridRect.left + rect.width / 2,
          y: rect.top - gridRect.top + rect.height / 2,
        }));
        const targetPointIndex = pathCells.findIndex((cell) => cell.dataset.snakeTarget === 'true');
        const firstPoint = points[0];
        const firstRect = cellRects[0];
        const gridStyle = window.getComputedStyle(grid);
        const columnGap = Number.parseFloat(gridStyle.columnGap) || 0;
        const rowGap = Number.parseFloat(gridStyle.rowGap) || 0;
        const columnPitch = firstRect.width + columnGap;
        const rowPitch = firstRect.height + rowGap;
        const nextPoint = points[1];
        const inward = nextPoint
          ? { x: nextPoint.x - firstPoint.x, y: nextPoint.y - firstPoint.y }
          : {
              x: 0,
              y: firstPoint.y <= gridRect.height / 2 ? rowPitch : -rowPitch,
            };
        const entryPoint = {
          x: firstPoint.x - inward.x,
          y: firstPoint.y - inward.y,
        };
        const bodyDirection = entryPoint.x <= gridRect.width / 2 ? 1 : -1;
        const entryPose = Array.from({ length: SNAKE_PART_COUNT }, (_, index) => ({
          x: entryPoint.x + bodyDirection * columnPitch * (SNAKE_PART_COUNT - index - 1),
          y: entryPoint.y,
        }));
        const lastPoint = points.at(-1)!;
        const previousPoint = points.at(-2) ?? firstPoint;
        const outward = {
          x: lastPoint.x - previousPoint.x,
          y: lastPoint.y - previousPoint.y,
        };
        const exitPose = Array.from({ length: SNAKE_PART_COUNT }, (_, index) => ({
          x: lastPoint.x + outward.x * (index + 1),
          y: lastPoint.y + outward.y * (index + 1),
        }));
        const cellSize = Math.min(firstRect.width, firstRect.height);

        parts.forEach((part, index) => {
          const size = cellSize * SNAKE_PART_SCALES[index];
          part.style.width = `${size}px`;
          part.style.height = `${size}px`;
        });

        geometryDirty = false;
        return {
          route: [...entryPose, ...points, ...exitPose],
          cellSize,
          moveCount: points.length + exitPose.length,
          targetMoveStep: targetPointIndex >= 0 ? targetPointIndex + 1 : null,
        };
      };

      const setTargetActive = (active: boolean) => {
        if (active === isTargetActive) return;

        isTargetActive = active;
        targetCell?.classList.toggle('snake-target-active', active);
      };

      const stopSnake = () => {
        if (animationFrame !== null) {
          if (geometry) {
            const movementDuration = geometry.moveCount * SNAKE_STEP_DURATION_MS;
            pausedElapsed = Math.max(0, performance.now() - startedAt) % movementDuration;
          }
          window.cancelAnimationFrame(animationFrame);
        }
        animationFrame = null;
        snake.hidden = true;
        setTargetActive(false);
        delete card.dataset.snakePlaying;
      };

      const renderSnake = (now: number) => {
        if (disposed || !isVisible || !card.isConnected || prefersReducedSnakeMotion()) {
          stopSnake();
          return;
        }

        if (geometryDirty || !geometry) {
          geometry = measureGeometry();
          startedAt = now;
          pausedElapsed = 0;
        }
        if (!geometry) {
          stopSnake();
          return;
        }

        const elapsed = Math.max(0, now - startedAt);
        const movementDuration = geometry.moveCount * SNAKE_STEP_DURATION_MS;
        const movementProgress = (elapsed % movementDuration) / SNAKE_STEP_DURATION_MS;
        const step = Math.floor(movementProgress);
        const stepProgress = movementProgress - step;
        const headIndex = SNAKE_PART_COUNT - 1 + step;

        parts.forEach((part, index) => {
          const delay = (0.2 * index) / Math.max(SNAKE_PART_COUNT - 1, 1);
          const partProgress = clampSnakeProgress((stepProgress - delay) / 0.8);
          const from = geometry!.route[headIndex - index];
          const to = geometry!.route[Math.min(headIndex + 1 - index, geometry!.route.length - 1)];
          const size = geometry!.cellSize * SNAKE_PART_SCALES[index];
          const x = lerpSnakePosition(from.x, to.x, partProgress) - size / 2;
          const y = lerpSnakePosition(from.y, to.y, partProgress) - size / 2;

          part.style.transform = `translate3d(${x.toFixed(2)}px, ${y.toFixed(2)}px, 0)`;
        });

        const targetMoveStep = geometry.targetMoveStep;
        setTargetActive(
          targetMoveStep !== null &&
            movementProgress >= targetMoveStep &&
            movementProgress < targetMoveStep + SNAKE_TARGET_ACTIVE_STEPS,
        );

        animationFrame = window.requestAnimationFrame(renderSnake);
      };

      const startSnake = () => {
        if (disposed || !isVisible || prefersReducedSnakeMotion() || animationFrame !== null) {
          return;
        }

        if (geometryDirty || !geometry) {
          geometry = measureGeometry();
          pausedElapsed = 0;
        }
        if (!geometry) return;

        setTargetActive(false);
        snake.hidden = false;
        card.dataset.snakePlaying = 'true';
        startedAt = performance.now() - pausedElapsed;
        animationFrame = window.requestAnimationFrame(renderSnake);
      };

      const syncSnakePlayback = () => {
        if (isVisible && document.visibilityState !== 'hidden' && !prefersReducedSnakeMotion()) {
          startSnake();
        } else {
          stopSnake();
        }
      };

      const handleVisibilityChange = () => syncSnakePlayback();

      if ('ResizeObserver' in window) {
        resizeObserver = new ResizeObserver(() => {
          geometryDirty = true;
          if (animationFrame === null) pausedElapsed = 0;
        });
        resizeObserver.observe(grid);
      }

      if ('IntersectionObserver' in window) {
        intersectionObserver = new IntersectionObserver(
          (entries) => {
            const entry = entries.find((candidate) => candidate.target === card);
            if (!entry) return;

            isVisible = entry.isIntersecting;
            syncSnakePlayback();
          },
          { rootMargin: '80px 0px', threshold: 0.05 },
        );
        intersectionObserver.observe(card);
      } else {
        isVisible = true;
        startSnake();
      }

      reducedMotionQuery.addEventListener('change', syncSnakePlayback);
      forcedColorsQuery.addEventListener('change', syncSnakePlayback);
      document.addEventListener('visibilitychange', handleVisibilityChange);

      document.addEventListener(
        'astro:before-swap',
        () => {
          disposed = true;
          resizeObserver?.disconnect();
          intersectionObserver?.disconnect();
          reducedMotionQuery.removeEventListener('change', syncSnakePlayback);
          forcedColorsQuery.removeEventListener('change', syncSnakePlayback);
          document.removeEventListener('visibilitychange', handleVisibilityChange);
          stopSnake();
        },
        { once: true },
      );
    }
  };

  initHeatmapSnakes();
  document.addEventListener('astro:page-load', initHeatmapSnakes);
</script>

<style>
  .heatmap-card {
    display: grid;
    gap: 16px;
    padding: 20px;
    border-color: transparent;
    background: transparent;
    box-shadow: none;
    overflow: visible;
  }

  .heatmap-card:hover {
    border-color: transparent;
    box-shadow: none;
    transform: none;
  }

  .stats-row {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 8px;
  }

  .stat-item {
    display: grid;
    gap: 2px;
    min-width: 0;
  }

  .stat-item strong {
    color: var(--paper-ink);
    font-size: 1.12rem;
    line-height: 1;
  }

  .stat-item span {
    overflow: hidden;
    color: var(--paper-ink-soft);
    font-size: 0.72rem;
    line-height: 1.2;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .latest-tip {
    display: grid;
    gap: 6px;
    padding: 10px 11px;
    border: 1px solid var(--paper-line);
    border-radius: 7px;
    background: var(--paper-surface-muted);
  }

  .latest-list {
    display: grid;
    gap: 4px;
  }

  .latest-link {
    display: grid;
    grid-template-columns: minmax(0, 1fr) max-content 24px;
    align-items: center;
    min-width: 0;
    gap: 8px;
    color: inherit;
    text-decoration: none;
  }

  .latest-tip strong {
    color: var(--paper-accent);
    font-size: 0.7rem;
    line-height: 1.15;
  }

  .latest-tip em {
    overflow: hidden;
    color: var(--paper-ink);
    font-size: 0.8rem;
    font-style: normal;
    font-weight: 650;
    line-height: 1.2;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .latest-tip time {
    color: var(--paper-ink-soft);
    font-size: 0.68rem;
    line-height: 1;
    white-space: nowrap;
  }

  .latest-icon {
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    border-radius: 8px;
    color: var(--paper-accent);
    transition:
      background 180ms ease,
      transform 180ms ease;
  }

  .latest-link:hover .latest-icon,
  .latest-link:focus-visible .latest-icon {
    background: var(--paper-control-hover);
    transform: translateY(-1px);
  }

  .latest-link:focus-visible {
    border-radius: 7px;
    outline: 2px solid color-mix(in srgb, var(--paper-accent) 28%, transparent);
    outline-offset: 3px;
  }

  .rhythm-grid {
    --cell-size: 8px;
    --cell-gap: 2.5px;
    display: grid;
    grid-template-columns: 24px minmax(0, 1fr);
    gap: 8px;
    align-items: center;
    width: 100%;
    max-width: 100%;
    overflow: visible;
  }

  .weekday-column {
    display: grid;
    grid-template-rows: repeat(3, var(--cell-size));
    gap: calc(var(--cell-size) + var(--cell-gap));
    color: var(--paper-ink-faint);
    font-size: 0.62rem;
    line-height: 1;
  }

  .heatmap-cells {
    position: relative;
    display: grid;
    grid-auto-flow: column;
    grid-template-rows: repeat(7, var(--cell-size));
    grid-auto-columns: var(--cell-size);
    gap: var(--cell-gap);
    width: calc(
      (var(--cell-size) * var(--week-count)) + (var(--cell-gap) * (var(--week-count) - 1))
    );
    max-width: 100%;
  }

  .heatmap-cell,
  .cell-link {
    display: block;
    width: var(--cell-size);
    height: var(--cell-size);
    min-width: 8px;
    min-height: 8px;
  }

  .cell-link {
    position: relative;
    color: inherit;
    text-decoration: none;
  }

  .cell-link:hover .heatmap-cell {
    outline: 1px solid var(--paper-line-strong);
    outline-offset: 1px;
  }

  .heatmap-cell {
    border-radius: 2.5px;
    background: rgba(102, 125, 109, 0.12);
    box-shadow: inset 0 0 0 1px var(--paper-line);
    transition:
      background-color 140ms ease-out,
      box-shadow 140ms ease-out;
  }

  .future-cell {
    position: relative;
    background: transparent;
    box-shadow: none;
  }

  .heatmap-snake {
    position: absolute;
    z-index: 2;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .heatmap-snake-part {
    position: absolute;
    top: 0;
    left: 0;
    display: block;
    border-radius: 30%;
    background: var(--paper-accent);
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--paper-accent) 18%, transparent);
    pointer-events: none;
    transform: translate3d(-100vw, -100vh, 0);
    will-change: transform;
  }

  .heatmap-cells .heatmap-cell.snake-target-active {
    background: color-mix(in srgb, var(--paper-accent) 76%, transparent);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--paper-accent) 42%, transparent);
  }

  .level-0 {
    background: rgba(102, 125, 109, 0.16);
  }

  .level-1 {
    background: #dce8dc;
  }

  .level-2 {
    background: #b9cbb9;
  }

  .level-3 {
    background: #8fa58f;
  }

  .level-4 {
    background: #667d6d;
  }

  footer {
    display: flex;
    align-items: center;
    gap: 6px;
    color: var(--paper-ink-faint);
    font-size: 0.72rem;
  }

  footer .heatmap-cell {
    --cell-size: 9px;
  }

  @media (max-width: 1180px) and (min-width: 821px) {
    .rhythm-grid {
      --cell-size: 8px;
    }
  }

  @media (max-width: 820px) {
    .heatmap-card {
      gap: 14px;
      padding: 0;
      overflow: hidden;
    }

    .rhythm-grid {
      --cell-gap: 2.5px;
      grid-template-columns: 22px minmax(0, 1fr);
      overflow: hidden;
      width: 100%;
    }

    .heatmap-cells {
      grid-template-rows: repeat(7, auto);
      grid-auto-columns: minmax(0, 1fr);
      width: 100%;
      max-width: 360px;
    }

    .heatmap-cells .heatmap-cell,
    .heatmap-cells .cell-link {
      width: 100%;
      height: auto;
      min-width: 0;
      min-height: 0;
      aspect-ratio: 1;
    }

    .weekday-column {
      font-size: 0.58rem;
    }
  }

  @media (prefers-reduced-motion: reduce), (forced-colors: active) {
    .heatmap-snake {
      display: none;
    }
  }
</style>
