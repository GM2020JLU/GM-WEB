---
import { getCollection } from 'astro:content';
import Icon from '../Icon.astro';
import { getSiteConfig } from '../../data/site';
import { createRecentBlogHeatmap, type HeatmapDay } from '../../utils/blog-heatmap';
import { getUiText } from '../../utils/ui-text';

interface Props {
  weeks?: number;
  showLatest?: boolean;
  latestCount?: number;
  excludeDraft?: boolean;
  dateArchiveBaseHref?: string;
  startDate?: Date | string | null;
}

const {
  weeks = 24,
  showLatest = true,
  latestCount = 1,
  excludeDraft = true,
  dateArchiveBaseHref,
  startDate,
} = Astro.props;
const posts = await getCollection('blog', ({ data }) => !excludeDraft || !data.draft);
const heatmap = createRecentBlogHeatmap(posts, weeks, latestCount, startDate);
const ui = getUiText(await getSiteConfig());
const latestActiveDayIndex = heatmap.days.reduce(
  (latestIndex, day, dayIndex) => (day.count > 0 && !day.isFuture ? dayIndex : latestIndex),
  -1,
);
const maxSnakeDays = 24 * 7;
const heatmapLabel = startDate
  ? ui.heatmap.writingSince(heatmap.startDate)
  : ui.heatmap.recentWeeks(heatmap.weeks);
const formatDate = new Intl.DateTimeFormat(ui.locale, {
  month: 'short',
  day: 'numeric',
  year: 'numeric',
});

function getPostLabel(count: number) {
  return ui.heatmap.postCount(count);
}

function getDayTitle(day: HeatmapDay) {
  if (day.isFuture) return `${day.date}: ${ui.heatmap.upcoming}`;

  const titleLines = day.posts.slice(0, 5).map((post) => `- ${post.title}`);
  const overflowLine = day.posts.length > 5 ? ['...'] : [];

  return [`${day.date}: ${getPostLabel(day.count)}`, ...titleLines, ...overflowLine].join('\n');
}

function getDayHref(day: HeatmapDay) {
  if (dateArchiveBaseHref && day.count > 0) {
    return `${dateArchiveBaseHref.replace(/\/$/, '')}/${day.date}/`;
  }

  return day.posts[0]?.href;
}

function getSnakeStep(dayIndex: number) {
  const weekIndex = Math.floor(dayIndex / 7);
  const weekdayIndex = dayIndex % 7;

  return weekIndex * 7 + (weekIndex % 2 === 0 ? weekdayIndex : 6 - weekdayIndex);
}

const snakeEndStep = latestActiveDayIndex >= 0 ? getSnakeStep(latestActiveDayIndex) : -1;
const snakeStartStep = Math.max(0, snakeEndStep - maxSnakeDays + 1);
---

<article
  class="glass-card heatmap-card"
  data-heatmap-snake={latestActiveDayIndex >= 0 ? 'true' : undefined}
>
  <div class="stats-row">
    <div class="stat-item">
      <strong>{heatmap.totalPosts}</strong>
      <span>{ui.heatmap.totalPosts}</span>
    </div>
    <div class="stat-item">
      <strong>{heatmap.activeDays}</strong>
      <span>{ui.heatmap.activeDays}</span>
    </div>
    <div class="stat-item">
      <strong>{heatmap.currentStreak}</strong>
      <span>{ui.heatmap.dayStreak}</span>
    </div>
  </div>

  {
    showLatest && heatmap.latestPosts.length > 0 && (
      <aside class="latest-tip" aria-label={ui.heatmap.latestPublishedPosts}>
        <strong>{ui.heatmap.latest}</strong>
        <div class="latest-list">
          {heatmap.latestPosts.map((post) => (
            <a
              class="latest-link"
              href={post.href}
              aria-label={ui.heatmap.openLatestPost(post.title)}
            >
              <em>{post.title}</em>
              <time datetime={post.date.toISOString()}>{formatDate.format(post.date)}</time>
              <span class="latest-icon" aria-hidden="true">
                <Icon name="external" size={15} />
              </span>
            </a>
          ))}
        </div>
      </aside>
    )
  }

  <div class="rhythm-grid" aria-label={heatmapLabel}>
    <div class="weekday-column" aria-hidden="true">
      {ui.heatmap.weekdays.map((weekday) => <span>{weekday}</span>)}
    </div>

    <div class="heatmap-cells" style={`--week-count: ${heatmap.weeks};`}>
      {
        heatmap.days.map((day, dayIndex) => {
          const snakeStep = getSnakeStep(dayIndex);
          const isOnSnakePath = snakeStep >= snakeStartStep && snakeEndStep >= snakeStep;
          const isSnakeTarget = dayIndex === latestActiveDayIndex;
          const snakeStyle = `--snake-step: ${Math.max(0, snakeStep - snakeStartStep)};`;

          if (day.isFuture) {
            return (
              <span
                class:list={['heatmap-cell', 'future-cell', { 'snake-segment': isOnSnakePath }]}
                style={snakeStyle}
                aria-hidden="true"
              />
            );
          }

          const href = getDayHref(day);
          const content = (
            <span
              class={`heatmap-cell level-${day.level}`}
              title={getDayTitle(day)}
              aria-hidden="true"
            />
          );

          return href ? (
            <a
              class:list={[
                'cell-link',
                { 'snake-segment': isOnSnakePath, 'snake-target': isSnakeTarget },
              ]}
              style={snakeStyle}
              href={href}
              aria-label={getDayTitle(day)}
            >
              {content}
            </a>
          ) : (
            <span
              class:list={[
                'cell-link',
                'static-cell',
                { 'snake-segment': isOnSnakePath, 'snake-target': isSnakeTarget },
              ]}
              style={snakeStyle}
              aria-label={getDayTitle(day)}
            >
              {content}
            </span>
          );
        })
      }
    </div>
  </div>

  <footer>
    <span>{ui.heatmap.less}</span>
    {[0, 1, 2, 3, 4].map((level) => <i class={`heatmap-cell level-${level}`} />)}
    <span>{ui.heatmap.more}</span>
  </footer>
</article>

<script>
  const prefersReducedSnakeMotion = () =>
    window.matchMedia?.('(prefers-reduced-motion: reduce)').matches ||
    window.matchMedia?.('(forced-colors: active)').matches;

  const playHeatmapSnake = (card: HTMLElement) => {
    if (prefersReducedSnakeMotion()) return;

    delete card.dataset.snakePlaying;
    void card.offsetWidth;
    card.dataset.snakePlaying = 'true';
  };

  const initHeatmapSnakes = () => {
    for (const card of document.querySelectorAll<HTMLElement>('[data-heatmap-snake]')) {
      if (card.dataset.snakeReady) continue;

      card.dataset.snakeReady = 'true';
      let lastPlayedAt = Number.NEGATIVE_INFINITY;
      const play = () => {
        const now = performance.now();
        if (now - lastPlayedAt < 3900) return;

        lastPlayedAt = now;
        playHeatmapSnake(card);
      };

      if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver(
          (entries) => {
            if (!entries.some((entry) => entry.isIntersecting)) return;

            play();
            observer.disconnect();
          },
          { threshold: 0.2 },
        );
        observer.observe(card);
      } else {
        play();
      }

      card.addEventListener('pointerenter', play);
      card.addEventListener('focusin', (event) => {
        if (!card.contains(event.relatedTarget as Node | null)) play();
      });
    }
  };

  initHeatmapSnakes();
  document.addEventListener('astro:page-load', initHeatmapSnakes);
</script>

<style>
  .heatmap-card {
    display: grid;
    gap: 16px;
    padding: 20px;
    border-color: transparent;
    background: transparent;
    box-shadow: none;
    overflow: visible;
  }

  .heatmap-card:hover {
    border-color: transparent;
    box-shadow: none;
    transform: none;
  }

  .stats-row {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 8px;
  }

  .stat-item {
    display: grid;
    gap: 2px;
    min-width: 0;
  }

  .stat-item strong {
    color: var(--paper-ink);
    font-size: 1.12rem;
    line-height: 1;
  }

  .stat-item span {
    overflow: hidden;
    color: var(--paper-ink-soft);
    font-size: 0.72rem;
    line-height: 1.2;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .latest-tip {
    display: grid;
    gap: 6px;
    padding: 10px 11px;
    border: 1px solid var(--paper-line);
    border-radius: 7px;
    background: var(--paper-surface-muted);
  }

  .latest-list {
    display: grid;
    gap: 4px;
  }

  .latest-link {
    display: grid;
    grid-template-columns: minmax(0, 1fr) max-content 24px;
    align-items: center;
    min-width: 0;
    gap: 8px;
    color: inherit;
    text-decoration: none;
  }

  .latest-tip strong {
    color: var(--paper-accent);
    font-size: 0.7rem;
    line-height: 1.15;
  }

  .latest-tip em {
    overflow: hidden;
    color: var(--paper-ink);
    font-size: 0.8rem;
    font-style: normal;
    font-weight: 650;
    line-height: 1.2;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .latest-tip time {
    color: var(--paper-ink-soft);
    font-size: 0.68rem;
    line-height: 1;
    white-space: nowrap;
  }

  .latest-icon {
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    border-radius: 8px;
    color: var(--paper-accent);
    transition:
      background 180ms ease,
      transform 180ms ease;
  }

  .latest-link:hover .latest-icon,
  .latest-link:focus-visible .latest-icon {
    background: var(--paper-control-hover);
    transform: translateY(-1px);
  }

  .latest-link:focus-visible {
    border-radius: 7px;
    outline: 2px solid color-mix(in srgb, var(--paper-accent) 28%, transparent);
    outline-offset: 3px;
  }

  .rhythm-grid {
    --cell-size: 8px;
    --cell-gap: 2.5px;
    display: grid;
    grid-template-columns: 24px minmax(0, 1fr);
    gap: 8px;
    align-items: center;
    width: 100%;
    max-width: 100%;
    overflow: visible;
  }

  .weekday-column {
    display: grid;
    grid-template-rows: repeat(3, var(--cell-size));
    gap: calc(var(--cell-size) + var(--cell-gap));
    color: var(--paper-ink-faint);
    font-size: 0.62rem;
    line-height: 1;
  }

  .heatmap-cells {
    display: grid;
    grid-auto-flow: column;
    grid-template-rows: repeat(7, var(--cell-size));
    grid-auto-columns: var(--cell-size);
    gap: var(--cell-gap);
    width: calc(
      (var(--cell-size) * var(--week-count)) + (var(--cell-gap) * (var(--week-count) - 1))
    );
    max-width: 100%;
  }

  .heatmap-cell,
  .cell-link {
    display: block;
    width: var(--cell-size);
    height: var(--cell-size);
    min-width: 8px;
    min-height: 8px;
  }

  .cell-link {
    position: relative;
    color: inherit;
    text-decoration: none;
  }

  .cell-link:hover .heatmap-cell {
    outline: 1px solid var(--paper-line-strong);
    outline-offset: 1px;
  }

  .heatmap-cell {
    border-radius: 2.5px;
    background: rgba(102, 125, 109, 0.12);
    box-shadow: inset 0 0 0 1px var(--paper-line);
  }

  .future-cell {
    position: relative;
    background: transparent;
    box-shadow: none;
  }

  .heatmap-cells .snake-segment::after {
    position: absolute;
    inset: -1px;
    border-radius: 3px;
    background: var(--paper-accent);
    box-shadow:
      0 0 0 1px color-mix(in srgb, var(--paper-accent) 44%, transparent),
      0 0 8px color-mix(in srgb, var(--paper-accent) 38%, transparent);
    content: '';
    opacity: 0;
    pointer-events: none;
    transform: scale(0.55);
  }

  .heatmap-card[data-snake-playing='true'] .heatmap-cells .snake-segment::after {
    animation: heatmap-snake-segment 360ms cubic-bezier(0.22, 1, 0.36, 1) both;
    animation-delay: calc(150ms + var(--snake-step) * 18ms);
  }

  .heatmap-card[data-snake-playing='true'] .snake-target .heatmap-cell {
    animation: heatmap-snake-target 480ms cubic-bezier(0.34, 1.56, 0.64, 1) both;
    animation-delay: calc(260ms + var(--snake-step) * 18ms);
  }

  .level-0 {
    background: rgba(102, 125, 109, 0.16);
  }

  .level-1 {
    background: #dce8dc;
  }

  .level-2 {
    background: #b9cbb9;
  }

  .level-3 {
    background: #8fa58f;
  }

  .level-4 {
    background: #667d6d;
  }

  footer {
    display: flex;
    align-items: center;
    gap: 6px;
    color: var(--paper-ink-faint);
    font-size: 0.72rem;
  }

  footer .heatmap-cell {
    --cell-size: 9px;
  }

  @keyframes heatmap-snake-segment {
    0% {
      opacity: 0;
      transform: scale(0.55);
    }

    20% {
      opacity: 1;
      transform: scale(1.18);
    }

    58% {
      opacity: 0.72;
      transform: scale(1);
    }

    100% {
      opacity: 0;
      transform: scale(0.72);
    }
  }

  @keyframes heatmap-snake-target {
    0%,
    100% {
      box-shadow: inset 0 0 0 1px var(--paper-line);
      transform: scale(1);
    }

    45% {
      box-shadow:
        inset 0 0 0 1px var(--paper-line),
        0 0 0 3px color-mix(in srgb, var(--paper-accent) 22%, transparent);
      transform: scale(1.42);
    }
  }

  @media (max-width: 1180px) and (min-width: 821px) {
    .rhythm-grid {
      --cell-size: 8px;
    }
  }

  @media (max-width: 820px) {
    .heatmap-card {
      gap: 14px;
      padding: 0;
      overflow: hidden;
    }

    .rhythm-grid {
      --cell-gap: 2.5px;
      grid-template-columns: 22px minmax(0, 1fr);
      overflow: hidden;
      width: 100%;
    }

    .heatmap-cells {
      grid-template-rows: repeat(7, auto);
      grid-auto-columns: minmax(0, 1fr);
      width: 100%;
      max-width: 360px;
    }

    .heatmap-cells .heatmap-cell,
    .heatmap-cells .cell-link {
      width: 100%;
      height: auto;
      min-width: 0;
      min-height: 0;
      aspect-ratio: 1;
    }

    .weekday-column {
      font-size: 0.58rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .heatmap-card[data-snake-playing='true'] .heatmap-cells .snake-segment::after,
    .heatmap-card[data-snake-playing='true'] .snake-target .heatmap-cell {
      animation: none;
    }
  }
</style>
