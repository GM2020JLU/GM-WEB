---
import { getCollection } from 'astro:content';
import PreviewWorkbench from '../../../components/studio/PreviewWorkbench.astro';
import { hasContentFiles } from '../../../utils/content-source';
import { getKeystaticEntryUrl } from '../../../utils/keystatic-routes';

export async function getStaticPaths() {
  const entries = hasContentFiles('media') ? await getCollection('media') : [];
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: entry,
  }));
}
const entry = Astro.props;
const editorUrl = getKeystaticEntryUrl(
  'media',
  entry.id,
  import.meta.env.PROD ? { branch: 'main' } : {},
);
---

<PreviewWorkbench
  title={entry.data.title}
  status={entry.data.publicationStatus}
  renderUrl={`/preview/render/media/${entry.id}`}
  {editorUrl}
/>
