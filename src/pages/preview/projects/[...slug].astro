---
import { getCollection } from 'astro:content';
import PreviewWorkbench from '../../../components/studio/PreviewWorkbench.astro';
import { getKeystaticEntryUrl } from '../../../utils/keystatic-routes';

export async function getStaticPaths() {
  return (await getCollection('projects')).map((entry) => ({
    params: { slug: entry.id },
    props: entry,
  }));
}
const entry = Astro.props;
const editorUrl = getKeystaticEntryUrl(
  'projects',
  entry.id,
  import.meta.env.PROD ? { branch: 'main' } : {},
);
---

<PreviewWorkbench
  title={entry.data.title}
  status={entry.data.publicationStatus}
  renderUrl={`/preview/render/projects/${entry.id}`}
  {editorUrl}
/>
