---
import { getCollection } from 'astro:content';
import PreviewWorkbench from '../../../components/studio/PreviewWorkbench.astro';

export async function getStaticPaths() {
  return (await getCollection('projects')).map((entry) => ({
    params: { slug: entry.id },
    props: entry,
  }));
}
const entry = Astro.props;
---

<PreviewWorkbench
  title={entry.data.title}
  status={entry.data.publicationStatus}
  renderUrl={`/preview/render/projects/${entry.id}`}
  editorUrl={`/keystatic/collection/projects/item/${entry.id}`}
/>
