---
import { getCollection, render } from 'astro:content';
import ZoomableImage from '@navfolio/mdx-components/ZoomableImage.astro';
import BlogArticle from '../../../../layouts/BlogArticle.astro';

export async function getStaticPaths() {
  return (await getCollection('blog')).map((entry) => ({
    params: { slug: entry.id },
    props: entry,
  }));
}
const entry = Astro.props;
const { Content, headings } = await render(entry);
---

<BlogArticle post={{ ...entry, data: { ...entry.data, comments: false } }} headings={headings}
  ><Content components={{ img: ZoomableImage }} /></BlogArticle
>
