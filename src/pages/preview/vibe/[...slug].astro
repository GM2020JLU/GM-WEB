---
import { getCollection } from 'astro:content';
import PreviewWorkbench from '../../../components/studio/PreviewWorkbench.astro';
import { getKeystaticEntryUrl } from '../../../utils/keystatic-routes';

export async function getStaticPaths() {
  return (await getCollection('vibe')).map((entry) => ({
    params: { slug: entry.id },
    props: entry,
  }));
}
const entry = Astro.props;
const editorUrl = getKeystaticEntryUrl(
  'vibe',
  entry.id,
  import.meta.env.PROD ? { branch: 'main' } : {},
);
---

<PreviewWorkbench
  title={entry.data.title || '未命名随记'}
  status={entry.data.publicationStatus}
  renderUrl={`/preview/render/vibe/${entry.id}`}
  {editorUrl}
/>
