---
import { getCollection } from 'astro:content';
import { getSiteConfig } from '../data/site';
import BaseLayout from '../layouts/BaseLayout.astro';

const siteConfig = await getSiteConfig();
const { profile, home, site } = siteConfig;
const projects = (await getCollection('projects'))
  .filter((entry) => entry.id !== 'index' && !entry.data.draft)
  .sort((a, b) => {
    const aSticky = a.data.sticky ? 1 : 0;
    const bSticky = b.data.sticky ? 1 : 0;
    const aDate = new Date(a.data.updatedDate ?? a.data.date).valueOf();
    const bDate = new Date(b.data.updatedDate ?? b.data.date).valueOf();
    return bSticky - aSticky || bDate - aDate;
  })
  .slice(0, 4);
const focus = home.intro.focus;
const printableDate = new Intl.DateTimeFormat('zh-CN', { year: 'numeric', month: 'long' }).format(
  new Date(),
);
---

<BaseLayout title={`简历｜${profile.name}`} description={`${profile.name} 的个人简历与代表项目。`}>
  <main class="resume-shell">
    <header class="resume-header">
      <div>
        <p class="eyebrow">RESUME · {printableDate}</p>
        <h1>{profile.name}</h1>
        <p class="role">{profile.role}</p>
      </div>
      <nav class="resume-actions" aria-label="简历操作">
        <a href={`mailto:${profile.email}`}>联系我</a>
        <button type="button" onclick="window.print()">打印 / 保存 PDF</button>
      </nav>
    </header>

    <section class="resume-section summary" aria-labelledby="summary-title">
      <h2 id="summary-title">个人简介</h2>
      <p>{home.intro.body.join(' ')}</p>
    </section>

    <section class="resume-section" aria-labelledby="focus-title">
      <h2 id="focus-title">核心方向</h2>
      <ul class="skill-list">
        {focus.map((item) => <li>{item}</li>)}
      </ul>
    </section>

    <section class="resume-section" aria-labelledby="projects-title">
      <div class="section-heading">
        <h2 id="projects-title">代表项目</h2>
        <a href="/projects">查看全部项目 →</a>
      </div>
      <div class="project-list">
        {
          projects.map((project) => (
            <article>
              <div>
                <h3>
                  <a href={`/projects/${project.id}`}>{project.data.title}</a>
                </h3>
                {project.data.role && <p class="project-role">{project.data.role}</p>}
              </div>
              <p>{project.data.description}</p>
              {project.data.highlights.length > 0 && (
                <ul>
                  {project.data.highlights.slice(0, 3).map((highlight) => (
                    <li>{highlight}</li>
                  ))}
                </ul>
              )}
            </article>
          ))
        }
      </div>
    </section>

    <section class="resume-section contact" aria-labelledby="contact-title">
      <h2 id="contact-title">联系方式</h2>
      <p><a href={`mailto:${profile.email}`}>{profile.email}</a></p>
      <p><a href={profile.github} target="_blank" rel="noreferrer">GitHub · {site.title}</a></p>
    </section>
  </main>
</BaseLayout>

<style>
  .resume-shell {
    width: min(920px, calc(100% - 40px));
    margin: 0 auto;
    padding: clamp(40px, 8vw, 90px) 0 100px;
    color: var(--paper-ink);
  }
  .resume-header,
  .section-heading {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
  }
  .resume-header {
    padding-bottom: 30px;
    border-bottom: 1px solid var(--paper-line);
  }
  .eyebrow {
    margin: 0 0 12px;
    color: var(--paper-accent);
    font: 700 0.7rem var(--font-meta);
    letter-spacing: 0.14em;
  }
  h1 {
    margin: 0;
    font: 400 clamp(3rem, 9vw, 6.5rem)/0.95 var(--font-page-heading);
  }
  .role {
    margin: 18px 0 0;
    color: var(--paper-ink-soft);
    font-size: 1.05rem;
  }
  .resume-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .resume-actions a,
  .resume-actions button,
  .section-heading a {
    padding: 8px 11px;
    border: 1px solid var(--paper-line-strong);
    border-radius: 8px;
    background: transparent;
    color: inherit;
    font: inherit;
    font-size: 0.78rem;
    text-decoration: none;
    cursor: pointer;
  }
  .resume-actions a:hover,
  .resume-actions button:hover,
  .section-heading a:hover {
    border-color: var(--paper-accent);
    color: var(--paper-accent);
  }
  .resume-section {
    padding: 30px 0;
    border-bottom: 1px solid var(--paper-line);
  }
  .resume-section h2 {
    margin: 0 0 16px;
    font: 400 1.7rem var(--font-page-heading);
  }
  .summary p,
  .contact p {
    max-width: 68ch;
    margin: 0;
    color: var(--paper-ink-soft);
    line-height: 1.9;
  }
  .skill-list,
  .project-list article ul {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .skill-list li {
    padding: 7px 11px;
    border: 1px solid var(--paper-line);
    border-radius: 999px;
    color: var(--paper-ink-soft);
    font-size: 0.8rem;
  }
  .section-heading h2 {
    margin-bottom: 0;
  }
  .section-heading a {
    margin-bottom: 3px;
  }
  .project-list {
    display: grid;
    gap: 24px;
  }
  .project-list article {
    display: grid;
    gap: 8px;
  }
  .project-list h3 {
    margin: 0;
    font-size: 1.08rem;
  }
  .project-list h3 a {
    color: inherit;
    text-decoration: none;
  }
  .project-list h3 a:hover {
    color: var(--paper-accent);
  }
  .project-list p {
    margin: 0;
    color: var(--paper-ink-soft);
    line-height: 1.75;
  }
  .project-list .project-role {
    font-size: 0.78rem;
    color: var(--paper-ink-faint);
  }
  .project-list article ul {
    display: grid;
    gap: 5px;
    padding-left: 18px;
    list-style: disc;
  }
  .project-list article li {
    color: var(--paper-ink-soft);
    font-size: 0.86rem;
    line-height: 1.65;
  }
  .contact a {
    color: var(--paper-accent);
  }
  @media (max-width: 640px) {
    .resume-header,
    .section-heading {
      align-items: flex-start;
      flex-direction: column;
    }
  }
  @media print {
    :global(header),
    :global(footer),
    .resume-actions,
    .section-heading a {
      display: none !important;
    }
    .resume-shell {
      width: 100%;
      padding: 0;
    }
    .resume-section {
      break-inside: avoid;
    }
  }
</style>
