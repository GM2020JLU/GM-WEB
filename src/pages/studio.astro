---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import StudioNavigation from '../components/studio/StudioNavigation.astro';
import { getThemePalette } from '../data/site';
import { getContentHealth, getPublicationStatus } from '../utils/content-metrics';
import { hasContentFiles } from '../utils/content-source';

const [blog, projects, vibe, media, about] = await Promise.all([
  getCollection('blog'),
  getCollection('projects'),
  getCollection('vibe'),
  hasContentFiles('media') ? getCollection('media') : Promise.resolve([]),
  getCollection('about'),
]);
const definitions = [
  ...blog.map((entry) => ({ entry, type: '博客', collection: 'blog' })),
  ...projects.map((entry) => ({ entry, type: '项目', collection: 'projects' })),
  ...vibe.map((entry) => ({ entry, type: '随记', collection: 'vibe' })),
  ...media.map((entry) => ({ entry, type: '书影音', collection: 'media' })),
  ...about.map((entry) => ({ entry, type: '页面', collection: 'about' })),
];
const items = definitions
  .map(({ entry, type, collection }) => {
    const data = entry.data as Record<string, any>;
    const status = getPublicationStatus(data);
    const isAbout = collection === 'about';
    const publicUrl =
      status === 'published'
        ? collection === 'blog'
          ? `/blog/${entry.id}`
          : collection === 'projects'
            ? entry.id === 'index'
              ? '/projects'
              : `/projects/${entry.id}`
            : collection === 'vibe'
              ? '/vibe'
              : collection === 'media'
                ? '/media'
                : '/about'
        : undefined;
    return {
      id: entry.id,
      title: data.title || '未命名内容',
      type,
      collection,
      status,
      date: data.updatedDate ?? data.date ?? data.completedAt,
      issues: getContentHealth({ collection, id: entry.id, data, body: entry.body ?? '' }),
      publicUrl,
      editorUrl: `/studio/edit/${collection}/${isAbout ? 'about' : entry.id}`,
      previewUrl: isAbout ? '/preview/about' : `/preview/${collection}/${entry.id}`,
    };
  })
  .sort((a, b) => new Date(b.date || 0).valueOf() - new Date(a.date || 0).valueOf());
const statusLabels = { draft: '草稿', ready: '待发布', published: '已发布' } as const;
const deployedSha = import.meta.env.VERCEL_GIT_COMMIT_SHA || 'local';
const palette = await getThemePalette();
const moduleCards = [
  { label: '博客文章', note: '长文与技术笔记', href: '/studio/content/blog', count: blog.length },
  {
    label: '项目案例',
    note: '过程、取舍与结果',
    href: '/studio/content/projects',
    count: projects.length,
  },
  { label: '随记', note: '短想法与生活片段', href: '/studio/content/vibe', count: vibe.length },
  { label: '书影音', note: '阅读与观看记录', href: '/studio/content/media', count: media.length },
  {
    label: '站点页面',
    note: '关于页与独立页面',
    href: '/studio/content/pages',
    count: about.length,
  },
  { label: '站点设置', note: '首页、身份与页面文案', href: '/studio/site', count: null },
];
---

<!doctype html>
<html lang="zh-CN" data-palette={palette}>
  <head
    ><BaseHead title="内容管理" description="个人站内容管理后台" /><meta
      name="robots"
      content="noindex,nofollow,noarchive"
    /></head
  >
  <body class="studio-with-navigation">
    <StudioNavigation />
    <main class="shell">
      <nav class="topbar">
        <a class="brand" href="/studio" aria-current="page"
          ><span>GM</span><strong>创作中心</strong></a
        ><div>
          <a href="/studio/assets">素材</a><a href="/studio/organize">分类</a><a href="/"
            >查看网站</a
          >
        </div>
      </nav>

      <header class="page-header">
        <div><h1>内容</h1><p>写作、预览和发布。</p></div><div class="header-actions">
          <a href="/studio/import">导入 Markdown</a><details class="new-menu">
            <summary>新建</summary><div>
              <a href="/studio/edit/blog/new?new=1">博客</a><a href="/studio/edit/vibe/new?new=1"
                >随记</a
              ><a href="/studio/edit/projects/new?new=1">项目</a><a
                href="/studio/edit/media/new?new=1">书影音</a
              >
            </div>
          </details>
        </div>
      </header>

      <section class="deployment" data-deployment data-runtime-sha={deployedSha} aria-live="polite">
        <div>
          <span class="deploy-dot"></span><strong data-deployment-title>网站运行正常</strong><small
            data-deployment-detail>当前版本 {deployedSha.slice(0, 7)}</small
          >
        </div>
        <div class="deploy-track" hidden data-deployment-track>
          <span data-deployment-progress></span>
        </div><a data-deployment-link hidden target="_blank">打开线上页面</a>
      </section>

      <section class="modules" aria-labelledby="modules-title">
        <div class="modules-heading">
          <h2 id="modules-title">网站模块</h2><span>选择要管理的区域</span>
        </div>
        <div class="module-grid">
          {
            moduleCards.map((module) => (
              <a href={module.href}>
                <span>{module.count === null ? '设置' : `${module.count} 条`}</span>
                <>
                  <strong>{module.label}</strong>
                  <small>{module.note}</small>
                </>
              </a>
            ))
          }
        </div>
      </section>

      <section class="content-section">
        <div class="controls">
          <div class="status-tabs" role="group" aria-label="内容状态">
            <button type="button" data-filter="all" aria-pressed="true">全部</button><button
              type="button"
              data-filter="draft">草稿</button
            ><button type="button" data-filter="ready">待发布</button><button
              type="button"
              data-filter="published">已发布</button
            ><button type="button" data-filter="issues">需完善</button>
          </div><div>
            <input type="search" placeholder="搜索内容" data-search /><select
              data-type-filter
              aria-label="内容类型"
              ><option value="all">全部类型</option>{
                [...new Set(items.map((item) => item.type))].map((type) => (
                  <option value={type}>{type}</option>
                ))
              }</select
            >
          </div>
        </div>

        <div class="bulk-bar" data-bulk-bar hidden>
          <span>已选择 <strong data-selected-count>0</strong> 条</span><div>
            <button type="button" data-bulk-action="draft">转为草稿</button><button
              type="button"
              data-bulk-action="ready">待发布</button
            ><button type="button" data-bulk-action="publish">发布</button>
          </div>
        </div>

        <div class="content-list" data-content-list>
          {
            items.map((item) => (
              <article
                data-row
                data-status={item.status}
                data-type={item.type}
                data-health={item.issues.length ? 'issues' : 'good'}
              >
                <input
                  type="checkbox"
                  data-select-item
                  data-collection={item.collection}
                  data-slug={item.id}
                  aria-label={`选择 ${item.title}`}
                />
                <div class="content-main">
                  <>
                    <div>
                      <span class:list={['badge', `badge-${item.status}`]}>
                        {statusLabels[item.status]}
                      </span>
                      <span class="kind">{item.type}</span>
                      {item.issues.length > 0 && (
                        <span class="issue">{item.issues.length} 项需完善</span>
                      )}
                    </div>
                    <strong>{item.title}</strong>
                    <small>
                      {item.date
                        ? new Date(item.date).toLocaleDateString('zh-CN', {
                            timeZone: 'Asia/Shanghai',
                          })
                        : '暂无日期'}
                    </small>
                  </>
                </div>
                <div class="row-actions">
                  <a class="edit" href={item.editorUrl}>
                    编辑
                  </a>
                  <a href={item.previewUrl}>预览</a>
                  {item.publicUrl && <a href={item.publicUrl}>线上</a>}
                </div>
              </article>
            ))
          }
          <p class="empty" hidden data-empty>没有符合条件的内容。</p>
        </div>
      </section>
    </main>

    <script>
      import {
        deploymentCopy,
        readPendingDeployment,
        STUDIO_DEPLOYMENT_STORAGE_KEY,
      } from '../utils/studio-deployment';
      import { matchesContentFilters } from '../utils/content-metrics';
      const filters = [...document.querySelectorAll('[data-filter]')];
      const rows = [...document.querySelectorAll('[data-row]')];
      const search = document.querySelector('[data-search]');
      const type = document.querySelector('[data-type-filter]');
      const empty = document.querySelector('[data-empty]');
      let active = 'all';
      const apply = () => {
        let visible = 0;
        for (const row of rows) {
          if (!(row instanceof HTMLElement)) continue;
          const show = matchesContentFilters(
            {
              status: row.dataset.status,
              type: row.dataset.type,
              health: row.dataset.health,
              text: row.textContent ?? '',
            },
            {
              status: active,
              type: type instanceof HTMLSelectElement ? type.value : 'all',
              query:
                search instanceof HTMLInputElement
                  ? search.value.trim().toLocaleLowerCase('zh-CN')
                  : '',
            },
          );
          row.hidden = !show;
          if (show) visible++;
        }
        if (empty instanceof HTMLElement) empty.hidden = visible > 0;
      };
      filters.forEach((button) =>
        button.addEventListener('click', () => {
          if (!(button instanceof HTMLElement)) return;
          active = button.dataset.filter ?? 'all';
          filters.forEach((item) => item.setAttribute('aria-pressed', String(item === button)));
          apply();
        }),
      );
      search?.addEventListener('input', apply);
      type?.addEventListener('change', apply);

      const selected = [...document.querySelectorAll('[data-select-item]')];
      const bulk = document.querySelector('[data-bulk-bar]');
      const count = document.querySelector('[data-selected-count]');
      const selection = () => {
        const total = selected.filter(
          (item) => item instanceof HTMLInputElement && item.checked,
        ).length;
        if (bulk instanceof HTMLElement) bulk.hidden = total === 0;
        if (count) count.textContent = String(total);
      };
      selected.forEach((item) => item.addEventListener('change', selection));
      document.querySelectorAll('[data-bulk-action]').forEach((button) =>
        button.addEventListener('click', async () => {
          if (!(button instanceof HTMLButtonElement)) return;
          const items = selected.flatMap((item) =>
            item instanceof HTMLInputElement && item.checked
              ? [{ collection: item.dataset.collection, slug: item.dataset.slug }]
              : [],
          );
          if (!items.length || !confirm(`确定更新 ${items.length} 条内容吗？`)) return;
          button.disabled = true;
          const response = await fetch('/api/studio/bulk', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ action: button.dataset.bulkAction, items }),
          });
          const result = await response.json();
          button.disabled = false;
          if (!response.ok) return alert(result.error || '批量操作失败。');
          if (button.dataset.bulkAction === 'publish' && result.commitSha) {
            localStorage.setItem(
              STUDIO_DEPLOYMENT_STORAGE_KEY,
              JSON.stringify({
                targetSha: result.commitSha,
                title: `${items.length} 条内容`,
                startedAt: new Date().toISOString(),
              }),
            );
          }
          location.reload();
        }),
      );

      const pending = readPendingDeployment(localStorage);
      const deployment = document.querySelector('[data-deployment]');
      const title = document.querySelector('[data-deployment-title]');
      const detail = document.querySelector('[data-deployment-detail]');
      const track = document.querySelector('[data-deployment-track]');
      const progress = document.querySelector('[data-deployment-progress]');
      const link = document.querySelector('[data-deployment-link]');
      const poll = async () => {
        if (!pending || !(deployment instanceof HTMLElement)) return;
        deployment.dataset.phase = 'submitted';
        if (track instanceof HTMLElement) track.hidden = false;
        try {
          const response = await fetch(
            `/api/studio/deployment?sha=${encodeURIComponent(pending.targetSha)}`,
          );
          const result = await response.json();
          if (!response.ok || !result.deployment) throw new Error();
          const copy = deploymentCopy(result.deployment);
          deployment.dataset.phase = result.deployment.phase;
          if (title) title.textContent = copy.title;
          if (detail) detail.textContent = copy.detail;
          if (progress instanceof HTMLElement) progress.style.width = `${copy.progress}%`;
          if (result.deployment.phase === 'ready') {
            localStorage.removeItem(STUDIO_DEPLOYMENT_STORAGE_KEY);
            if (link instanceof HTMLAnchorElement && pending.publicUrl) {
              link.href = pending.publicUrl;
              link.hidden = false;
            }
            return;
          }
          if (result.deployment.phase !== 'error') setTimeout(poll, 3000);
        } catch {
          if (title) title.textContent = '正在等待部署状态';
          if (detail) detail.textContent = '内容已保存，将自动重试。';
          setTimeout(poll, 6000);
        }
      };
      if (pending) void poll();
    </script>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }
  :global(body) {
    margin: 0;
    background: var(--paper-bg);
    color: var(--paper-ink);
    font-family: var(--font-ui);
  }
  .shell {
    width: min(1040px, calc(100% - 32px));
    margin: auto;
    padding: 18px 0 80px;
  }
  .topbar,
  .page-header,
  .controls,
  .bulk-bar,
  .deployment,
  .deployment > div,
  .brand,
  .topbar > div,
  .header-actions,
  .row-actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }
  .topbar {
    height: 52px;
    border-bottom: 1px solid var(--paper-line);
  }
  .brand {
    justify-content: flex-start;
  }
  .brand span {
    display: grid;
    width: 32px;
    height: 32px;
    place-items: center;
    border-radius: 9px;
    background: var(--paper-ink);
    color: var(--paper-bg);
    font-size: 0.7rem;
  }
  .topbar a,
  a {
    color: inherit;
    text-decoration: none;
  }
  .topbar > div a {
    color: var(--paper-ink-faint);
    font-size: 0.8rem;
  }
  .page-header {
    padding: 42px 0 24px;
  }
  .page-header h1 {
    margin: 0;
    font: 400 clamp(2.4rem, 7vw, 4.5rem)/1 var(--font-page-heading);
  }
  .page-header p {
    margin: 8px 0 0;
    color: var(--paper-ink-soft);
  }
  .header-actions > a,
  .new-menu > summary {
    padding: 9px 12px;
    border: 1px solid var(--paper-line);
    border-radius: 8px;
    background: var(--paper-bg);
    font-size: 0.82rem;
  }
  .new-menu {
    position: relative;
  }
  .new-menu > summary {
    list-style: none;
    background: var(--paper-accent);
    color: var(--paper-bg);
    cursor: pointer;
  }
  .new-menu > div {
    position: absolute;
    right: 0;
    z-index: 3;
    display: grid;
    width: 140px;
    margin-top: 7px;
    padding: 7px;
    border: 1px solid var(--paper-line);
    border-radius: 10px;
    background: var(--paper-bg);
    box-shadow: 0 14px 36px #273e2e24;
  }
  .new-menu > div a {
    padding: 8px;
    border-radius: 6px;
  }
  .new-menu > div a:hover {
    background: color-mix(in srgb, var(--paper-bg) 88%, var(--paper-accent) 12%);
  }
  .deployment {
    margin-bottom: 28px;
    padding: 13px 15px;
    border: 1px solid var(--paper-line);
    border-radius: 11px;
    background: color-mix(in srgb, var(--paper-bg) 95%, var(--paper-accent) 5%);
  }
  .deployment > div {
    justify-content: flex-start;
  }
  .deployment small {
    color: var(--paper-ink-faint);
  }
  .deploy-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--paper-accent);
  }
  .deployment[data-phase='queued'] .deploy-dot,
  .deployment[data-phase='building'] .deploy-dot,
  .deployment[data-phase='submitted'] .deploy-dot {
    background: #d29b2d;
  }
  .deployment[data-phase='error'] .deploy-dot {
    background: #c65050;
  }
  .deploy-track {
    flex: 1;
    height: 4px;
    overflow: hidden;
    border-radius: 99px;
    background: color-mix(in srgb, var(--paper-line) 80%, transparent);
  }
  .deploy-track span {
    display: block;
    height: 100%;
    background: var(--paper-accent);
    transition: width 0.3s;
  }
  .deployment > a {
    font-size: 0.78rem;
    color: var(--paper-accent);
  }
  .controls {
    margin-bottom: 13px;
  }
  .modules {
    margin-bottom: 34px;
  }
  .modules-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 12px;
  }
  .modules-heading h2 {
    margin: 0;
    font: 400 1.7rem var(--font-page-heading);
  }
  .modules-heading span {
    color: var(--paper-ink-faint);
    font-size: 0.76rem;
  }
  .module-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
  }
  .module-grid a {
    display: grid;
    gap: 4px;
    padding: 16px;
    border: 1px solid var(--paper-line);
    border-radius: 12px;
    background: color-mix(in srgb, var(--paper-bg) 96%, var(--paper-accent) 4%);
  }
  .module-grid a:hover {
    border-color: var(--paper-accent);
  }
  .module-grid span {
    color: var(--paper-accent);
    font-size: 0.68rem;
  }
  .module-grid small {
    color: var(--paper-ink-soft);
    font-size: 0.72rem;
  }
  .status-tabs {
    display: flex;
    gap: 4px;
  }
  .status-tabs button,
  .bulk-bar button {
    padding: 7px 10px;
    border: 0;
    border-radius: 7px;
    background: transparent;
    color: var(--paper-ink-soft);
    font: inherit;
    font-size: 0.78rem;
    cursor: pointer;
  }
  .status-tabs button[aria-pressed='true'] {
    background: color-mix(in srgb, var(--paper-accent) 16%, transparent);
    color: var(--paper-ink);
  }
  .controls > div:last-child {
    display: flex;
    gap: 8px;
  }
  .controls input,
  .controls select {
    padding: 8px 10px;
    border: 1px solid var(--paper-line);
    border-radius: 8px;
    background: var(--paper-bg);
    color: inherit;
  }
  .bulk-bar {
    margin-bottom: 10px;
    padding: 10px 12px;
    border: 1px solid color-mix(in srgb, var(--paper-accent) 30%, var(--paper-line) 70%);
    border-radius: 9px;
    background: color-mix(in srgb, var(--paper-accent) 12%, transparent);
    font-size: 0.8rem;
  }
  .bulk-bar[hidden] {
    display: none;
  }
  .bulk-bar > div {
    display: flex;
    gap: 5px;
  }
  .content-list {
    overflow: hidden;
    border: 1px solid var(--paper-line);
    border-radius: 12px;
    background: var(--paper-bg);
  }
  .content-list article {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 13px;
    align-items: center;
    padding: 15px;
    border-bottom: 1px solid color-mix(in srgb, var(--paper-line) 80%, transparent);
  }
  .content-list article:last-of-type {
    border-bottom: 0;
  }
  .content-list article > input {
    width: 15px;
    height: 15px;
  }
  .content-main {
    display: grid;
    gap: 5px;
    min-width: 0;
  }
  .content-main > div {
    display: flex;
    gap: 7px;
    align-items: center;
  }
  .content-main > strong {
    overflow: hidden;
    font-size: 0.96rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .content-main small,
  .kind {
    color: var(--paper-ink-faint);
    font-size: 0.72rem;
  }
  .badge,
  .issue {
    padding: 3px 7px;
    border-radius: 99px;
    background: color-mix(in srgb, var(--paper-accent) 16%, transparent);
    color: var(--paper-ink-soft);
    font-size: 0.68rem;
  }
  .badge-published {
    background: color-mix(in srgb, var(--paper-accent) 28%, transparent);
    color: color-mix(in srgb, var(--paper-accent) 80%, var(--paper-ink) 20%);
  }
  .badge-ready {
    background: color-mix(in srgb, #f7c948 24%, transparent);
    color: var(--paper-ink);
  }
  .issue {
    background: color-mix(in srgb, #e6a74a 22%, transparent);
    color: color-mix(in srgb, #f4a825 68%, var(--paper-ink) 32%);
  }
  .row-actions {
    justify-content: flex-end;
  }
  .row-actions a {
    padding: 7px 9px;
    border-radius: 7px;
    color: var(--paper-ink-soft);
    font-size: 0.76rem;
  }
  .row-actions .edit {
    background: color-mix(in srgb, var(--paper-accent) 14%, transparent);
    color: var(--paper-ink);
  }
  .empty {
    padding: 32px;
    text-align: center;
    color: var(--paper-ink-faint);
  }
  .content-list article[hidden] {
    display: none;
  }
  @media (max-width: 680px) {
    .module-grid {
      grid-template-columns: 1fr 1fr;
    }
    .shell {
      width: calc(100% - 18px);
    }
    .page-header {
      align-items: flex-end;
      padding-top: 30px;
    }
    .page-header p {
      display: none;
    }
    .controls {
      align-items: stretch;
      flex-direction: column;
    }
    .controls > div:last-child input {
      flex: 1;
      min-width: 0;
    }
    .content-list article {
      grid-template-columns: auto 1fr;
    }
    .row-actions {
      grid-column: 2;
      justify-content: flex-start;
    }
    .deployment {
      align-items: flex-start;
      flex-direction: column;
    }
    .deploy-track {
      width: 100%;
    }
    .topbar > div a:nth-child(1),
    .topbar > div a:nth-child(2) {
      display: none;
    }
  }
</style>
