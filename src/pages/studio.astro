---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import { countWords, estimateReadingMinutes, getPublicationStatus } from '../utils/content-metrics';
import { hasContentFiles } from '../utils/content-source';

const [blog, projects, vibe, media, about] = await Promise.all([
  getCollection('blog'),
  getCollection('projects'),
  getCollection('vibe'),
  hasContentFiles('media') ? getCollection('media') : Promise.resolve([]),
  getCollection('about'),
]);

const definitions = [
  ...blog.map((entry) => ({ entry, type: '博客', collection: 'blog' })),
  ...projects.map((entry) => ({ entry, type: '项目', collection: 'projects' })),
  ...vibe.map((entry) => ({ entry, type: '随记', collection: 'vibe' })),
  ...media.map((entry) => ({ entry, type: '书影音', collection: 'media' })),
  ...about.map((entry) => ({ entry, type: '页面', collection: 'about' })),
];

const items = definitions
  .map(({ entry, type, collection }) => {
    const data = entry.data as Record<string, any>;
    const source = entry.body ?? '';
    const status = getPublicationStatus(data);
    const date = data.updatedDate ?? data.date ?? data.completedAt;
    const isSingleton = collection === 'about';
    return {
      id: entry.id,
      title: data.title || '未命名内容',
      type,
      collection,
      status,
      date: date ? new Date(date) : undefined,
      words: countWords(source),
      minutes: estimateReadingMinutes(source),
      taxonomy: [...(data.categories ?? []), ...(data.series ?? []), ...(data.tags ?? [])],
      editorUrl: isSingleton
        ? '/keystatic/singleton/about'
        : `/keystatic/collection/${collection}/item/${entry.id}`,
      previewUrl: isSingleton ? '/preview/about' : `/preview/${collection}/${entry.id}`,
    };
  })
  .sort((a, b) => (b.date?.valueOf() ?? 0) - (a.date?.valueOf() ?? 0));

const statusLabels = { draft: '草稿', ready: '待发布', published: '已发布' } as const;
const totals = Object.fromEntries(
  Object.keys(statusLabels).map((status) => [
    status,
    items.filter((item) => item.status === status).length,
  ]),
);
const deployedSha = import.meta.env.VERCEL_GIT_COMMIT_SHA || 'local';
const builtAt = new Date().toISOString();
---

<!doctype html>
<html lang="zh-CN" data-palette="green-soft">
  <head>
    <BaseHead title="内容工作台" description="个人站内容管理与发布状态" />
    <meta name="robots" content="noindex,nofollow,noarchive" />
  </head>
  <body>
    <main class="shell">
      <header class="hero">
        <div>
          <p class="eyebrow">GOU MIN · PUBLISHING</p>
          <h1>内容工作台</h1>
          <p>先看状态和检查结果，再进入编辑器。这里不保存密钥，也不直接修改内容。</p>
        </div>
        <div class="actions">
          <a class="primary" href="/keystatic">进入写作后台</a>
          <a href="/">查看网站</a>
        </div>
      </header>

      <section class="summary" aria-label="内容统计">
        {
          Object.entries(statusLabels).map(([status, label]) => (
            <button type="button" data-filter={status}>
              <>
                <strong>{totals[status]}</strong>
                <span>{label}</span>
              </>
            </button>
          ))
        }
        <button type="button" data-filter="all" aria-pressed="true"
          ><strong>{items.length}</strong><span>全部</span></button
        >
      </section>

      <section class="deployment" data-deployed-sha={deployedSha}>
        <div>
          <span class="deploy-dot"></span><strong data-deploy-label
            >{deployedSha === 'local' ? '本地构建' : '检查部署状态…'}</strong
          >
        </div>
        <p data-deploy-detail>
          当前构建 <code>{deployedSha.slice(0, 7)}</code> · {
            new Date(builtAt).toLocaleString('zh-CN', { timeZone: 'Asia/Shanghai' })
          }
        </p>
      </section>

      <section class="content-section">
        <div class="section-heading">
          <div><p class="eyebrow">CONTENT QUEUE</p><h2>继续编辑</h2></div>
          <label
            >类型 <select data-type-filter
              ><option value="all">全部</option>{
                [...new Set(items.map((item) => item.type))].map((type) => (
                  <option value={type}>{type}</option>
                ))
              }</select
            ></label
          >
        </div>
        <div class="table-wrap">
          <table>
            <thead
              ><tr
                ><th>内容</th><th>状态</th><th>更新时间</th><th>篇幅</th><th>分类</th><th
                  ><span class="sr-only">操作</span></th
                ></tr
              ></thead
            >
            <tbody>
              {
                items.map((item) => (
                  <tr data-row data-status={item.status} data-type={item.type}>
                    <td>
                      <>
                        <span class="kind">{item.type}</span>
                        <strong>{item.title}</strong>
                        <small>{item.id}</small>
                      </>
                    </td>
                    <td>
                      <span class:list={['badge', `badge-${item.status}`]}>
                        {statusLabels[item.status]}
                      </span>
                    </td>
                    <td>
                      {item.date
                        ? item.date.toLocaleDateString('zh-CN', { timeZone: 'Asia/Shanghai' })
                        : '—'}
                    </td>
                    <td>
                      {item.words} 字 · {item.minutes} 分钟
                    </td>
                    <td>
                      <span class="taxonomy">{item.taxonomy.slice(0, 3).join(' · ') || '—'}</span>
                    </td>
                    <td>
                      <div class="row-actions">
                        <>
                          <a href={item.previewUrl}>预览</a>
                          <a class="edit" href={item.editorUrl}>
                            编辑
                          </a>
                        </>
                      </div>
                    </td>
                  </tr>
                ))
              }
            </tbody>
          </table>
          <p class="empty" hidden data-empty>没有符合筛选条件的内容。</p>
        </div>
      </section>
    </main>

    <script>
      const filters = document.querySelectorAll('[data-filter]');
      const typeFilter = document.querySelector('[data-type-filter]');
      const rows = [...document.querySelectorAll('[data-row]')];
      const empty = document.querySelector('[data-empty]');
      let activeStatus = 'all';
      const applyFilters = () => {
        const activeType = typeFilter instanceof HTMLSelectElement ? typeFilter.value : 'all';
        let visible = 0;
        for (const row of rows) {
          if (!(row instanceof HTMLElement)) continue;
          const show =
            (activeStatus === 'all' || row.dataset.status === activeStatus) &&
            (activeType === 'all' || row.dataset.type === activeType);
          row.hidden = !show;
          if (show) visible++;
        }
        if (empty instanceof HTMLElement) empty.hidden = visible > 0;
      };
      filters.forEach((filter) =>
        filter.addEventListener('click', () => {
          if (!(filter instanceof HTMLElement)) return;
          activeStatus = filter.dataset.filter ?? 'all';
          filters.forEach((item) => item.setAttribute('aria-pressed', String(item === filter)));
          applyFilters();
        }),
      );
      typeFilter?.addEventListener('change', applyFilters);

      const deployment = document.querySelector('[data-deployed-sha]');
      const deployedSha =
        deployment instanceof HTMLElement ? deployment.dataset.deployedSha : 'local';
      if (deployedSha && deployedSha !== 'local') {
        fetch('https://api.github.com/repos/GM2020JLU/GM-WEB/commits/main', {
          headers: { Accept: 'application/vnd.github+json' },
        })
          .then((response) =>
            response.ok ? response.json() : Promise.reject(new Error(String(response.status))),
          )
          .then((result) => {
            const current = result.sha === deployedSha;
            const label = document.querySelector('[data-deploy-label]');
            const detail = document.querySelector('[data-deploy-detail]');
            if (label) label.textContent = current ? '最新版本已上线' : '新版本等待部署';
            if (detail)
              detail.textContent = current
                ? `线上提交 ${deployedSha.slice(0, 7)}`
                : `线上 ${deployedSha.slice(0, 7)} · 仓库 ${String(result.sha).slice(0, 7)}`;
            deployment?.classList.add(current ? 'is-current' : 'is-pending');
          })
          .catch(() => {
            const label = document.querySelector('[data-deploy-label]');
            if (label) label.textContent = '暂时无法确认部署状态';
          });
      }
    </script>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }
  :global(body) {
    margin: 0;
    background: var(--paper-bg);
    color: var(--paper-ink);
    font-family: var(--font-ui);
  }
  .shell {
    width: min(1180px, calc(100% - 32px));
    margin: 0 auto;
    padding: 68px 0 96px;
  }
  .hero,
  .section-heading,
  .deployment {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }
  .hero h1 {
    margin: 4px 0 10px;
    font: 400 clamp(2.6rem, 7vw, 5.2rem)/1 var(--font-page-heading);
  }
  .hero p {
    max-width: 56ch;
    color: var(--paper-ink-soft);
    line-height: 1.7;
  }
  .eyebrow {
    margin: 0;
    color: var(--paper-accent);
    font: 700 0.7rem/1.4 var(--font-meta);
    letter-spacing: 0.14em;
  }
  .actions,
  .row-actions {
    display: flex;
    gap: 9px;
  }
  a,
  button,
  select {
    border: 1px solid var(--paper-line-strong);
    border-radius: 9px;
    background: var(--paper-bg);
    color: inherit;
    font: inherit;
  }
  a,
  button {
    padding: 10px 13px;
    text-decoration: none;
    cursor: pointer;
  }
  .primary,
  .edit {
    border-color: var(--paper-accent);
    background: var(--paper-accent);
    color: white;
  }
  .summary {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
    margin: 48px 0 18px;
  }
  .summary button {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    padding: 20px;
    text-align: left;
  }
  .summary strong {
    font: 400 2rem/1 var(--font-page-heading);
  }
  .summary span {
    color: var(--paper-ink-soft);
  }
  .summary button[aria-pressed='true'] {
    border-color: var(--paper-accent);
    box-shadow: inset 0 -3px var(--paper-accent);
  }
  .deployment {
    padding: 18px 20px;
    border: 1px solid var(--paper-line);
    border-radius: 12px;
    background: color-mix(in srgb, var(--paper-bg) 90%, var(--paper-accent) 10%);
  }
  .deployment div {
    display: flex;
    gap: 10px;
    align-items: center;
  }
  .deployment p {
    margin: 0;
    color: var(--paper-ink-faint);
    font: 0.78rem/1.5 var(--font-meta);
  }
  .deploy-dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #8a938c;
    box-shadow: 0 0 0 4px color-mix(in srgb, #8a938c 18%, transparent);
  }
  .is-current .deploy-dot {
    background: #2f9950;
  }
  .is-pending .deploy-dot {
    background: #c4941c;
  }
  .content-section {
    margin-top: 58px;
  }
  h2 {
    margin: 4px 0 0;
    font: 400 2rem/1.2 var(--font-page-heading);
  }
  .section-heading label {
    color: var(--paper-ink-soft);
    font-size: 0.85rem;
  }
  select {
    margin-left: 8px;
    padding: 8px 28px 8px 10px;
  }
  .table-wrap {
    overflow-x: auto;
    margin-top: 20px;
    border: 1px solid var(--paper-line);
    border-radius: 14px;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    min-width: 920px;
  }
  th {
    color: var(--paper-ink-faint);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-align: left;
  }
  th,
  td {
    padding: 15px 16px;
    border-bottom: 1px solid var(--paper-line);
    vertical-align: middle;
  }
  tbody tr:last-child td {
    border-bottom: 0;
  }
  td:first-child {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 2px 9px;
  }
  td:first-child small {
    grid-column: 2;
    color: var(--paper-ink-faint);
  }
  .kind {
    grid-row: 1 / 3;
    align-self: center;
    color: var(--paper-accent);
    font-size: 0.72rem;
  }
  .badge {
    display: inline-block;
    padding: 4px 8px;
    border-radius: 99px;
    background: #e5e8e5;
    font-size: 0.75rem;
  }
  .badge-ready {
    background: #fff1bd;
    color: #725800;
  }
  .badge-published {
    background: #d7efdd;
    color: #185b2b;
  }
  .taxonomy {
    display: block;
    max-width: 230px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: var(--paper-ink-soft);
  }
  .row-actions a {
    padding: 7px 10px;
    font-size: 0.8rem;
  }
  .empty {
    padding: 32px;
    text-align: center;
    color: var(--paper-ink-faint);
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
  }
  @media (max-width: 720px) {
    .shell {
      padding-top: 34px;
    }
    .hero,
    .section-heading,
    .deployment {
      align-items: flex-start;
      flex-direction: column;
    }
    .summary {
      grid-template-columns: repeat(2, 1fr);
    }
    .actions {
      flex-wrap: wrap;
    }
  }
</style>
