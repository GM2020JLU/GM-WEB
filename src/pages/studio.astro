---
import { getCollection } from 'astro:content';
import {
  ArrowUpRight,
  Feather,
  FilePlus2,
  FileText,
  FolderKanban,
  Library,
  PanelsTopLeft,
  SlidersHorizontal,
  Upload,
} from 'lucide-astro';
import BaseHead from '../components/BaseHead.astro';
import StudioNavigation from '../components/studio/StudioNavigation.astro';
import StudioPageHeader from '../components/studio/StudioPageHeader.astro';
import { getThemePalette } from '../data/site';
import { getContentHealth, getPublicationStatus } from '../utils/content-metrics';
import { hasContentFiles } from '../utils/content-source';

const [blog, projects, vibe, media, about] = await Promise.all([
  getCollection('blog'),
  getCollection('projects'),
  getCollection('vibe'),
  hasContentFiles('media') ? getCollection('media') : Promise.resolve([]),
  getCollection('about'),
]);
const definitions = [
  ...blog.map((entry) => ({ entry, type: '博客', collection: 'blog' })),
  ...projects.map((entry) => ({ entry, type: '项目', collection: 'projects' })),
  ...vibe.map((entry) => ({ entry, type: '随记', collection: 'vibe' })),
  ...media.map((entry) => ({ entry, type: '书影音', collection: 'media' })),
  ...about.map((entry) => ({ entry, type: '页面', collection: 'about' })),
];
const items = definitions
  .map(({ entry, type, collection }) => {
    const data = entry.data as Record<string, any>;
    const status = getPublicationStatus(data);
    const isAbout = collection === 'about';
    const publicUrl =
      status === 'published'
        ? collection === 'blog'
          ? `/blog/${entry.id}`
          : collection === 'projects'
            ? entry.id === 'index'
              ? '/projects'
              : `/projects/${entry.id}`
            : collection === 'vibe'
              ? '/vibe'
              : collection === 'media'
                ? '/media'
                : '/about'
        : undefined;
    return {
      id: entry.id,
      title: data.title || '未命名内容',
      type,
      collection,
      status,
      revision: typeof data.updatedDate === 'string' ? data.updatedDate : '',
      date: data.updatedDate ?? data.date ?? data.completedAt,
      issues: getContentHealth({ collection, id: entry.id, data, body: entry.body ?? '' }),
      publicUrl,
      editorUrl: `/studio/edit/${collection}/${isAbout ? 'about' : entry.id}`,
      previewUrl: isAbout ? '/preview/about' : `/preview/${collection}/${entry.id}`,
    };
  })
  .sort((a, b) => new Date(b.date || 0).valueOf() - new Date(a.date || 0).valueOf());
const statusLabels = { draft: '草稿', ready: '待发布', published: '已发布' } as const;
const deployedSha = import.meta.env.VERCEL_GIT_COMMIT_SHA || 'local';
const palette = await getThemePalette();
const moduleCards = [
  {
    code: '01 / BLOG',
    label: '博客文章',
    note: '长文与技术笔记',
    href: '/studio/content/blog',
    count: blog.length,
    icon: FileText,
  },
  {
    code: '02 / PROJECTS',
    label: '项目案例',
    note: '过程、取舍与结果',
    href: '/studio/content/projects',
    count: projects.length,
    icon: FolderKanban,
  },
  {
    code: '03 / VIBE',
    label: '随记',
    note: '短想法与生活片段',
    href: '/studio/content/vibe',
    count: vibe.length,
    icon: Feather,
  },
  {
    code: '04 / MEDIA',
    label: '书影音',
    note: '阅读与观看记录',
    href: '/studio/content/media',
    count: media.length,
    icon: Library,
  },
  {
    code: '05 / PAGES',
    label: '站点页面',
    note: '关于页与独立页面',
    href: '/studio/content/pages',
    count: about.length,
    icon: PanelsTopLeft,
  },
  {
    code: '06 / SETTINGS',
    label: '站点设置',
    note: '首页、身份与页面文案',
    href: '/studio/site',
    count: null,
    icon: SlidersHorizontal,
  },
];
const dashboardMetrics = [
  { label: '全部内容', value: items.length, note: '跨所有模块', href: '/studio' },
  {
    label: '草稿',
    value: items.filter((item) => item.status === 'draft').length,
    note: '继续打磨',
    href: '/studio?status=draft',
  },
  {
    label: '待发布',
    value: items.filter((item) => item.status === 'ready').length,
    note: '准备上线',
    href: '/studio?status=ready',
  },
  {
    label: '需完善',
    value: items.filter((item) => item.issues.length > 0).length,
    note: '发布前检查',
    href: '/studio?status=issues',
  },
];
---

<!doctype html>
<html lang="zh-CN" data-palette={palette}>
  <head
    ><BaseHead title="内容管理" description="个人站内容管理后台" /><meta
      name="robots"
      content="noindex,nofollow,noarchive"
    /></head
  >
  <body class="studio-with-navigation">
    <StudioNavigation />
    <main class="shell">
      <StudioPageHeader
        eyebrow="STUDIO / OVERVIEW"
        title="内容工作台"
        description="从一个地方整理、预览和发布你的个人站内容。"
      >
        <div slot="actions" class="header-actions">
          <a class="secondary-action" href="/studio/import"
            ><Upload size={16} aria-hidden="true" />导入 Markdown</a
          ><details class="new-menu">
            <summary><FilePlus2 size={16} aria-hidden="true" />新建内容</summary><div>
              <a href="/studio/edit/blog/new?new=1">博客</a><a href="/studio/edit/vibe/new?new=1"
                >随记</a
              ><a href="/studio/edit/projects/new?new=1">项目</a><a
                href="/studio/edit/media/new?new=1">书影音</a
              >
            </div>
          </details>
        </div>
      </StudioPageHeader>

      <section class="deployment" data-deployment data-runtime-sha={deployedSha} aria-live="polite">
        <div>
          <span class="deploy-dot"></span><span class="deploy-copy"
            ><strong data-deployment-title>网站运行正常</strong><small data-deployment-detail
              >当前版本 {deployedSha.slice(0, 7)}</small
            ></span
          >
        </div>
        <div class="deploy-track" hidden data-deployment-track>
          <span data-deployment-progress></span>
        </div><a data-deployment-link hidden target="_blank">打开线上页面</a>
      </section>

      <section class="dashboard-metrics" aria-label="内容摘要">
        {
          dashboardMetrics.map((metric) => (
            <a href={metric.href}>
              <>
                <span>{metric.label}</span>
                <strong>{metric.value}</strong>
                <small>{metric.note}</small>
              </>
            </a>
          ))
        }
      </section>

      <section class="modules" aria-labelledby="modules-title">
        <div class="modules-heading">
          <div><p>QUICK ACCESS</p><h2 id="modules-title">网站模块</h2></div><span
            >选择要管理的区域</span
          >
        </div>
        <div class="module-grid">
          {
            moduleCards.map((module) => {
              const Icon = module.icon;
              return (
                <a href={module.href}>
                  <span class="module-code">{module.code}</span>
                  <Icon class="module-icon" size={19} stroke-width={1.8} aria-hidden="true" />
                  <strong class="module-count">
                    {module.count === null ? '··' : String(module.count).padStart(2, '0')}
                  </strong>
                  <span class="module-copy">
                    <strong>{module.label}</strong>
                    <small>{module.note}</small>
                  </span>
                  <ArrowUpRight
                    class="module-arrow"
                    size={17}
                    stroke-width={1.8}
                    aria-hidden="true"
                  />
                </a>
              );
            })
          }
        </div>
      </section>

      <section class="content-section">
        <div class="content-section-heading">
          <div><p>CONTENT LIBRARY</p><h2>全部内容</h2></div><span>按状态、类型或标题快速筛选</span>
        </div>
        <div class="controls">
          <div class="status-tabs" role="group" aria-label="内容状态">
            <button type="button" data-filter="all" aria-pressed="true">全部</button><button
              type="button"
              data-filter="draft">草稿</button
            ><button type="button" data-filter="ready">待发布</button><button
              type="button"
              data-filter="published">已发布</button
            ><button type="button" data-filter="issues">需完善</button>
          </div><div>
            <input
              type="search"
              placeholder="搜索内容"
              aria-label="搜索内容标题与摘要"
              data-search
            /><select data-type-filter aria-label="内容类型"
              ><option value="all">全部类型</option>{
                [...new Set(items.map((item) => item.type))].map((type) => (
                  <option value={type}>{type}</option>
                ))
              }</select
            >
          </div>
        </div>

        <p
          class="selection-announcement"
          data-selection-announcement
          aria-live="polite"
          aria-atomic="true"
        >
        </p>
        <div class="bulk-bar" id="studio-bulk-actions" data-bulk-bar hidden>
          <span>已选择 <strong data-selected-count>0</strong> 条</span><div>
            <button type="button" data-bulk-action="draft">转为草稿</button><button
              type="button"
              data-bulk-action="ready">待发布</button
            ><button type="button" data-bulk-action="publish">发布</button>
          </div>
        </div>
        <div class="bulk-feedback" data-bulk-feedback role="status" hidden></div>

        <div class="content-list" data-content-list>
          {
            items.map((item) => (
              <article
                data-row
                data-status={item.status}
                data-type={item.type}
                data-health={item.issues.length ? 'issues' : 'good'}
              >
                <label class="select-target">
                  <input
                    type="checkbox"
                    data-select-item
                    data-collection={item.collection}
                    data-slug={item.id}
                    data-revision={item.revision}
                    aria-label={`选择 ${item.title}`}
                    aria-controls="studio-bulk-actions"
                  />
                </label>
                <div class="content-main">
                  <>
                    <div>
                      <span class:list={['badge', `badge-${item.status}`]}>
                        {statusLabels[item.status]}
                      </span>
                      <span class="kind">{item.type}</span>
                      {item.issues.length > 0 && (
                        <span class="issue">{item.issues.length} 项需完善</span>
                      )}
                    </div>
                    <strong>{item.title}</strong>
                    <small>
                      {item.date
                        ? new Date(item.date).toLocaleDateString('zh-CN', {
                            timeZone: 'Asia/Shanghai',
                          })
                        : '暂无日期'}
                    </small>
                  </>
                </div>
                <div class="row-actions">
                  <a class="edit" href={item.editorUrl} aria-label={`编辑 ${item.title}`}>
                    编辑
                  </a>
                  <a href={item.previewUrl} aria-label={`预览 ${item.title}`}>
                    预览
                  </a>
                  {item.publicUrl && (
                    <a href={item.publicUrl} aria-label={`在线查看 ${item.title}`}>
                      线上
                    </a>
                  )}
                </div>
              </article>
            ))
          }
          <p class="empty" hidden data-empty>没有符合条件的内容。</p>
        </div>
      </section>
    </main>

    <script>
      import { setupStudioDashboard } from '../utils/studio-dashboard-client';

      setupStudioDashboard(document);
    </script>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }
  :global(body) {
    margin: 0;
    background: var(--paper-bg);
    color: var(--paper-ink);
    font-family: var(--font-ui);
  }
  .shell {
    width: min(1040px, calc(100% - 32px));
    margin: auto;
    padding: 18px 0 80px;
  }
  .topbar,
  .page-header,
  .controls,
  .bulk-bar,
  .deployment,
  .deployment > div,
  .brand,
  .topbar > div,
  .header-actions,
  .row-actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }
  .topbar {
    height: 52px;
    border-bottom: 1px solid var(--paper-line);
  }
  .brand {
    justify-content: flex-start;
  }
  .brand span {
    display: grid;
    width: 32px;
    height: 32px;
    place-items: center;
    border-radius: 9px;
    background: var(--paper-ink);
    color: var(--paper-bg);
    font-size: 0.7rem;
  }
  .topbar a,
  a {
    color: inherit;
    text-decoration: none;
  }
  .topbar > div a {
    color: var(--studio-text-meta);
    font-size: 0.8rem;
  }
  .page-header {
    padding: 42px 0 24px;
  }
  .page-header h1 {
    margin: 0;
    font: 400 clamp(2.4rem, 7vw, 4.5rem)/1 var(--font-page-heading);
  }
  .page-header p {
    margin: 8px 0 0;
    color: var(--paper-ink-soft);
  }
  .header-actions > a,
  .new-menu > summary {
    padding: 9px 12px;
    border: 1px solid var(--paper-line);
    border-radius: 8px;
    background: var(--paper-bg);
    font-size: 0.82rem;
  }
  .new-menu {
    position: relative;
  }
  .new-menu > summary {
    list-style: none;
    background: var(--paper-accent);
    color: var(--paper-bg);
    cursor: pointer;
  }
  .new-menu > div {
    position: absolute;
    right: 0;
    z-index: 3;
    display: grid;
    width: 140px;
    margin-top: 7px;
    padding: 7px;
    border: 1px solid var(--paper-line);
    border-radius: 10px;
    background: var(--paper-bg);
    box-shadow: 0 14px 36px #273e2e24;
  }
  .new-menu > div a {
    padding: 8px;
    border-radius: 6px;
  }
  .new-menu > div a:hover {
    background: color-mix(in srgb, var(--paper-bg) 88%, var(--paper-accent) 12%);
  }
  .deployment {
    margin-bottom: 28px;
    padding: 13px 15px;
    border: 1px solid var(--paper-line);
    border-radius: 11px;
    background: color-mix(in srgb, var(--paper-bg) 95%, var(--paper-accent) 5%);
  }
  .deployment > div {
    justify-content: flex-start;
  }
  .deployment small {
    color: var(--studio-text-meta);
  }
  .deploy-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--paper-accent);
  }
  .deployment[data-phase='queued'] .deploy-dot,
  .deployment[data-phase='building'] .deploy-dot,
  .deployment[data-phase='submitted'] .deploy-dot {
    background: #d29b2d;
  }
  .deployment[data-phase='error'] .deploy-dot {
    background: #c65050;
  }
  .deploy-track {
    flex: 1;
    height: 4px;
    overflow: hidden;
    border-radius: 99px;
    background: color-mix(in srgb, var(--paper-line) 80%, transparent);
  }
  .deploy-track span {
    display: block;
    height: 100%;
    background: var(--paper-accent);
    transition: width 0.3s;
  }
  .deployment > a {
    font-size: 0.78rem;
    color: var(--studio-accent-strong);
  }
  .controls {
    margin-bottom: 13px;
  }
  .modules {
    margin-bottom: 34px;
  }
  .modules-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 12px;
  }
  .modules-heading h2 {
    margin: 0;
    font: 400 1.7rem var(--font-page-heading);
  }
  .modules-heading span {
    color: var(--studio-text-meta);
    font-size: 0.76rem;
  }
  .module-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
  }
  .module-grid a {
    display: grid;
    gap: 4px;
    padding: 16px;
    border: 1px solid var(--paper-line);
    border-radius: 12px;
    background: color-mix(in srgb, var(--paper-bg) 96%, var(--paper-accent) 4%);
  }
  .module-grid a:hover {
    border-color: var(--paper-accent);
  }
  .module-grid span {
    color: var(--studio-accent-strong);
    font-size: 0.68rem;
  }
  .module-grid small {
    color: var(--paper-ink-soft);
    font-size: 0.72rem;
  }
  .status-tabs {
    display: flex;
    gap: 4px;
  }
  .status-tabs button,
  .bulk-bar button {
    padding: 7px 10px;
    border: 0;
    border-radius: 7px;
    background: transparent;
    color: var(--paper-ink-soft);
    font: inherit;
    font-size: 0.78rem;
    cursor: pointer;
  }
  .status-tabs button[aria-pressed='true'] {
    background: color-mix(in srgb, var(--paper-accent) 16%, transparent);
    color: var(--paper-ink);
  }
  .controls > div:last-child {
    display: flex;
    gap: 8px;
  }
  .controls input,
  .controls select {
    padding: 8px 10px;
    border: 1px solid var(--paper-line);
    border-radius: 8px;
    background: var(--paper-bg);
    color: inherit;
  }
  .bulk-bar {
    margin-bottom: 10px;
    padding: 10px 12px;
    border: 1px solid color-mix(in srgb, var(--paper-accent) 30%, var(--paper-line) 70%);
    border-radius: 9px;
    background: color-mix(in srgb, var(--paper-accent) 12%, transparent);
    font-size: 0.8rem;
  }
  .bulk-bar[hidden] {
    display: none;
  }
  .bulk-feedback {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin: 0 0 10px;
    padding: 11px 13px;
    border: 1px solid var(--studio-border);
    border-radius: 9px;
    background: var(--studio-surface-muted);
    font-size: 0.78rem;
  }
  .bulk-feedback[hidden] {
    display: none;
  }
  .bulk-feedback > div {
    display: grid;
    gap: 2px;
  }
  .bulk-feedback small {
    color: var(--studio-text-secondary);
  }
  .bulk-feedback.error {
    border-color: color-mix(in srgb, var(--studio-danger) 55%, var(--studio-border));
    background: var(--studio-danger-bg);
  }
  .bulk-feedback button {
    border: 1px solid var(--studio-control-border);
    background: var(--studio-surface);
    color: inherit;
    cursor: pointer;
  }
  .bulk-bar > div {
    display: flex;
    gap: 5px;
  }
  .content-list {
    overflow: hidden;
    border: 1px solid var(--paper-line);
    border-radius: 12px;
    background: var(--paper-bg);
  }
  .content-list article {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 13px;
    align-items: center;
    padding: 15px;
    border-bottom: 1px solid color-mix(in srgb, var(--paper-line) 80%, transparent);
  }
  .content-list article:last-of-type {
    border-bottom: 0;
  }
  .selection-announcement {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  .select-target {
    display: grid;
    width: 44px;
    height: 44px;
    place-items: center;
    border-radius: 8px;
    cursor: pointer;
  }
  .select-target:has(input:focus-visible) {
    outline: 3px solid var(--studio-focus-ring);
    outline-offset: 2px;
  }
  .select-target input {
    width: 18px;
    height: 18px;
    margin: 0;
    cursor: pointer;
  }
  .content-main {
    display: grid;
    gap: 5px;
    min-width: 0;
  }
  .content-main > div {
    display: flex;
    gap: 7px;
    align-items: center;
  }
  .content-main > strong {
    overflow: hidden;
    font-size: 0.96rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .content-main small,
  .kind {
    color: var(--studio-text-meta);
    font-size: 0.72rem;
  }
  .badge,
  .issue {
    padding: 3px 7px;
    border-radius: 99px;
    background: color-mix(in srgb, var(--paper-accent) 16%, transparent);
    color: var(--paper-ink-soft);
    font-size: 0.68rem;
  }
  .badge-published {
    background: color-mix(in srgb, var(--paper-accent) 28%, transparent);
    color: var(--studio-accent-strong);
  }
  .badge-ready {
    background: color-mix(in srgb, #f7c948 24%, transparent);
    color: var(--paper-ink);
  }
  .issue {
    background: color-mix(in srgb, #e6a74a 22%, transparent);
    color: color-mix(in srgb, #f4a825 68%, var(--paper-ink) 32%);
  }
  .row-actions {
    justify-content: flex-end;
  }
  .row-actions a {
    padding: 7px 9px;
    border-radius: 7px;
    color: var(--paper-ink-soft);
    font-size: 0.76rem;
  }
  .row-actions .edit {
    background: color-mix(in srgb, var(--paper-accent) 14%, transparent);
    color: var(--paper-ink);
  }
  .empty {
    padding: 32px;
    text-align: center;
    color: var(--studio-text-meta);
  }
  .content-list article[hidden] {
    display: none;
  }
  @media (max-width: 680px) {
    .module-grid {
      grid-template-columns: 1fr 1fr;
    }
    .shell {
      width: calc(100% - 18px);
    }
    .page-header {
      align-items: flex-end;
      padding-top: 30px;
    }
    .page-header p {
      display: none;
    }
    .controls {
      align-items: stretch;
      flex-direction: column;
    }
    .controls > div:last-child input {
      flex: 1;
      min-width: 0;
    }
    .content-list article {
      grid-template-columns: auto 1fr;
    }
    .row-actions {
      grid-column: 2;
      justify-content: flex-start;
    }
    .deployment {
      align-items: flex-start;
      flex-direction: column;
    }
    .deploy-track {
      width: 100%;
    }
    .topbar > div a:nth-child(1),
    .topbar > div a:nth-child(2) {
      display: none;
    }
  }

  .header-actions {
    display: flex;
    gap: 9px;
    align-items: center;
  }

  .secondary-action {
    white-space: nowrap;
  }

  .new-menu > summary {
    list-style: none;
    white-space: nowrap;
  }

  .new-menu > summary::-webkit-details-marker {
    display: none;
  }

  .new-menu > div {
