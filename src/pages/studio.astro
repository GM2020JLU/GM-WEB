---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import {
  countWords,
  estimateReadingMinutes,
  getContentHealth,
  getPublicationStatus,
} from '../utils/content-metrics';
import { hasContentFiles } from '../utils/content-source';
import {
  getKeystaticCreateUrl,
  getKeystaticEntryUrl,
  getKeystaticSingletonUrl,
} from '../utils/keystatic-routes';

const keystaticContext = import.meta.env.PROD ? { branch: 'main' } : {};

const [blog, projects, vibe, media, about] = await Promise.all([
  getCollection('blog'),
  getCollection('projects'),
  getCollection('vibe'),
  hasContentFiles('media') ? getCollection('media') : Promise.resolve([]),
  getCollection('about'),
]);

const definitions = [
  ...blog.map((entry) => ({ entry, type: '博客', collection: 'blog' })),
  ...projects.map((entry) => ({ entry, type: '项目', collection: 'projects' })),
  ...vibe.map((entry) => ({ entry, type: '随记', collection: 'vibe' })),
  ...media.map((entry) => ({ entry, type: '书影音', collection: 'media' })),
  ...about.map((entry) => ({ entry, type: '页面', collection: 'about' })),
];

const items = definitions
  .map(({ entry, type, collection }) => {
    const data = entry.data as Record<string, any>;
    const source = entry.body ?? '';
    const status = getPublicationStatus(data);
    const healthIssues = getContentHealth({ collection, id: entry.id, data, body: source });
    const date = data.updatedDate ?? data.date ?? data.completedAt;
    const isSingleton = collection === 'about';
    const contentExtension = collection === 'projects' || isSingleton ? 'mdx' : 'md';
    const contentPath = isSingleton
      ? `src/content/about.${contentExtension}`
      : `src/content/${collection}/${entry.id}.${contentExtension}`;
    const publicUrl =
      status !== 'published'
        ? undefined
        : collection === 'blog'
          ? `/blog/${entry.id}`
          : collection === 'projects'
            ? entry.id === 'index'
              ? '/projects'
              : `/projects/${entry.id}`
            : collection === 'about'
              ? '/about'
              : undefined;
    return {
      id: entry.id,
      title: data.title || '未命名内容',
      type,
      collection,
      status,
      date: date ? new Date(date) : undefined,
      words: countWords(source),
      minutes: estimateReadingMinutes(source),
      taxonomy: [...(data.categories ?? []), ...(data.series ?? []), ...(data.tags ?? [])],
      healthIssues,
      publicUrl,
      historyUrl: `https://github.com/GM2020JLU/GM-WEB/commits/main/${contentPath}`,
      editorUrl: isSingleton
        ? getKeystaticSingletonUrl('about', keystaticContext)
        : getKeystaticEntryUrl(collection, entry.id, keystaticContext),
      previewUrl: isSingleton ? '/preview/about' : `/preview/${collection}/${entry.id}`,
    };
  })
  .sort((a, b) => (b.date?.valueOf() ?? 0) - (a.date?.valueOf() ?? 0));

const statusLabels = { draft: '草稿', ready: '待发布', published: '已发布' } as const;
const totals = Object.fromEntries(
  Object.keys(statusLabels).map((status) => [
    status,
    items.filter((item) => item.status === status).length,
  ]),
);
const deployedSha = import.meta.env.VERCEL_GIT_COMMIT_SHA || 'local';
const builtAt = new Date().toISOString();
const needsAttention = totals.draft + totals.ready;
const unhealthyTotal = items.filter((item) => item.healthIssues.length > 0).length;
const quickActions = [
  {
    label: '导入 Markdown',
    note: '先检查，再安全创建草稿',
    href: '/studio/import',
    icon: '导',
  },
  {
    label: '写博客',
    note: '完整文章与技术笔记',
    href: getKeystaticCreateUrl('blog', keystaticContext),
    icon: '文',
  },
  {
    label: '记随记',
    note: '短想法、照片与片段',
    href: getKeystaticCreateUrl('vibe', keystaticContext),
    icon: '记',
  },
  {
    label: '建项目',
    note: '项目背景、过程与结果',
    href: getKeystaticCreateUrl('projects', keystaticContext),
    icon: '项',
  },
  {
    label: '加书影音',
    note: '阅读、电影与音乐记录',
    href: getKeystaticCreateUrl('media', keystaticContext),
    icon: '藏',
  },
];
---

<!doctype html>
<html lang="zh-CN" data-palette="green-soft">
  <head>
    <BaseHead title="内容工作台" description="个人站内容管理与发布状态" />
    <meta name="robots" content="noindex,nofollow,noarchive" />
  </head>
  <body>
    <main class="shell">
      <nav class="topbar" aria-label="后台导航">
        <a class="brand" href="/studio" aria-current="page">
          <span aria-hidden="true">GM</span>
          <strong>创作中心</strong>
        </a>
        <div>
          <a href="#create">新建内容</a>
          <a href="/studio/import">导入</a>
          <a href="#queue">内容队列</a>
          <a href="/keystatic">编辑器</a>
        </div>
      </nav>

      <header class="hero">
        <div>
          <p class="eyebrow">GOU MIN · PUBLISHING DESK</p>
          <h1>今天写点什么？</h1>
          <p>从这里新建、检查和预览内容；进入编辑器后保存草稿，再按发布流程逐步推进。</p>
        </div>
        <div class="actions">
          <a class="primary" href="/keystatic">打开内容编辑器</a>
          <a href="/">查看网站</a>
        </div>
      </header>

      <section class="notice" aria-label="待办提醒">
        <span class="notice-icon" aria-hidden="true">{needsAttention > 0 ? '!' : '✓'}</span>
        <div>
          <strong
            >{
              needsAttention > 0 ? `${needsAttention} 条内容需要继续处理` : '内容队列已经清空'
            }</strong
          >
          <p>
            {totals.draft} 条草稿 · {totals.ready} 条待发布 · {unhealthyTotal} 条建议完善；待发布内容会接受完整门禁检查。
          </p>
        </div>
        <a href="#queue">查看队列</a>
      </section>

      <section class="create-section" id="create">
        <div class="section-heading">
          <div><p class="eyebrow">QUICK START</p><h2>新建内容</h2></div>
          <p>选择内容类型，编辑器会准备对应字段。</p>
        </div>
        <div class="quick-grid">
          {
            quickActions.map((action) => (
              <a href={action.href} class="quick-card">
                <span aria-hidden="true">{action.icon}</span>
                <div>
                  <>
                    <strong>{action.label}</strong>
                    <small>{action.note}</small>
                  </>
                </div>
                <b aria-hidden="true">→</b>
              </a>
            ))
          }
        </div>
      </section>

      <section class="workflow" aria-labelledby="workflow-title">
        <div>
          <p class="eyebrow">PUBLISHING FLOW</p>
          <h2 id="workflow-title">三步发布，不会误上线</h2>
        </div>
        <ol>
          <li><span>1</span><div><strong>草稿</strong><small>放心记录，可以不完整</small></div></li>
          <li>
            <span>2</span><div><strong>待发布</strong><small>触发字段、图片与分类检查</small></div>
          </li>
          <li>
            <span>3</span><div><strong>已发布</strong><small>保存后自动部署到网站</small></div>
          </li>
        </ol>
      </section>

      <section class="summary" aria-label="内容统计">
        {
          Object.entries(statusLabels).map(([status, label]) => (
            <button type="button" data-filter={status}>
              <>
                <strong>{totals[status]}</strong>
                <span>{label}</span>
              </>
            </button>
          ))
        }
        <button type="button" data-filter="all" aria-pressed="true"
          ><strong>{items.length}</strong><span>全部</span></button
        >
        <button type="button" data-filter="issues" aria-pressed="false"
          ><strong>{unhealthyTotal}</strong><span>建议完善</span></button
        >
      </section>

      <section class="deployment" data-deployed-sha={deployedSha}>
        <div>
          <span class="deploy-dot"></span><strong data-deploy-label
            >{deployedSha === 'local' ? '本地构建' : '检查部署状态…'}</strong
          >
        </div>
        <p data-deploy-detail>
          当前构建 <code>{deployedSha.slice(0, 7)}</code> · {
            new Date(builtAt).toLocaleString('zh-CN', { timeZone: 'Asia/Shanghai' })
          }
        </p>
      </section>

      <section class="content-section" id="queue">
        <div class="section-heading">
          <div><p class="eyebrow">CONTENT QUEUE</p><h2>继续编辑</h2></div>
          <div class="table-controls">
            <label class="search-label"
              ><span class="sr-only">搜索内容</span><input
                type="search"
                placeholder="搜索标题或分类"
                data-search
              /></label
            >
            <label
              >类型 <select data-type-filter
                ><option value="all">全部</option>{
                  [...new Set(items.map((item) => item.type))].map((type) => (
                    <option value={type}>{type}</option>
                  ))
                }</select
              ></label
            >
          </div>
        </div>
        <div class="table-wrap">
          <table>
            <thead
              ><tr
                ><th>内容</th><th>状态</th><th>健康度</th><th>更新时间</th><th>篇幅</th><th>分类</th
                ><th><span class="sr-only">操作</span></th></tr
              ></thead
            >
            <tbody>
              {
                items.map((item) => (
                  <tr
                    data-row
                    data-status={item.status}
                    data-type={item.type}
                    data-health={item.healthIssues.length > 0 ? 'issues' : 'good'}
                  >
                    <td data-label="内容">
                      <>
                        <span class="kind">{item.type}</span>
                        <strong>{item.title}</strong>
                        <small>{item.id}</small>
                      </>
                    </td>
                    <td data-label="状态">
                      <span class:list={['badge', `badge-${item.status}`]}>
                        {statusLabels[item.status]}
                      </span>
                    </td>
                    <td data-label="健康度">
                      {item.healthIssues.length > 0 ? (
                        <details class="health-details">
                          <summary class="health health-issues">
                            {item.healthIssues.length} 项建议
                          </summary>
                          <ul>
                            {item.healthIssues.map((issue) => (
                              <li>{issue}</li>
                            ))}
                          </ul>
                        </details>
                      ) : (
                        <span class="health health-good">完整</span>
                      )}
                    </td>
                    <td data-label="更新时间">
                      {item.date
                        ? item.date.toLocaleDateString('zh-CN', { timeZone: 'Asia/Shanghai' })
                        : '—'}
                    </td>
                    <td data-label="篇幅">
                      {item.words} 字 · {item.minutes} 分钟
                    </td>
                    <td data-label="分类">
                      <span class="taxonomy">{item.taxonomy.slice(0, 3).join(' · ') || '—'}</span>
                    </td>
                    <td data-label="操作">
                      <div class="row-actions">
                        <>
                          <a href={item.previewUrl}>预览</a>
                          {item.publicUrl && <a href={item.publicUrl}>线上</a>}
                          <a class="edit" href={item.editorUrl}>
                            编辑
                          </a>
                          <a href={item.historyUrl} target="_blank" rel="noopener noreferrer">
                            历史<span class="sr-only">（新窗口打开）</span>
                          </a>
                        </>
                      </div>
                    </td>
                  </tr>
                ))
              }
            </tbody>
          </table>
          <p class="empty" hidden data-empty>没有符合筛选条件的内容。</p>
        </div>
      </section>
    </main>

    <script>
      import { matchesContentFilters } from '../utils/content-metrics';

      const filters = document.querySelectorAll('[data-filter]');
      const typeFilter = document.querySelector('[data-type-filter]');
      const searchInput = document.querySelector('[data-search]');
      const rows = [...document.querySelectorAll('[data-row]')];
      const empty = document.querySelector('[data-empty]');
      let activeStatus = 'all';
      const applyFilters = () => {
        const activeType = typeFilter instanceof HTMLSelectElement ? typeFilter.value : 'all';
        const query =
          searchInput instanceof HTMLInputElement
            ? searchInput.value.trim().toLocaleLowerCase('zh-CN')
            : '';
        let visible = 0;
        for (const row of rows) {
          if (!(row instanceof HTMLElement)) continue;
          const show = matchesContentFilters(
            {
              status: row.dataset.status,
              type: row.dataset.type,
              health: row.dataset.health,
              text: row.textContent ?? '',
            },
            { status: activeStatus, type: activeType, query },
          );
          row.hidden = !show;
          if (show) visible++;
        }
        if (empty instanceof HTMLElement) empty.hidden = visible > 0;
      };
      filters.forEach((filter) =>
        filter.addEventListener('click', () => {
          if (!(filter instanceof HTMLElement)) return;
          activeStatus = filter.dataset.filter ?? 'all';
          filters.forEach((item) => item.setAttribute('aria-pressed', String(item === filter)));
          applyFilters();
        }),
      );
      typeFilter?.addEventListener('change', applyFilters);
      searchInput?.addEventListener('input', applyFilters);

      const deployment = document.querySelector('[data-deployed-sha]');
      const deployedSha =
        deployment instanceof HTMLElement ? deployment.dataset.deployedSha : 'local';
      if (deployedSha && deployedSha !== 'local') {
        fetch('https://api.github.com/repos/GM2020JLU/GM-WEB/commits/main', {
          headers: { Accept: 'application/vnd.github+json' },
        })
          .then((response) =>
            response.ok ? response.json() : Promise.reject(new Error(String(response.status))),
          )
          .then((result) => {
            const current = result.sha === deployedSha;
            const label = document.querySelector('[data-deploy-label]');
            const detail = document.querySelector('[data-deploy-detail]');
            if (label) label.textContent = current ? '最新版本已上线' : '新版本等待部署';
            if (detail)
              detail.textContent = current
                ? `线上提交 ${deployedSha.slice(0, 7)}`
                : `线上 ${deployedSha.slice(0, 7)} · 仓库 ${String(result.sha).slice(0, 7)}`;
            deployment?.classList.add(current ? 'is-current' : 'is-pending');
          })
          .catch(() => {
            const label = document.querySelector('[data-deploy-label]');
            if (label) label.textContent = '暂时无法确认部署状态';
          });
      }
    </script>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }
  :global(body) {
    margin: 0;
    background: var(--paper-bg);
    color: var(--paper-ink);
    font-family: var(--font-ui);
  }
  .shell {
    width: min(1180px, calc(100% - 32px));
    margin: 0 auto;
    padding: 24px 0 96px;
  }
  .topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 72px;
    padding-bottom: 18px;
    border-bottom: 1px solid var(--paper-line);
  }
  .topbar > div,
  .brand {
    display: flex;
    align-items: center;
    gap: 18px;
  }
  .brand {
    gap: 10px;
    padding: 0;
    border: 0;
  }
  .brand > span {
    display: grid;
    width: 34px;
    height: 34px;
    place-items: center;
    border-radius: 10px;
    background: var(--paper-ink);
    color: var(--paper-bg);
    font: 700 0.72rem/1 var(--font-meta);
  }
  .topbar > div a {
    padding: 6px 2px;
    border: 0;
    color: var(--paper-ink-soft);
    font-size: 0.83rem;
  }
  .hero,
  .section-heading,
  .deployment {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }
  .hero h1 {
    margin: 4px 0 10px;
    font: 400 clamp(2.6rem, 7vw, 5.2rem)/1 var(--font-page-heading);
  }
  .hero p {
    max-width: 56ch;
    color: var(--paper-ink-soft);
    line-height: 1.7;
  }
  .notice {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 14px;
    align-items: center;
    margin-top: 42px;
    padding: 17px 18px;
    border: 1px solid color-mix(in srgb, var(--paper-accent) 35%, var(--paper-line));
    border-radius: 13px;
    background: color-mix(in srgb, var(--paper-bg) 90%, var(--paper-accent) 10%);
  }
  .notice-icon {
    display: grid;
    width: 34px;
    height: 34px;
    place-items: center;
    border-radius: 50%;
    background: var(--paper-accent);
    color: white;
    font-weight: 800;
  }
  .notice p,
  .notice strong {
    margin: 0;
  }
  .notice p {
    margin-top: 3px;
    color: var(--paper-ink-soft);
    font-size: 0.83rem;
  }
  .notice > a {
    padding: 7px 10px;
    font-size: 0.8rem;
  }
  .eyebrow {
    margin: 0;
    color: var(--paper-accent);
    font: 700 0.7rem/1.4 var(--font-meta);
    letter-spacing: 0.14em;
  }
  .actions,
  .row-actions {
    display: flex;
    gap: 9px;
  }
  a,
  button,
  select {
    border: 1px solid var(--paper-line-strong);
    border-radius: 9px;
    background: var(--paper-bg);
    color: inherit;
    font: inherit;
  }
  a,
  button {
    padding: 10px 13px;
    text-decoration: none;
    cursor: pointer;
  }
  .primary,
  .edit {
    border-color: var(--paper-accent);
    background: var(--paper-accent);
    color: white;
  }
  a:focus-visible,
  button:focus-visible,
  input:focus-visible,
  select:focus-visible {
    outline: 3px solid color-mix(in srgb, var(--paper-accent) 38%, transparent);
    outline-offset: 2px;
  }
  .create-section {
    margin-top: 64px;
  }
  .section-heading > p {
    max-width: 34ch;
    margin: 0;
    color: var(--paper-ink-soft);
    font-size: 0.84rem;
    line-height: 1.6;
    text-align: right;
  }
  .quick-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
    gap: 12px;
    margin-top: 20px;
  }
  .quick-card {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 12px;
    align-items: center;
    padding: 18px;
    border-color: var(--paper-line);
    background: color-mix(in srgb, var(--paper-bg) 96%, var(--paper-accent) 4%);
    transition:
      border-color 160ms ease,
      transform 160ms ease,
      box-shadow 160ms ease;
  }
  .quick-card:hover {
    border-color: var(--paper-accent);
    box-shadow: 0 10px 28px rgba(31, 57, 38, 0.08);
    transform: translateY(-2px);
  }
  .quick-card > span {
    display: grid;
    width: 36px;
    height: 36px;
    place-items: center;
    border-radius: 10px;
    background: color-mix(in srgb, var(--paper-accent) 13%, var(--paper-bg));
    color: var(--paper-accent);
    font-family: var(--font-page-heading);
  }
  .quick-card div {
    display: grid;
    gap: 3px;
  }
  .quick-card small {
    color: var(--paper-ink-faint);
    font-size: 0.72rem;
    line-height: 1.45;
  }
  .quick-card b {
    color: var(--paper-accent);
    font-weight: 500;
  }
  .workflow {
    display: grid;
    grid-template-columns: minmax(220px, 0.8fr) 2fr;
    gap: 42px;
    align-items: center;
    margin-top: 34px;
    padding: 30px;
    border: 1px solid var(--paper-line);
    border-radius: 16px;
  }
  .workflow ol {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .workflow li {
    position: relative;
    display: flex;
    gap: 10px;
    align-items: center;
  }
  .workflow li:not(:last-child)::after {
    position: absolute;
    top: 17px;
    right: 12px;
    left: 44px;
    z-index: 0;
    height: 1px;
    background: var(--paper-line-strong);
    content: '';
  }
  .workflow li > span {
    z-index: 1;
    display: grid;
    flex: 0 0 auto;
    width: 34px;
    height: 34px;
    place-items: center;
    border: 1px solid var(--paper-line-strong);
    border-radius: 50%;
    background: var(--paper-bg);
    color: var(--paper-accent);
    font-weight: 700;
  }
  .workflow li div {
    z-index: 1;
    display: grid;
    gap: 3px;
    padding-right: 10px;
    background: var(--paper-bg);
  }
  .workflow small {
    color: var(--paper-ink-faint);
    font-size: 0.7rem;
    line-height: 1.4;
  }
  .summary {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 12px;
    margin: 34px 0 18px;
  }
  .summary button {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    padding: 20px;
    text-align: left;
  }
  .summary strong {
    font: 400 2rem/1 var(--font-page-heading);
  }
  .summary span {
    color: var(--paper-ink-soft);
  }
  .summary button[aria-pressed='true'] {
    border-color: var(--paper-accent);
    box-shadow: inset 0 -3px var(--paper-accent);
  }
  .deployment {
    padding: 18px 20px;
    border: 1px solid var(--paper-line);
    border-radius: 12px;
    background: color-mix(in srgb, var(--paper-bg) 90%, var(--paper-accent) 10%);
  }
  .deployment div {
    display: flex;
    gap: 10px;
    align-items: center;
  }
  .deployment p {
    margin: 0;
    color: var(--paper-ink-faint);
    font: 0.78rem/1.5 var(--font-meta);
  }
  .deploy-dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #8a938c;
    box-shadow: 0 0 0 4px color-mix(in srgb, #8a938c 18%, transparent);
  }
  .is-current .deploy-dot {
    background: #2f9950;
  }
  .is-pending .deploy-dot {
    background: #c4941c;
  }
  .content-section {
    margin-top: 58px;
  }
  h2 {
    margin: 4px 0 0;
    font: 400 2rem/1.2 var(--font-page-heading);
  }
  .section-heading label {
    color: var(--paper-ink-soft);
    font-size: 0.85rem;
  }
