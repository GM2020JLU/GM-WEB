---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import StudioNavigation from '../../components/studio/StudioNavigation.astro';
import StudioPageHeader from '../../components/studio/StudioPageHeader.astro';
import { getThemePalette } from '../../data/site';
import { hasContentFiles } from '../../utils/content-source';
import { getStudioAnalytics } from '../../utils/studio-analytics';

const [blog, projects, vibe, media, about] = await Promise.all([
  getCollection('blog'),
  getCollection('projects'),
  getCollection('vibe'),
  hasContentFiles('media') ? getCollection('media') : Promise.resolve([]),
  getCollection('about'),
]);
const analytics = getStudioAnalytics([
  ...blog.map((entry) => ({
    collection: 'blog',
    id: entry.id,
    data: entry.data,
    body: entry.body,
  })),
  ...projects.map((entry) => ({
    collection: 'projects',
    id: entry.id,
    data: entry.data,
    body: entry.body,
  })),
  ...vibe.map((entry) => ({
    collection: 'vibe',
    id: entry.id,
    data: entry.data,
    body: entry.body,
  })),
  ...media.map((entry) => ({
    collection: 'media',
    id: entry.id,
    data: entry.data,
    body: entry.body,
  })),
  ...about.map((entry) => ({
    collection: 'about',
    id: entry.id,
    data: entry.data,
    body: entry.body,
  })),
]);
const palette = await getThemePalette();
const formatNumber = (value: number) => new Intl.NumberFormat('zh-CN').format(value);
---

<!doctype html>
<html lang="zh-CN" data-palette={palette}>
  <head
    ><BaseHead title="数据概览" description="查看内容状态和创作规模" /><meta
      name="robots"
      content="noindex,nofollow,noarchive"
    /></head
  >
  <body class="studio-with-navigation">
    <StudioNavigation />
    <main class="shell">
      <StudioPageHeader
        eyebrow="CONTENT / INSIGHTS"
        title="数据概览"
        description="只统计内容仓库，不采集访客身份或行为。"
      >
        <a slot="actions" class="back" href="/studio">返回总览</a>
      </StudioPageHeader>

      <section class="metrics" aria-label="内容汇总">
        <article>
          <small>全部内容</small><strong>{formatNumber(analytics.total)}</strong><span
            >跨所有模块</span
          >
        </article>
        <a class="metric" href="/studio?status=published">
          <small>已发布</small><strong>{formatNumber(analytics.published)}</strong><span
            >线上可见</span
          >
        </a>
        <article>
          <small>待处理</small><strong>{formatNumber(analytics.ready + analytics.draft)}</strong
          ><span>草稿 + 待发布</span>
        </article>
        <a
          class:list={['metric', analytics.issues > 0 && 'attention']}
          href="/studio?status=issues"
        >
          <small>需完善</small><strong>{formatNumber(analytics.issues)}</strong><span
            >发布前建议修复</span
          >
        </a>
        <article>
          <small>正文词数</small><strong>{formatNumber(analytics.words)}</strong><span
            >中英文粗略统计</span
          >
        </article>
      </section>

      <section class="panel">
        <div class="section-heading">
          <div><h2>模块健康度</h2><p>快速定位空内容、缺少摘要或待完善字段。</p></div><a
            href="/studio">管理内容 →</a
          >
        </div>
        <div class="module-table">
          <table>
            <caption class="sr-only">各内容模块的总数、发布状态、待完善项目和正文词数</caption>
            <thead>
              <tr>
                <th scope="col">模块</th><th scope="col">总数</th><th scope="col">已发布</th><th
                  scope="col">草稿</th
                ><th scope="col">需完善</th><th scope="col">正文词数</th>
              </tr>
            </thead>
            <tbody>
              {
                analytics.modules.map((module) => (
                  <tr>
                    <th scope="row">{module.label}</th>
                    <td>{module.total}</td>
                    <td>{module.published}</td>
                    <td>{module.draft + module.ready}</td>
                    <td class:list={module.issues > 0 ? ['warning'] : []}>{module.issues}</td>
                    <td>{formatNumber(module.words)}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </section>

      <section class="notes">
        <article>
          <strong>下一步建议</strong><p>
            先处理“需完善”的内容，再把待发布内容提交部署。后台会在保存后显示部署阶段与线上链接。
          </p>
        </article>
        <article>
          <strong>隐私说明</strong><p>
            该页面基于仓库内容静态计算，没有第三方统计脚本，也不会记录访客 IP、账号或阅读轨迹。
          </p>
        </article>
      </section>
    </main>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }
  :global(body) {
    margin: 0;
    background: var(--paper-bg);
    color: var(--paper-ink);
    font-family: var(--font-ui);
  }
  .shell {
    width: min(1080px, calc(100% - 32px));
    margin: auto;
    padding: 42px 0 90px;
  }
  .page-header,
  .section-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 24px;
  }
  .page-header {
    padding-bottom: 38px;
    border-bottom: 1px solid var(--paper-line);
  }
  .page-header p {
    margin: 0;
    color: var(--studio-accent-strong);
    font: 700 0.7rem var(--font-meta);
    letter-spacing: 0.14em;
  }
  h1 {
    margin: 8px 0 12px;
    font: 400 clamp(2.5rem, 7vw, 5rem)/1 var(--font-page-heading);
  }
  .page-header span,
  .section-heading p,
  .metrics span,
  .notes p {
    color: var(--paper-ink-soft);
  }
  .back,
  .section-heading a {
    color: var(--studio-accent-strong);
    font-size: 0.82rem;
    text-decoration: none;
  }
  .metrics {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 12px;
    margin: 26px 0;
  }
  .metrics article,
  .metrics .metric,
  .panel,
  .notes article {
    border: 1px solid var(--paper-line);
    border-radius: 14px;
    background: color-mix(in srgb, var(--paper-bg) 96%, var(--paper-accent) 4%);
  }
  .metrics article,
  .metrics .metric {
    display: grid;
    gap: 6px;
    padding: 18px;
    color: inherit;
    text-decoration: none;
  }
  .metrics small {
    color: var(--studio-text-meta);
  }
  .metrics strong {
    font: 400 2.2rem/1 var(--font-page-heading);
  }
  .metrics span {
    font-size: 0.75rem;
  }
  .metrics .attention {
    border-color: color-mix(in srgb, #c58c2c 55%, var(--paper-line));
  }
  .panel {
    padding: 24px;
  }
  .section-heading h2 {
    margin: 0;
    font: 550 1.22rem/1.25 var(--studio-font-heading);
    letter-spacing: -0.02em;
  }
  .section-heading p {
    margin: 6px 0 0;
    font: 400 0.8rem/1.6 var(--studio-font-ui);
    letter-spacing: 0;
  }
  .module-table {
    margin-top: 22px;
    overflow-x: auto;
  }
  .module-table table {
    width: 100%;
    min-width: 620px;
    border-collapse: collapse;
    font-size: 0.82rem;
  }
  .module-table :is(th, td) {
    padding: 13px 8px;
    border-top: 1px solid var(--paper-line);
  }
  .module-table thead th {
    color: var(--studio-text-meta);
    font-size: 0.72rem;
    font-weight: 500;
  }
  .module-table :is(th, td):not(:first-child) {
    text-align: right;
  }
  .module-table tbody th {
    text-align: left;
  }
  .warning {
    color: #b57917;
    font-weight: 700;
  }
  .notes {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
    margin-top: 12px;
  }
  .notes article {
    padding: 18px;
  }
  .notes p {
    margin: 8px 0 0;
    font-size: 0.82rem;
    line-height: 1.7;
  }
  @media (max-width: 780px) {
    .metrics {
      grid-template-columns: repeat(2, 1fr);
    }
    .metrics article:last-child {
      grid-column: span 2;
    }
    .notes {
      grid-template-columns: 1fr;
    }
    .page-header {
      align-items: start;
      flex-direction: column;
    }
  }
</style>
