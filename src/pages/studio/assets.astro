---
import BaseHead from '../../components/BaseHead.astro';
import StudioNavigation from '../../components/studio/StudioNavigation.astro';
import StudioPageHeader from '../../components/studio/StudioPageHeader.astro';
import { getThemePalette } from '../../data/site';
const palette = await getThemePalette();
---

<!doctype html>
<html lang="zh-CN" data-palette={palette}>
  <head
    ><BaseHead title="素材库" description="上传和复用内容图片" /><meta
      name="robots"
      content="noindex,nofollow,noarchive"
    /></head
  >
  <body class="studio-with-navigation">
    <StudioNavigation />
    <main class="shell">
      <StudioPageHeader
        eyebrow="MEDIA / LIBRARY"
        title="素材库"
        description="统一管理文章图片；上传前校验真实图片格式和大小。"
      >
        <label slot="actions" class="upload" data-upload
          ><input
            type="file"
            accept="image/jpeg,image/png,image/webp,image/gif,image/avif"
            data-file
          /><strong>上传图片</strong><small>JPG / PNG / WebP / GIF / AVIF，最大 5 MB</small></label
        >
      </StudioPageHeader>
      <div class="notice" data-notice role="status">
        <strong>正在加载素材</strong><small>请稍候…</small>
      </div>
      <section>
        <div class="section-title">
          <h2>全部素材</h2><input
            type="search"
            placeholder="搜索文件名"
            aria-label="搜索素材文件名"
            data-search
          />
        </div><div class="asset-grid" data-assets></div><p data-empty hidden>
          还没有素材，可以上传第一张图片。
        </p>
      </section>
    </main>
    <script>
      import { setupStudioAssets } from '../../utils/studio-assets-client';

      setupStudioAssets(document);
    </script>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }
  :global(body) {
    margin: 0;
    background: var(--paper-bg);
    color: var(--paper-ink);
    font-family: var(--font-ui);
  }
  .shell {
    width: min(1180px, calc(100% - 32px));
    margin: auto;
    padding: 22px 0 90px;
  }
  .topbar,
  .hero,
  .section-title {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }
  .topbar {
    padding-bottom: 17px;
    border-bottom: 1px solid var(--paper-line);
  }
  .topbar > div,
  .brand {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .brand,
  .topbar a {
    color: inherit;
    text-decoration: none;
  }
  .brand span {
    display: grid;
    width: 34px;
    height: 34px;
    place-items: center;
    border-radius: 10px;
    background: var(--paper-ink);
    color: var(--paper-bg);
    font-size: 0.72rem;
  }
  .topbar > div a {
    padding: 7px;
    color: var(--paper-ink-soft);
    font-size: 0.82rem;
  }
  .hero {
    padding: 58px 0 34px;
  }
  .hero p {
    margin: 0;
    color: var(--studio-accent-strong);
    font: 700 0.7rem var(--font-meta);
    letter-spacing: 0.14em;
  }
  .hero h1 {
    margin: 7px 0 10px;
    font: 400 clamp(2.6rem, 7vw, 5rem)/1 var(--font-page-heading);
  }
  .hero span {
    color: var(--paper-ink-soft);
  }
  .upload {
    display: grid;
    gap: 4px;
    padding: 20px 28px;
    border: 1px dashed var(--paper-accent);
    border-radius: 14px;
    background: color-mix(in srgb, var(--paper-bg) 92%, var(--paper-accent) 8%);
    cursor: pointer;
  }
  .upload input {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
  }
  .upload:has(input:focus-visible) {
    outline: 3px solid var(--studio-focus-ring);
    outline-offset: 3px;
  }
  .upload small {
    color: var(--studio-text-meta);
  }
  .notice {
    display: flex;
    gap: 12px;
    margin-bottom: 42px;
    padding: 14px 16px;
    border: 1px solid var(--paper-line);
    border-radius: 11px;
  }
  .notice small {
    color: var(--paper-ink-soft);
  }
  .notice.success {
    border-color: color-mix(in srgb, var(--paper-accent) 45%, var(--paper-line) 55%);
  }
  .notice.error {
    border-color: color-mix(in srgb, #cb6464 48%, var(--paper-line) 52%);
  }
  .section-title h2 {
    font: 550 1.22rem/1.25 var(--studio-font-heading);
    letter-spacing: -0.02em;
  }
  .section-title input {
    width: 260px;
    padding: 10px 12px;
    border: 1px solid var(--paper-line-strong);
    border-radius: 9px;
    background: var(--paper-bg);
  }
  .asset-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(210px, 1fr));
    gap: 14px;
  }
  .asset-grid article {
    display: grid;
    gap: 10px;
    padding: 12px;
    border: 1px solid var(--paper-line);
    border-radius: 14px;
    overflow: hidden;
  }
  .asset-grid img {
    width: 100%;
    aspect-ratio: 4/3;
    object-fit: cover;
    border-radius: 9px;
    background: var(--paper-line);
  }
  .asset-grid code {
    overflow: hidden;
    color: var(--studio-text-meta);
    font-size: 0.7rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .asset-grid article > div {
    display: flex;
    gap: 7px;
  }
  .asset-grid article > small {
    color: var(--paper-ink-soft);
    font-size: 0.72rem;
  }
  .asset-grid article[aria-busy='true'],
  .upload[aria-busy='true'] {
    opacity: 0.68;
  }
  .asset-grid button {
    flex: 1;
    padding: 8px;
    border: 1px solid var(--paper-line-strong);
    border-radius: 8px;
    background: var(--paper-bg);
    cursor: pointer;
  }
  .asset-grid .danger {
    color: color-mix(in srgb, var(--studio-danger) 78%, var(--paper-ink) 22%);
  }
  @media (max-width: 640px) {
    .hero {
      align-items: flex-start;
      flex-direction: column;
    }
    .upload {
      width: 100%;
    }
    .section-title input {
      width: 160px;
    }
  }
</style>
