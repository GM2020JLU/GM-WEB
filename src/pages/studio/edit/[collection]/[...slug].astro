---
import BaseHead from '../../../../components/BaseHead.astro';
import { isStudioCollection, isTaxonomyCollection } from '../../../../utils/studio-content';

export const prerender = false;

const collection = Astro.params.collection ?? '';
const slug = Astro.params.slug ?? 'new';
if (!isStudioCollection(collection)) return Astro.redirect('/studio');
const isNew = Astro.url.searchParams.get('new') === '1' || slug === 'new';
const labels = {
  blog: '博客 · 长文',
  projects: '项目案例',
  vibe: '随记 · 短内容',
  media: '书影音记录',
  about: '关于我',
  categories: '分类',
  series: '系列',
  tags: '标签',
};
const taxonomy = isTaxonomyCollection(collection);
---

<!doctype html>
<html lang="zh-CN" data-palette="green-soft">
  <head>
    <BaseHead
      title={`${isNew ? '新建' : '编辑'}${labels[collection]}`}
      description="Studio 内容编辑器"
    />
    <meta name="robots" content="noindex,nofollow,noarchive" />
  </head>
  <body>
    <main
      class="shell"
      data-editor-root
      data-collection={collection}
      data-slug={slug}
      data-is-new={String(isNew)}
    >
      <nav class="topbar">
        <a class="brand" href="/studio"><span>GM</span><strong>创作中心</strong></a>
        <div>
          <a href="/studio">内容</a><a href="/studio/import">导入</a><a href="/studio/assets"
            >素材</a
          ><a href="/studio/organize">分类</a>
        </div>
      </nav>

      <header class="editor-header">
        <div>
          <p class="eyebrow">STUDIO EDITOR · {labels[collection]}</p><h1>
            {isNew ? '新建内容' : '编辑内容'}
          </h1>
        </div>
        <div class="header-actions">
          <button type="button" data-history>版本历史</button>
          {
            !taxonomy && (
              <a
                href={collection === 'about' ? '/preview/about' : `/preview/${collection}/${slug}`}
                target="_blank"
              >
                页面预览
              </a>
            )
          }
          {
            collection !== 'about' && !isNew && (
              <button type="button" class="danger" data-delete>
                删除
              </button>
            )
          }
        </div>
      </header>

      <div class="notice" data-notice role="status" aria-live="polite">
        <strong>正在初始化</strong><small>请稍候…</small>
      </div>

      <form data-editor-form>
        <aside class="meta-panel">
          <h2>内容信息</h2>
          <label><span>标题</span><input required maxlength="120" data-title /></label>
          <label
            ><span>{taxonomy ? '标识' : '网址别名'}</span><input
              required
              data-slug
              pattern={taxonomy ? undefined : '[a-z0-9]+(?:-[a-z0-9]+)*'}
            /></label
          >
          <label data-for="blog,projects,about"
            ><span>摘要</span><textarea rows="4" maxlength="320" data-description></textarea></label
          >
          <label data-for="blog,projects,vibe,about"
            ><span>日期</span><input type="datetime-local" data-date /></label
          >
          <label data-for="blog,projects,vibe,media,about"
            ><span>发布状态</span><select data-publication-status
              ><option value="draft">草稿</option><option value="ready">待发布</option><option
                value="published">已发布</option
              ></select
            ></label
          >
          <label data-for="blog,projects,vibe,media,about"
            ><span>定时发布时间</span><input type="datetime-local" data-scheduled-at /><small
              >设置后点击“定时发布”</small
            ></label
          >
          <label data-for="media"><span>创作者</span><input data-creator /></label>
          <label data-for="vibe,media"
            ><span>内容类型</span><select data-content-type
              ><option value="text">文字</option><option value="photo">图片</option><option
                value="quote">引语</option
              ><option value="code">代码</option><option value="mixed">混合</option><option
                value="book">书籍</option
              ><option value="film">电影</option><option value="series">剧集</option><option
                value="album">专辑</option
              ><option value="podcast">播客</option></select
            ></label
          >
          <label data-for="media"
            ><span>阅读/观看进度</span><select data-progress
              ><option value="planned">计划中</option><option value="in-progress">进行中</option
              ><option value="completed">已完成</option><option value="abandoned">已放弃</option
              ></select
            ></label
          >
          <label data-for="blog,projects,vibe,media,about"
            ><span>标签</span><input data-tags placeholder="用逗号分隔" /></label
          >
          <label data-for="blog,projects,about"
            ><span>分类</span><input data-categories placeholder="用逗号分隔" /></label
          >
          <label data-for="blog,projects,about"
            ><span>系列</span><input data-series placeholder="用逗号分隔" /></label
          >
          <details>
            <summary>高级字段</summary><p>
              JSON 格式，用于项目成果、图片、侧边栏等扩展信息。
            </p><textarea rows="12" data-extras spellcheck="false">{}</textarea>
          </details>
        </aside>

        <section class="body-panel" data-body-panel data-view="split">
          <header>
            <div><h2>正文</h2><small data-word-count>0 字符</small></div><div class="view-switch">
              <button type="button" data-view="edit">编辑</button><button
                type="button"
                data-view="split"
                aria-pressed="true">分栏</button
              ><button type="button" data-view="preview">预览</button>
            </div>
          </header>
          <div class="editor-grid">
            <textarea data-body spellcheck="true" aria-label="Markdown 正文" placeholder="开始写作…"
            ></textarea><article class="markdown-preview" data-preview></article>
          </div>
        </section>

        <footer class="publish-bar">
          <div>
            <strong>发布操作</strong><small>保存后会创建 Git 版本；发布会触发 Vercel 部署。</small>
          </div>
          <div>
            <button type="button" data-action="draft">保存草稿</button>
            <button type="button" data-action="ready">设为待发布</button>
            <button type="button" data-action="unpublish">撤回发布</button>
            <button type="button" data-action="schedule">定时发布</button>
            <button type="button" class="primary" data-action="publish">发布</button>
          </div>
        </footer>
      </form>
    </main>

    <dialog data-history-dialog>
      <header>
        <div><p class="eyebrow">VERSION HISTORY</p><h2>版本历史</h2></div><form method="dialog">
          <button>关闭</button>
        </form>
      </header><div class="history-list" data-history-list></div>
    </dialog>

    <script>
      import { setupStudioEditor } from '../../../../utils/studio-editor-client';
      const root = document.querySelector('[data-editor-root]');
      if (root instanceof HTMLElement)
        setupStudioEditor(document, {
          collection: root.dataset.collection ?? '',
          initialSlug: root.dataset.slug ?? 'new',
          isNew: root.dataset.isNew === 'true',
        });
    </script>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }
  :global(body) {
    margin: 0;
    background: var(--paper-bg);
    color: var(--paper-ink);
    font-family: var(--font-ui);
  }
  .shell {
    width: min(1480px, calc(100% - 32px));
    margin: auto;
    padding: 22px 0 110px;
  }
  .topbar,
  .editor-header,
  .publish-bar,
  .body-panel > header,
  dialog > header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }
  .topbar {
    padding-bottom: 17px;
    border-bottom: 1px solid var(--paper-line);
  }
  .topbar > div,
  .brand,
  .header-actions,
  .publish-bar > div:last-child,
  .view-switch {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .brand span {
    display: grid;
    width: 34px;
    height: 34px;
    place-items: center;
    border-radius: 10px;
    background: var(--paper-ink);
    color: white;
    font-size: 0.72rem;
  }
  .topbar a,
  .header-actions a,
  a {
    color: inherit;
    text-decoration: none;
  }
  .topbar > div a {
    padding: 7px 9px;
    color: var(--paper-ink-soft);
    font-size: 0.82rem;
  }
  .editor-header {
    padding: 42px 0 24px;
  }
  .editor-header h1 {
    margin: 4px 0 0;
    font: 400 clamp(2rem, 4vw, 3.5rem)/1 var(--font-page-heading);
  }
  .eyebrow {
    margin: 0;
    color: var(--paper-accent);
    font: 700 0.68rem/1.4 var(--font-meta);
    letter-spacing: 0.14em;
  }
  .notice {
    display: flex;
    gap: 12px;
    align-items: baseline;
    margin-bottom: 16px;
    padding: 13px 16px;
    border: 1px solid var(--paper-line);
    border-radius: 11px;
    background: color-mix(in srgb, var(--paper-bg) 94%, var(--paper-accent) 6%);
  }
  .notice small {
    color: var(--paper-ink-soft);
  }
  .notice.success {
    border-color: #8abf97;
  }
  .notice.error {
    border-color: #d28d8d;
    background: #fff6f6;
  }
  .notice a {
    margin-left: auto;
  }
  form[data-editor-form] {
    display: grid;
    grid-template-columns: 300px minmax(0, 1fr);
    gap: 16px;
  }
  .meta-panel,
  .body-panel {
    border: 1px solid var(--paper-line);
    border-radius: 16px;
    background: color-mix(in srgb, var(--paper-bg) 98%, white 2%);
  }
  .meta-panel {
    padding: 22px;
  }
  .meta-panel h2,
  .body-panel h2,
  dialog h2 {
    margin: 0;
    font: 400 1.45rem/1.2 var(--font-page-heading);
  }
  label {
    display: grid;
    gap: 6px;
    margin-top: 17px;
    color: var(--paper-ink-soft);
    font-size: 0.8rem;
  }
  input,
  textarea,
  select,
  button,
  .header-actions a {
    border: 1px solid var(--paper-line-strong);
    border-radius: 9px;
    background: var(--paper-bg);
    color: inherit;
    font: inherit;
  }
  input,
  select,
  textarea {
    width: 100%;
    padding: 10px 11px;
  }
  textarea {
    resize: vertical;
  }
  details {
    margin-top: 20px;
    border-top: 1px solid var(--paper-line);
    padding-top: 15px;
  }
  details summary {
    cursor: pointer;
    font-weight: 700;
  }
  details p {
    color: var(--paper-ink-faint);
    font-size: 0.75rem;
    line-height: 1.5;
  }
  .body-panel {
    min-width: 0;
    overflow: hidden;
  }
  .body-panel > header {
    padding: 16px 18px;
    border-bottom: 1px solid var(--paper-line);
  }
  .body-panel > header > div:first-child {
    display: flex;
    gap: 10px;
    align-items: baseline;
  }
  .body-panel small {
    color: var(--paper-ink-faint);
  }
  button,
  .header-actions a {
    padding: 9px 12px;
    cursor: pointer;
  }
  .view-switch button[aria-pressed='true'],
  .primary {
    border-color: var(--paper-accent);
    background: var(--paper-accent);
    color: white;
  }
  .danger {
    color: #a43d3d;
  }
  .editor-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: 720px;
  }
  .editor-grid > textarea {
    min-height: 720px;
    padding: 24px;
    border: 0;
    border-radius: 0;
    border-right: 1px solid var(--paper-line);
    font: 14px/1.75 var(--font-code);
    resize: none;
    outline: none;
  }
  .markdown-preview {
    min-width: 0;
    overflow: auto;
    padding: 28px;
    line-height: 1.8;
  }
  .body-panel[data-view='edit'] .editor-grid {
    grid-template-columns: 1fr;
  }
  .body-panel[data-view='edit'] .markdown-preview {
    display: none;
  }
  .body-panel[data-view='preview'] .editor-grid {
    grid-template-columns: 1fr;
  }
  .body-panel[data-view='preview'] textarea {
    display: none;
  }
  .publish-bar {
    position: fixed;
    right: 0;
    bottom: 0;
    left: 0;
    z-index: 5;
    padding: 14px max(20px, calc((100vw - 1480px) / 2));
    border-top: 1px solid var(--paper-line);
    background: color-mix(in srgb, var(--paper-bg) 90%, transparent);
    backdrop-filter: blur(16px);
  }
  .publish-bar > div:first-child {
    display: grid;
    gap: 3px;
  }
  .publish-bar small {
    color: var(--paper-ink-faint);
  }
  dialog {
    width: min(720px, calc(100% - 32px));
    max-height: 80vh;
    padding: 24px;
    border: 1px solid var(--paper-line);
    border-radius: 18px;
    background: var(--paper-bg);
    color: var(--paper-ink);
  }
  dialog::backdrop {
    background: #17251db0;
  }
  .history-list {
    display: grid;
    gap: 10px;
    margin-top: 20px;
  }
  .history-list article {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 5px 14px;
    padding: 14px;
    border: 1px solid var(--paper-line);
    border-radius: 10px;
  }
  .history-list small {
    color: var(--paper-ink-soft);
  }
  .history-list button {
    grid-row: 1/3;
    grid-column: 2;
  }
  @media (max-width: 900px) {
    form[data-editor-form] {
      grid-template-columns: 1fr;
    }
    .meta-panel {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0 14px;
    }
    .meta-panel h2,
    .meta-panel details {
      grid-column: 1/-1;
    }
    .editor-grid {
      grid-template-columns: 1fr;
    }
    .editor-grid > textarea {
      min-height: 480px;
      border-right: 0;
      border-bottom: 1px solid var(--paper-line);
    }
    .publish-bar {
      align-items: flex-start;
    }
    .publish-bar > div:first-child {
      display: none;
    }
    .publish-bar > div:last-child {
      flex-wrap: wrap;
      justify-content: flex-end;
    }
  }
  @media (max-width: 620px) {
    .shell {
      width: min(100% - 20px, 1480px);
    }
    .topbar > div a:nth-child(3),
    .topbar > div a:nth-child(4) {
      display: none;
    }
    .editor-header {
      align-items: flex-start;
    }
    .header-actions {
      flex-wrap: wrap;
      justify-content: flex-end;
    }
    .meta-panel {
      display: block;
    }
    .body-panel[data-view='split'] .editor-grid {
      display: block;
    }
    .body-panel[data-view='split'] .editor-grid > textarea {
      min-height: 420px;
    }
    .publish-bar {
      overflow-x: auto;
    }
    .publish-bar > div:last-child {
      flex-wrap: nowrap;
    }
    .publish-bar button {
      white-space: nowrap;
    }
  }
</style>
