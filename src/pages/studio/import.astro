---
import BaseHead from '../../components/BaseHead.astro';
---

<!doctype html>
<html lang="zh-CN" data-palette="green-soft">
  <head>
    <BaseHead title="导入 Markdown" description="解析、检查并将 Markdown 安全导入为草稿" />
    <meta name="robots" content="noindex,nofollow,noarchive" />
  </head>
  <body>
    <main class="shell">
      <nav class="topbar" aria-label="后台导航">
        <a class="brand" href="/studio"
          ><span aria-hidden="true">GM</span><strong>创作中心</strong></a
        >
        <div><a href="/studio">返回工作台</a><a href="/studio/assets">素材库</a></div>
      </nav>

      <header class="hero">
        <div>
          <p class="eyebrow">SAFE IMPORT</p>
          <h1>导入 Markdown</h1>
          <p>
            选择文件后先检查字段和正文，确认后才创建草稿。导入不会直接发布，也不会覆盖同名内容。
          </p>
        </div>
        <ol aria-label="导入流程">
          <li class="active"><span>1</span>选文件</li>
          <li><span>2</span>检查</li>
          <li><span>3</span>导入草稿</li>
        </ol>
      </header>

      <form class="import-grid" data-import-form>
        <section class="panel setup" aria-labelledby="setup-title">
          <div class="section-heading">
            <div><p class="eyebrow">SOURCE</p><h2 id="setup-title">文件与字段</h2></div>
            <span class="safe-badge">只创建草稿</span>
          </div>

          <label class="dropzone" data-dropzone>
            <input type="file" accept=".md,text/markdown" data-file />
            <span class="file-icon" aria-hidden="true">MD</span>
            <strong data-file-label>点击选择或拖入 .md 文件</strong>
            <small>单文件，最大 1 MB；支持 YAML frontmatter</small>
          </label>

          <div class="fields">
            <label>
              <span>内容类型</span>
              <select name="collection" data-collection>
                <option value="blog">博客 · 长文</option>
                <option value="vibe">随记 · 短内容</option>
                <option value="media">书影音记录</option>
              </select>
            </label>
            <label>
              <span>标题</span>
              <input
                name="title"
                data-title
                maxlength="120"
                required
                placeholder="会从 frontmatter 或一级标题提取"
              />
            </label>
            <label>
              <span>网址别名</span>
              <input
                name="slug"
                data-slug
                maxlength="64"
                required
                pattern="[a-z0-9]+(?:-[a-z0-9]+)*"
                placeholder="my-article"
                aria-describedby="slug-note"
              />
              <small id="slug-note">只能使用小写英文、数字和中划线；同名时拒绝导入。</small>
            </label>
            <label data-description-field>
              <span>摘要</span>
              <textarea name="description" data-description maxlength="300" rows="3"></textarea>
            </label>
            <label data-creator-field hidden>
              <span>创作者</span>
              <input name="creator" data-creator maxlength="120" placeholder="作者、导演或艺人" />
            </label>
          </div>
        </section>

        <section class="panel preview" aria-labelledby="preview-title">
          <div class="section-heading">
            <div><p class="eyebrow">PREVIEW</p><h2 id="preview-title">导入预览</h2></div>
            <span class="parse-state" data-parse-state>等待文件</span>
          </div>
          <div class="empty-preview" data-empty-preview>
            <span aria-hidden="true">↑</span>
            <p>选择 Markdown 后，这里会显示识别结果、提醒和正文。</p>
          </div>
          <div data-preview-content hidden>
            <dl>
              <div><dt>文件</dt><dd data-preview-file></dd></div>
              <div><dt>状态</dt><dd>草稿（强制）</dd></div>
              <div><dt>正文</dt><dd data-preview-size></dd></div>
            </dl>
            <div class="warnings" data-warnings hidden>
              <strong>导入提醒</strong><ul data-warning-list></ul>
            </div>
            <article>
              <header><strong>渲染效果</strong><small>unified 安全预览</small></header>
              <div class="markdown-preview" data-body-preview></div>
            </article>
          </div>
        </section>

        <footer class="submit-bar">
          <div class="result" data-result role="status" aria-live="polite">
            <strong>尚未导入</strong><small>请先选择文件并检查识别结果。</small>
          </div>
          <button type="submit" class="primary" data-submit disabled>确认导入为草稿</button>
        </footer>
      </form>
    </main>

    <script>
      import { setupMarkdownImport } from '../../utils/markdown-import-client';

      try {
        setupMarkdownImport(document, { isProduction: import.meta.env.PROD });
      } catch (error) {
        const result = document.querySelector('[data-result]');
        if (result instanceof HTMLElement) {
          result.className = 'result error';
          result.textContent =
            error instanceof Error ? error.message : '导入界面初始化失败，请刷新页面。';
        }
      }
    </script>
  </body>
</html>

<style>
  :root {
    --paper-bg: #f7faf7;
    --paper-panel: #fff;
    --paper-ink: #203728;
    --paper-soft: #607065;
    --paper-faint: #819087;
    --paper-line: #dce6de;
    --paper-line-strong: #bdcec1;
    --paper-accent: #34794a;
    --paper-accent-soft: #e7f2e9;
    --paper-warning: #8c611b;
    --paper-warning-bg: #fff8e6;
    font-family: Inter, ui-sans-serif, system-ui, sans-serif;
    color: var(--paper-ink);
    background: var(--paper-bg);
  }
  * {
    box-sizing: border-box;
  }
  body {
    margin: 0;
    background: var(--paper-bg);
  }
  .shell {
    width: min(1180px, calc(100% - 40px));
    margin: 0 auto;
    padding-bottom: 70px;
  }
  .topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 18px 0;
    border-bottom: 1px solid var(--paper-line);
  }
  .topbar > div {
    display: flex;
    gap: 8px;
  }
  a {
    color: inherit;
    text-decoration: none;
  }
  .topbar a {
    padding: 8px 10px;
    border-radius: 9px;
    font-size: 0.84rem;
  }
  .topbar a:hover {
    background: var(--paper-accent-soft);
  }
  .brand {
    display: flex;
    gap: 10px;
    align-items: center;
  }
  .brand span {
    display: grid;
    width: 34px;
    height: 34px;
    place-items: center;
    border-radius: 10px;
    background: var(--paper-ink);
    color: white;
    font-size: 0.7rem;
  }
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 40px;
    align-items: end;
    padding: 64px 0 44px;
  }
  h1,
  h2,
  p {
    margin-top: 0;
  }
  h1 {
    margin-bottom: 14px;
    font:
      500 clamp(2.2rem, 6vw, 4rem)/1.02 Georgia,
      serif;
    letter-spacing: -0.04em;
  }
  h2 {
    margin-bottom: 0;
    font:
      500 1.35rem/1.2 Georgia,
      serif;
  }
  .hero > div > p:last-child {
    max-width: 68ch;
    margin: 0;
    color: var(--paper-soft);
    line-height: 1.8;
  }
  .eyebrow {
    margin: 0 0 7px;
    color: var(--paper-accent);
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.14em;
  }
  .hero ol {
    display: flex;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .hero li {
    display: flex;
    gap: 7px;
    align-items: center;
    color: var(--paper-faint);
    font-size: 0.75rem;
  }
  .hero li:not(:last-child)::after {
    width: 28px;
    height: 1px;
    margin: 0 9px;
    background: var(--paper-line-strong);
    content: '';
  }
  .hero li.active {
    color: var(--paper-accent);
    font-weight: 700;
  }
  .hero li span {
    display: grid;
    width: 25px;
    height: 25px;
    place-items: center;
    border: 1px solid currentColor;
    border-radius: 50%;
  }
  .import-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: 18px;
  }
  .panel {
    min-width: 0;
    padding: 26px;
    border: 1px solid var(--paper-line);
    border-radius: 18px;
    background: var(--paper-panel);
    box-shadow: 0 18px 50px rgba(38, 66, 47, 0.05);
  }
  .section-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 22px;
  }
  .safe-badge,
  .parse-state {
    padding: 6px 9px;
    border-radius: 99px;
    background: var(--paper-accent-soft);
    color: var(--paper-accent);
    font-size: 0.72rem;
    font-weight: 700;
  }
  .dropzone {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 7px;
    padding: 30px 20px;
    border: 1px dashed var(--paper-line-strong);
    border-radius: 14px;
    background: #fbfdfb;
    text-align: center;
    cursor: pointer;
  }
  .dropzone:hover,
  .dropzone.is-dragging {
    border-color: var(--paper-accent);
    background: var(--paper-accent-soft);
  }
  .dropzone input {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
  }
  .dropzone small,
  label small {
    color: var(--paper-faint);
    font-size: 0.72rem;
    line-height: 1.5;
  }
  .file-icon {
    display: grid;
    width: 46px;
    height: 52px;
    place-items: center;
    border: 1px solid var(--paper-line-strong);
    border-radius: 9px;
    background: white;
    color: var(--paper-accent);
    font:
      800 0.7rem/1 ui-monospace,
      monospace;
  }
  .fields {
    display: grid;
    gap: 16px;
    margin-top: 22px;
  }
  label {
    display: grid;
    gap: 7px;
    color: var(--paper-soft);
    font-size: 0.8rem;
    font-weight: 650;
  }
  input,
  textarea,
  select {
    width: 100%;
    padding: 11px 12px;
    border: 1px solid var(--paper-line-strong);
    border-radius: 9px;
    background: white;
    color: var(--paper-ink);
    font: inherit;
    resize: vertical;
  }
  input:focus,
  textarea:focus,
  select:focus {
    outline: 3px solid color-mix(in srgb, var(--paper-accent) 22%, transparent);
    border-color: var(--paper-accent);
  }
  [hidden] {
    display: none !important;
  }
  .empty-preview {
    display: grid;
    min-height: 410px;
    place-items: center;
    align-content: center;
    color: var(--paper-faint);
    text-align: center;
  }
  .empty-preview span {
    font-size: 2rem;
  }
  .empty-preview p {
    max-width: 32ch;
    line-height: 1.7;
  }
  dl {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
    margin: 0 0 18px;
  }
  dl div {
    padding: 12px;
    border-radius: 10px;
    background: #f3f7f4;
  }
  dt {
    color: var(--paper-faint);
    font-size: 0.68rem;
  }
  dd {
    overflow: hidden;
    margin: 4px 0 0;
    font-size: 0.78rem;
    font-weight: 700;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .warnings {
    margin-bottom: 16px;
    padding: 14px 16px;
    border: 1px solid #ead8ad;
    border-radius: 11px;
    background: var(--paper-warning-bg);
    color: var(--paper-warning);
    font-size: 0.78rem;
  }
  .warnings ul {
    margin: 7px 0 0;
    padding-left: 18px;
    line-height: 1.6;
  }
  article {
    overflow: hidden;
    border: 1px solid var(--paper-line);
    border-radius: 12px;
  }
  article header {
    display: flex;
    justify-content: space-between;
    padding: 12px 14px;
    border-bottom: 1px solid var(--paper-line);
    background: #f6f9f7;
    font-size: 0.78rem;
  }
  article header small {
    color: var(--paper-faint);
  }
  .markdown-preview {
    overflow: auto;
    max-height: 430px;
    min-height: 300px;
    margin: 0;
    padding: 18px;
    color: #33493a;
    font-size: 0.88rem;
    line-height: 1.8;
  }
  :global(.markdown-preview > :first-child) {
    margin-top: 0;
  }
  :global(.markdown-preview > :last-child) {
    margin-bottom: 0;
  }
  :global(.markdown-preview h1),
  :global(.markdown-preview h2),
  :global(.markdown-preview h3) {
    margin: 1.5em 0 0.65em;
    color: var(--paper-ink);
    font-family: Georgia, serif;
    line-height: 1.3;
  }
  :global(.markdown-preview h1) {
    font-size: 1.65rem;
  }
  :global(.markdown-preview h2) {
    font-size: 1.35rem;
  }
  :global(.markdown-preview h3) {
    font-size: 1.12rem;
  }
  :global(.markdown-preview p),
  :global(.markdown-preview ul),
  :global(.markdown-preview ol),
  :global(.markdown-preview blockquote) {
    margin: 0.85em 0;
  }
  :global(.markdown-preview a) {
    color: var(--paper-accent);
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }
  :global(.markdown-preview blockquote) {
    padding: 0.15em 1em;
    border-left: 3px solid var(--paper-line-strong);
    color: var(--paper-soft);
  }
  :global(.markdown-preview code) {
    padding: 0.12em 0.35em;
    border-radius: 4px;
    background: #edf3ee;
    font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
  }
  :global(.markdown-preview pre) {
    overflow: auto;
    padding: 14px;
    border-radius: 9px;
    background: #edf3ee;
  }
  :global(.markdown-preview pre code) {
    padding: 0;
    background: transparent;
  }
  :global(.markdown-preview img) {
    max-width: 100%;
    height: auto;
    border-radius: 8px;
  }
  :global(.markdown-preview table) {
    width: 100%;
    border-collapse: collapse;
  }
  :global(.markdown-preview th),
  :global(.markdown-preview td) {
    padding: 7px 9px;
    border: 1px solid var(--paper-line);
    text-align: left;
  }
  .submit-bar {
    display: flex;
    grid-column: 1 / -1;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 18px 20px;
    border: 1px solid var(--paper-line);
    border-radius: 14px;
    background: var(--paper-panel);
  }
  .result {
    display: grid;
    gap: 3px;
  }
  .result small {
    color: var(--paper-soft);
  }
  .result.error strong {
    color: #a23c36;
  }
  .result.success strong {
    color: var(--paper-accent);
  }
  .result a {
    width: fit-content;
    margin-top: 5px;
    color: var(--paper-accent);
    font-size: 0.78rem;
    font-weight: 700;
    text-decoration: underline;
  }
  button {
    padding: 12px 17px;
    border: 1px solid var(--paper-accent);
    border-radius: 10px;
    font: inherit;
    font-weight: 700;
    cursor: pointer;
  }
  button.primary {
    background: var(--paper-accent);
    color: white;
  }
  button:disabled {
    cursor: not-allowed;
    opacity: 0.45;
  }
  @media (max-width: 820px) {
    .shell {
      width: min(100% - 24px, 680px);
    }
    .hero,
    .import-grid {
      grid-template-columns: 1fr;
    }
    .hero {
      padding-top: 42px;
    }
    .hero ol {
      flex-wrap: wrap;
    }
    .submit-bar {
      align-items: stretch;
      flex-direction: column;
    }
    dl {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 520px) {
    .topbar {
      align-items: flex-start;
    }
    .topbar > div {
      display: grid;
      text-align: right;
    }
    .panel {
      padding: 20px;
    }
    .hero li:not(:last-child)::after {
      width: 10px;
      margin-inline: 5px;
    }
  }
</style>
