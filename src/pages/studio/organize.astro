---
import { readdir, readFile } from 'node:fs/promises';
import { parse } from 'yaml';
import BaseHead from '../../components/BaseHead.astro';
import StudioNavigation from '../../components/studio/StudioNavigation.astro';
import { getThemePalette } from '../../data/site';
const palette = await getThemePalette();

const definitions = [
  { key: 'categories', label: '分类', note: '文章所属的主要栏目' },
  { key: 'series', label: '系列', note: '有阅读顺序的连续内容' },
  { key: 'tags', label: '标签', note: '跨内容类型复用的主题关键词' },
] as const;
const groups = await Promise.all(
  definitions.map(async (definition) => {
    const directory = new URL(`../../content/taxonomies/${definition.key}/`, import.meta.url);
    let files: string[] = [];
    try {
      files = (await readdir(directory)).filter((file) => file.endsWith('.yaml'));
    } catch {}
    const items = await Promise.all(
      files.map(async (file) => {
        const data = parse(await readFile(new URL(file, directory), 'utf8')) as Record<
          string,
          string
        >;
        return {
          slug: file.replace(/\.yaml$/, ''),
          title: data.title || file,
          description: data.description || '',
        };
      }),
    );
    return { ...definition, items };
  }),
);
---

<!doctype html>
<html lang="zh-CN" data-palette={palette}>
  <head
    ><BaseHead title="内容组织" description="管理分类、系列和标签" /><meta
      name="robots"
      content="noindex,nofollow,noarchive"
    /></head
  ><body class="studio-with-navigation">
    <StudioNavigation />
    <main class="shell">
      <nav class="topbar">
        <a class="brand" href="/studio"><span>GM</span><strong>创作中心</strong></a><div>
          <a href="/studio">内容</a><a href="/studio/import">导入</a><a href="/studio/assets"
            >素材</a
          >
        </div>
      </nav><header>
        <p>CONTENT ORGANIZATION</p><h1>分类、系列与标签</h1><span
          >统一维护内容关系，避免同义词和重复标识。</span
        >
      </header><label class="taxonomy-search"
        ><span>搜索组织项</span><input
          type="search"
          placeholder="搜索名称或说明"
          data-taxonomy-search
        /></label
      ><div class="groups">
        {
          groups.map((group) => (
            <section data-taxonomy-group>
              <>
                <div class="heading">
                  <>
                    <div>
                      <>
                        <h2>
                          {group.label} <small>{group.items.length} 项</small>
                        </h2>
                        <p>{group.note}</p>
                      </>
                    </div>
                    <a class="primary" href={`/studio/edit/${group.key}/new?new=1`}>
                      新建{group.label}
                    </a>
                  </>
                </div>
                <div class="items">
                  {group.items.map((item) => (
                    <a
                      href={`/studio/edit/${group.key}/${item.slug}`}
                      data-taxonomy-item
                      data-search-text={`${item.title} ${item.description}`.toLocaleLowerCase(
                        'zh-CN',
                      )}
                    >
                      <strong>{item.title}</strong>
                      <small>{item.description || '尚未填写说明'}</small>
                      <span>编辑 →</span>
                    </a>
                  ))}
                  <p class="empty" data-taxonomy-empty hidden={group.items.length > 0}>
                    还没有{group.label}，可以新建第一项。
                  </p>
                </div>
              </>
            </section>
          ))
        }
      </div>
    </main>
    <script>
      const search = document.querySelector('[data-taxonomy-search]');
      const apply = () => {
        const query = search instanceof HTMLInputElement ? search.value.trim().toLowerCase() : '';
        document.querySelectorAll('[data-taxonomy-group]').forEach((group) => {
          const items = [...group.querySelectorAll('[data-taxonomy-item]')];
          let visible = 0;
          items.forEach((item) => {
            if (!(item instanceof HTMLElement)) return;
            const show = !query || item.dataset.searchText?.includes(query);
            item.hidden = !show;
            if (show) visible++;
          });
          const empty = group.querySelector('[data-taxonomy-empty]');
          if (empty instanceof HTMLElement) {
            empty.hidden = visible > 0;
            if (items.length) empty.textContent = '这个分组没有匹配项。';
          }
        });
      };
      search?.addEventListener('input', apply);
    </script>
  </body>
</html>
<style>
  :global(*) {
    box-sizing: border-box;
  }
  :global(body) {
    margin: 0;
    background: var(--paper-bg);
    color: var(--paper-ink);
    font-family: var(--font-ui);
  }
  .shell {
    width: min(1080px, calc(100% - 32px));
    margin: auto;
    padding: 22px 0 90px;
  }
  .topbar,
  .heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }
  .topbar {
    padding-bottom: 17px;
    border-bottom: 1px solid var(--paper-line);
  }
  .topbar > div,
  .brand {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .brand,
  .topbar a {
    color: inherit;
    text-decoration: none;
  }
  .brand span {
    display: grid;
    width: 34px;
    height: 34px;
    place-items: center;
    border-radius: 10px;
    background: var(--paper-ink);
    color: var(--paper-bg);
    font-size: 0.72rem;
  }
  .topbar > div a {
    padding: 7px;
    color: var(--paper-ink-soft);
    font-size: 0.82rem;
  }
  header {
    padding: 60px 0 42px;
  }
  header > p {
    margin: 0;
    color: var(--paper-accent);
    font: 700 0.7rem var(--font-meta);
    letter-spacing: 0.14em;
  }
  h1 {
    margin: 8px 0 12px;
    font: 400 clamp(2.5rem, 7vw, 5rem)/1 var(--font-page-heading);
  }
  header > span,
  .heading p,
  .items small {
    color: var(--paper-ink-soft);
  }
  .groups {
    display: grid;
    gap: 20px;
  }
  .taxonomy-search {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 16px;
    color: var(--studio-text-secondary);
    font-size: 0.8rem;
  }
  .taxonomy-search input {
    width: min(320px, 100%);
    padding: 10px 12px;
    border: 1px solid var(--paper-line-strong);
    border-radius: 9px;
    background: var(--paper-bg);
    color: inherit;
  }
  .groups section {
    padding: 26px;
    border: 1px solid var(--paper-line);
    border-radius: 16px;
  }
  .heading h2 {
    margin: 0;
    font: 400 2rem var(--font-page-heading);
  }
  .heading h2 small {
    color: var(--studio-text-meta);
    font: 500 0.72rem var(--font-ui);
  }
  .heading p {
    margin: 6px 0 0;
  }
  .primary {
    padding: 10px 13px;
    border-radius: 9px;
    background: var(--paper-accent);
    color: var(--paper-bg);
    text-decoration: none;
  }
  .items {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 10px;
    margin-top: 22px;
  }
  .items a {
    display: grid;
    gap: 6px;
    padding: 15px;
    border: 1px solid var(--paper-line);
    border-radius: 11px;
    color: inherit;
    text-decoration: none;
  }
  .items a:hover {
    border-color: var(--paper-accent);
  }
  .items a[hidden] {
    display: none;
  }
  .items .empty {
    grid-column: 1 / -1;
    margin: 0;
    padding: 24px;
    color: var(--studio-text-meta);
    text-align: center;
  }
  .items span {
    margin-top: 5px;
    color: var(--paper-accent);
    font-size: 0.78rem;
  }
  @media (max-width: 600px) {
    .groups section {
      padding: 18px;
    }
    .heading {
      align-items: flex-start;
    }
    .items {
      grid-template-columns: 1fr;
    }
    .taxonomy-search {
      align-items: stretch;
      flex-direction: column;
    }
    .taxonomy-search input {
      width: 100%;
    }
  }
</style>
