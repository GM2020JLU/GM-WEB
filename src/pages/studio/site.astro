---
import BaseHead from '../../components/BaseHead.astro';
import StudioNavigation from '../../components/studio/StudioNavigation.astro';
import StudioPageHeader from '../../components/studio/StudioPageHeader.astro';
import { getThemePalette } from '../../data/site';
const palette = await getThemePalette();
---

<!doctype html>
<html lang="zh-CN" data-palette={palette}>
  <head
    ><BaseHead title="站点设置" description="编辑个人站身份、主题和页面文案" /><meta
      name="robots"
      content="noindex,nofollow,noarchive"
    /></head
  >
  <body class="studio-with-navigation">
    <StudioNavigation />
    <main class="settings-shell">
      <StudioPageHeader
        eyebrow="SITE / SETTINGS"
        title="站点设置"
        description="编辑网站身份、主题和各模块公开文案。"
      />
      <div class="notice" data-notice role="status">
        <strong>正在读取设置</strong><small>请稍候…</small>
      </div>
      <nav class="settings-index" aria-label="站点设置章节">
        <a href="#settings-identity">网站身份</a><a href="#settings-home">首页内容</a><a
          href="#settings-profile">个人资料</a
        ><a href="#settings-blog">文章页</a><a href="#settings-projects">项目页</a><a
          href="#settings-vibe">随记页</a
        ><a href="#settings-media">书影音页</a>
      </nav>
      <form data-site-form>
        <section id="settings-identity">
          <div><span>01</span><h2>网站身份</h2><p>浏览器标题、搜索摘要和页脚。</p></div>
          <div class="fields">
            <label>站点名称<input required name="site.title" /></label>
            <label>首页标题<input required name="site.pageTitle" /></label>
            <label class="wide"
              >站点说明<textarea required rows="2" name="site.description"></textarea></label
            >
            <label class="wide"
              >首页搜索摘要<textarea required rows="2" name="site.pageDescription"
              ></textarea></label
            >
            <label class="wide">页脚文字<input name="site.footerNote" /></label>
          </div>
        </section>
        <section id="settings-home">
          <div><span>02</span><h2>首页内容</h2><p>首页自我介绍、关注方向和引语。</p></div>
          <div class="fields">
            <label>引导词<input required name="home.introTitle" /></label>
            <label>显示姓名<input required name="home.introName" /></label>
            <label class="wide"
              >自我介绍<textarea required rows="6" name="home.introBody"></textarea><small
                >每行显示为一个段落。</small
              ></label
            >
            <label class="wide"
              >关注方向<input name="home.focus" /><small>用顿号或逗号分隔。</small></label
            >
            <label class="wide"
              >首页引语<textarea required rows="3" name="home.quote"></textarea><small
                >每行显示为一句。</small
              ></label
            >
          </div>
        </section>
        <section id="settings-profile">
          <div><span>03</span><h2>个人资料</h2><p>首页名片和全站作者身份。</p></div>
          <div class="fields">
            <label>姓名<input required name="profile.name" /></label>
            <label>角色<input name="profile.role" /></label>
            <label>邮箱<input required type="email" name="profile.email" /></label>
            <label>头像网址<input required type="url" name="profile.avatar" /></label>
            <label
              >主题色<select name="theme.palette"
                ><option value="blue-soft">蓝 · 柔和</option><option value="green-soft"
                  >绿 · 柔和</option
                ><option value="green-vivid">绿 · 鲜明</option><option value="rose-soft"
                  >玫瑰</option
                ><option value="pink-soft">粉</option><option value="purple-soft">紫</option><option
                  value="orange-soft">橙</option
                ><option value="brown-soft">棕</option></select
              ></label
            >
            <div class="profile-preview wide" aria-live="polite">
              <img data-avatar-preview alt="头像预览" hidden /><span>
                <strong data-palette-preview>当前主题</strong>
                <small>修改主题色或头像网址可即时预览</small>
              </span>
            </div>
          </div>
        </section>
        {
          [
            ['blog', '文章页'],
            ['projects', '项目页'],
            ['vibe', '随记页'],
            ['media', '书影音页'],
          ].map(([key, label], index) => (
            <section id={`settings-${key}`}>
              <div>
                <>
                  <span>{String(index + 4).padStart(2, '0')}</span>
                  <h2>{label}</h2>
                  <p>该公开模块的标题与介绍。</p>
                </>
              </div>
              <div class="fields">
                <label>
                  标题
                  <input required name={`pages.${key}.title`} />
                </label>
                <label class="wide">
                  副标题
                  <input name={`pages.${key}.subtitle`} />
                </label>
                <label class="wide">
                  补充说明
                  <textarea rows="2" name={`pages.${key}.note`} />
                </label>
              </div>
            </section>
          ))
        }
        <footer>
          <span data-save-state>正在载入设置</span><button type="submit" disabled
            >保存站点设置</button
          >
        </footer>
      </form>
    </main>
    <script>
      import { setupStudioSite } from '../../utils/studio-site-client';

      setupStudioSite(document);
    </script>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }
  :global(body) {
    margin: 0;
    font-family: var(--font-ui);
  }
  .settings-shell {
    width: min(1040px, calc(100% - 40px));
    padding: 44px 0 100px;
  }
  header {
    padding-bottom: 34px;
    border-bottom: 1px solid var(--paper-line);
  }
  header p {
    margin: 0;
    color: var(--studio-accent-strong);
    font: 700 0.68rem var(--font-meta);
    letter-spacing: 0.14em;
  }
  h1 {
    margin: 8px 0 10px;
    font: 400 clamp(2.5rem, 7vw, 4.8rem)/1 var(--font-page-heading);
  }
  header span,
  section > div:first-child p,
  footer span,
  .notice small {
    color: var(--paper-ink-soft);
  }
  .notice {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 22px 0;
    padding: 13px 15px;
    border: 1px solid var(--paper-line);
    border-radius: 11px;
  }
  .notice > div {
    display: grid;
    gap: 2px;
  }
  .notice > button,
  .notice > a {
    flex: 0 0 auto;
    margin-left: auto;
    padding: 8px 12px;
    border: 1px solid var(--paper-line-strong);
    border-radius: 8px;
    background: var(--paper-bg);
    color: inherit;
    font: inherit;
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
  }
  .notice.success {
    border-color: color-mix(in srgb, var(--paper-accent) 48%, var(--paper-line));
  }
  .notice.error {
    border-color: color-mix(in srgb, #bf7474 55%, var(--paper-line) 45%);
  }
  form {
    display: grid;
    gap: 14px;
  }
  .settings-index {
    position: sticky;
    top: 12px;
    z-index: 4;
    display: flex;
    gap: 4px;
    margin: 0 0 16px;
    padding: 7px;
    border: 1px solid var(--paper-line);
    border-radius: 12px;
    background: color-mix(in srgb, var(--paper-bg) 92%, transparent);
    box-shadow: var(--paper-shadow-lift);
    backdrop-filter: blur(14px);
    overflow-x: auto;
    scrollbar-color: var(--paper-line-strong) transparent;
    scrollbar-width: thin;
  }
  .settings-index::-webkit-scrollbar {
    height: 4px;
  }
  .settings-index::-webkit-scrollbar-thumb {
    border-radius: 999px;
    background: var(--paper-line-strong);
  }
  .settings-index a {
    flex: 0 0 auto;
    padding: 8px 10px;
    border-radius: 8px;
    color: var(--studio-text-secondary);
    font-size: 0.76rem;
    text-decoration: none;
  }
  .settings-index a:hover,
  .settings-index a:focus-visible {
    background: var(--paper-control-hover);
    color: var(--paper-ink);
  }
  section {
    display: grid;
    grid-template-columns: 230px 1fr;
    gap: 34px;
    padding: 25px;
    border: 1px solid var(--paper-line);
    border-radius: 14px;
    scroll-margin-top: 80px;
  }
  section > div:first-child > span {
    color: var(--studio-accent-strong);
    font: 700 0.68rem var(--font-meta);
  }
  h2 {
    margin: 7px 0;
    font: 400 1.55rem var(--font-page-heading);
  }
  section p {
    margin: 0;
    font-size: 0.78rem;
    line-height: 1.6;
  }
  .fields {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 13px;
  }
  label {
    display: grid;
    gap: 6px;
    color: var(--paper-ink-soft);
    font-size: 0.74rem;
  }
  label.wide {
    grid-column: 1 / -1;
  }
  input,
  textarea,
  select {
    width: 100%;
    padding: 10px 11px;
    border: 1px solid var(--paper-line-strong);
    border-radius: 8px;
    background: var(--paper-bg);
    color: var(--paper-ink);
    font: inherit;
  }
  textarea {
    resize: vertical;
  }
  .profile-preview {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 72px;
    padding: 10px 12px;
    border: 1px solid var(--paper-line);
    border-radius: 10px;
    background: color-mix(in srgb, var(--paper-bg) 94%, var(--paper-accent) 6%);
  }
  .profile-preview img {
    width: 50px;
    height: 50px;
    border-radius: 50%;
    object-fit: cover;
  }
  .profile-preview span {
    display: grid;
    gap: 3px;
  }
  footer [data-dirty='true'] {
    color: var(--studio-warning);
    font-weight: 700;
  }
  footer {
    position: sticky;
    bottom: 14px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 13px 16px;
    border: 1px solid var(--paper-line-strong);
    border-radius: 12px;
    background: color-mix(in srgb, var(--paper-bg) 92%, transparent);
    backdrop-filter: blur(12px);
  }
  button {
    padding: 10px 15px;
    border: 0;
    border-radius: 9px;
    background: var(--paper-accent);
    color: var(--paper-bg);
    font: inherit;
    cursor: pointer;
  }
  @media (max-width: 920px) {
    .settings-index {
      top: 76px;
    }
    section {
      scroll-margin-top: 132px;
    }
  }
  @media (max-width: 720px) {
    .notice {
      flex-wrap: wrap;
    }
    .notice > button,
    .notice > a {
      margin-left: 0;
    }
    .settings-index {
      margin-inline: -4px;
    }
    section {
      grid-template-columns: 1fr;
    }
    .fields {
      grid-template-columns: 1fr;
    }
    label.wide {
      grid-column: auto;
    }
  }
</style>
